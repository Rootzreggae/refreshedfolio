---
// Floating controls that appear once the reader scrolls past the hero: play the guided demo, jump to a section,
// or see the quick facts. Reusable: pass the sections and facts.
interface Props { sections: [string, string][]; facts: [string, string][]; after: string }
const { sections, facts, after } = Astro.props;
---
<div class="dock" data-dock data-after={after} aria-label="Case study controls" role="toolbar">
  <button class="play" data-play aria-pressed="false">
    <svg class="i-play" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.8v10.4L12 7Z" fill="currentColor"/></svg>
    <svg class="i-pause" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 2h3v10H3zM8 2h3v10H8z" fill="currentColor"/></svg>
    <span data-play-label>Watch the demo</span>
  </button>
  <button class="icon" data-pop="sections" aria-expanded="false" aria-label="Sections"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
  <button class="icon" data-pop="facts" aria-expanded="false" aria-label="Quick facts">?</button>

  <nav class="pop" data-popover="sections" hidden aria-label="Sections">
    {sections.map(([href, label]) => <a href={href}>{label}</a>)}
  </nav>
  <dl class="pop" data-popover="facts" hidden>
    {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
  </dl>
</div>

<script>
  const dock = document.querySelector<HTMLElement>("[data-dock]")!;
  const label = dock.querySelector<HTMLElement>("[data-play-label]")!;
  const play = dock.querySelector<HTMLButtonElement>("[data-play]")!;

  // Show the dock once the hero has scrolled away
  const hero = document.querySelector(dock.dataset.after!);
  if (hero) new IntersectionObserver(([e]) => dock.classList.toggle("on", !e.isIntersecting), { threshold: 0.15 }).observe(hero);

  play.addEventListener("click", () => document.dispatchEvent(new Event("demo:toggle")));
  document.addEventListener("demo:state", (e) => {
    const { playing, done } = (e as CustomEvent).detail;
    play.setAttribute("aria-pressed", String(playing));
    label.textContent = playing ? "Pause" : done ? "Watch again" : "Resume demo";
  });

  // Popovers: one open at a time, close on outside click or Escape
  const pops = [...dock.querySelectorAll<HTMLElement>("[data-pop]")];
  const close = () => pops.forEach((b) => { b.setAttribute("aria-expanded", "false"); dock.querySelector<HTMLElement>(`[data-popover=${b.dataset.pop}]`)!.hidden = true; });
  pops.forEach((b) => b.addEventListener("click", (e) => {
    e.stopPropagation();
    const open = b.getAttribute("aria-expanded") !== "true";
    close();
    b.setAttribute("aria-expanded", String(open));
    dock.querySelector<HTMLElement>(`[data-popover=${b.dataset.pop}]`)!.hidden = !open;
  }));
  document.addEventListener("click", (e) => { if (!dock.contains(e.target as Node)) close(); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
  dock.querySelectorAll("[data-popover=sections] a").forEach((a) => a.addEventListener("click", close));
</script>

<style>
  .dock {
    position: fixed; left: 50%; bottom: 24px; z-index: 20; display: flex; align-items: center; gap: 6px; padding: 6px;
    border-radius: 14px; background: rgba(12, 18, 28, .82); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, .2), 0 0 0 1px rgba(255, 255, 255, .1);
    translate: -50% 140%; opacity: 0; transition: translate .45s cubic-bezier(.2, .8, .2, 1), opacity .3s ease;
  }
  .dock.on { translate: -50% 0; opacity: 1; }
  .dock button { font: inherit; color: #fff; border: 0; cursor: pointer; }
  .play { display: inline-flex; align-items: center; gap: 10px; white-space: nowrap; height: 40px; padding: 0 20px 0 16px; border-radius: 10px; background: #fff; color: #0c121c !important; font-weight: 500; }
  .play:hover { background: #e8edf3; }
  .i-pause, .play[aria-pressed="true"] .i-play { display: none; }
  .play[aria-pressed="true"] .i-pause { display: block; }
  .icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; background: rgba(255, 255, 255, .08); font-weight: 600; }
  .icon:hover, .icon[aria-expanded="true"] { background: rgba(255, 255, 255, .16); }
  .dock button:focus-visible, .pop a:focus-visible { outline: 2px solid #ff8833; outline-offset: 2px; }

  .pop { position: absolute; bottom: calc(100% + 10px); right: 0; min-width: 260px; margin: 0; padding: 10px; border-radius: 12px; background: rgba(12, 18, 28, .96); box-shadow: 0 12px 40px rgba(0, 0, 0, .45), 0 0 0 1px rgba(255, 255, 255, .1); }
  .pop[hidden] { display: none; }
  nav.pop { display: flex; flex-direction: column; }
  nav.pop a { padding: 8px 10px; border-radius: 8px; color: #fff; text-decoration: none; }
  nav.pop a:hover { background: rgba(255, 255, 255, .08); }
  dl.pop { display: flex; flex-direction: column; gap: 10px; padding: 14px 16px; min-width: 300px; }
  dl.pop div { display: grid; grid-template-columns: 90px 1fr; gap: 10px; font-size: 14px; }
  dl.pop dt { color: rgba(255, 255, 255, .55); }
  dl.pop dd { margin: 0; }
  @media (prefers-reduced-motion: reduce) { .dock { transition: opacity .2s ease; } }
  @media (max-width: 600px) { .dock { bottom: 12px; } .play { padding: 0 14px 0 12px; } }
</style>
