---
// A live prototype in a browser frame, scaled to fit, with a guided demo: a cursor that hovers and clicks inside the
// prototype while captions tell the story. Reusable across case studies: pass the prototype URL and the steps.
// Talks to the page through events: demo:play / demo:pause / demo:toggle / stage:show in, demo:state out.
export interface Step {
  caption: string;
  hash?: string;   // go to this screen first
  hover?: string;  // selector inside the prototype to hover
  click?: string;  // selector inside the prototype to click
  wait: number;    // ms to stay on this step (or until its audio ends)
  audio?: string;  // optional voice clip for the caption
}
interface Props { src: string; url: string; steps: Step[]; width?: number; height?: number }
const { src, url, steps, width = 1440, height = 900 } = Astro.props;
---
<figure class="stage" data-stage data-w={width} data-h={height}>
  <div class="chrome" aria-hidden="true"><i></i><i></i><i></i><span>{url}</span></div>
  <div class="view" data-view>
    <iframe src={src} title="Interactive prototype" data-frame tabindex="0"></iframe>
    <span class="cursor" data-cursor aria-hidden="true"><svg width="22" height="22" viewBox="0 0 22 22"><path d="M3 2l14 8-6 1.6L8.3 18Z" fill="#fff" stroke="#111" stroke-width="1.4" stroke-linejoin="round"/></svg></span>
    <figcaption class="caption" data-caption aria-live="polite"></figcaption>
  </div>
  <script type="application/json" data-steps set:html={JSON.stringify(steps)} />
</figure>

<script>
  type Step = { caption: string; hash?: string; hover?: string; click?: string; wait: number; audio?: string };
  const stage = document.querySelector<HTMLElement>("[data-stage]")!;
  const view = stage.querySelector<HTMLElement>("[data-view]")!;
  const frame = stage.querySelector<HTMLIFrameElement>("[data-frame]")!;
  const cursor = stage.querySelector<HTMLElement>("[data-cursor]")!;
  const caption = stage.querySelector<HTMLElement>("[data-caption]")!;
  const steps: Step[] = JSON.parse(stage.querySelector("[data-steps]")!.textContent!);
  const W = +stage.dataset.w!, H = +stage.dataset.h!;
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let scale = 1;

  // Render the prototype at its design size and scale it down to the frame
  new ResizeObserver(() => {
    scale = view.clientWidth / W;
    frame.style.transform = `scale(${scale})`;
    view.style.height = `${H * scale}px`;
  }).observe(view);

  const doc = () => frame.contentDocument!;
  const find = (sel: string) => doc().querySelector<HTMLElement>(sel);
  const go = (hash: string) => { if (frame.contentWindow!.location.hash !== hash) frame.contentWindow!.location.hash = hash; };
  function hover(sel?: string) {
    doc().querySelectorAll(".is-hover").forEach((e) => e.classList.remove("is-hover"));
    const el = sel ? find(sel) : null;
    el?.classList.add("is-hover");
    el?.dispatchEvent(new MouseEvent("mouseenter"));
    if (!el) doc().querySelector(".active .cards")?.dispatchEvent(new MouseEvent("mouseleave"));
  }

  let run = 0;          // bumps on every play/pause so a stale loop stops
  let index = 0;        // where play resumes
  let playing = false;
  const sleep = (ms: number, id: number) => new Promise<boolean>((r) => setTimeout(() => r(id === run), ms));
  const state = () => document.dispatchEvent(new CustomEvent("demo:state", { detail: { playing, done: index >= steps.length } }));

  async function moveTo(sel: string, id: number) {
    const el = find(sel);
    if (!el) return false;
    const r = el.getBoundingClientRect();
    cursor.classList.add("on");
    cursor.style.translate = `${(r.left + r.width / 2) * scale}px ${(r.top + r.height / 2) * scale}px`;
    return sleep(still ? 50 : 750, id);
  }

  async function play() {
    if (index >= steps.length) index = 0;
    const id = ++run;
    playing = true;
    stage.classList.add("playing");
    state();
    for (; index < steps.length; index++) {
      const s = steps[index];
      caption.textContent = s.caption;
      caption.classList.add("on");
      if (s.hash) { go(s.hash); if (!(await sleep(450, id))) return; }
      const target = s.click ?? s.hover;
      if (target && !(await moveTo(target, id))) return;
      if (s.hover) hover(s.hover);
      let audio: HTMLAudioElement | null = null;
      if (s.audio) { audio = new Audio(s.audio); audio.play().catch(() => {}); }
      if (!(await sleep(s.wait, id))) { audio?.pause(); return; }
      if (s.click) {
        cursor.classList.add("press");
        await sleep(160, id);
        cursor.classList.remove("press");
        hover();
        find(s.click)?.click();
      }
    }
    // The end: hand the prototype over
    playing = false;
    cursor.classList.remove("on");
    stage.classList.remove("playing");
    setTimeout(() => caption.classList.remove("on"), 2600);
    state();
  }
  function pause() {
    run++;
    playing = false;
    stage.classList.remove("playing");
    cursor.classList.remove("on");
    caption.classList.remove("on");
    state();
  }

  document.addEventListener("demo:play", () => { if (!playing) play(); });
  document.addEventListener("demo:pause", pause);
  document.addEventListener("demo:toggle", () => (playing ? pause() : play()));
  // Scrolling the story shows the matching screen, unless the demo is driving
  document.addEventListener("stage:show", (e) => {
    if (playing) return;
    const { hash, hover: h } = (e as CustomEvent).detail;
    go(hash);
    setTimeout(() => hover(h), 350);
  });
  // Touching the prototype takes over from the demo
  frame.addEventListener("load", () => doc().addEventListener("pointerdown", () => { if (playing) pause(); }, true));
</script>

<style>
  .stage { margin: 0; border-radius: 10px; overflow: hidden; background: #0b0c0e; box-shadow: 0 30px 80px rgba(0, 0, 0, .45), 0 0 0 1px rgba(255, 255, 255, .08); }
  .chrome { display: flex; align-items: center; gap: 6px; height: 30px; padding: 0 12px; background: #1b1d22; }
  .chrome i { width: 10px; height: 10px; border-radius: 50%; background: #3a3d44; }
  .chrome span { flex: 1; margin-left: 10px; color: rgba(255, 255, 255, .45); font: 12px/1 ui-monospace, monospace; text-align: center; transform: translateX(-24px); }
  .view { position: relative; overflow: hidden; }
  .view iframe { position: absolute; left: 0; top: 0; width: 1440px; height: 900px; border: 0; transform-origin: 0 0; background: #181b1f; }
  .cursor { position: absolute; left: -4px; top: -3px; z-index: 2; opacity: 0; pointer-events: none; transition: translate .7s cubic-bezier(.5, 0, .2, 1), opacity .25s ease, scale .15s ease; filter: drop-shadow(0 2px 4px rgba(0, 0, 0, .5)); }
  .cursor.on { opacity: 1; }
  .cursor.press { scale: .8; }
  .caption {
    position: absolute; left: 50%; bottom: 18px; z-index: 3; max-width: min(88%, 680px); padding: 12px 18px; border-radius: 10px;
    background: rgba(10, 12, 16, .88); color: #fff; font-size: clamp(14px, 1.25vw, 17px); line-height: 1.45; text-align: center;
    box-shadow: 0 8px 30px rgba(0, 0, 0, .4); translate: -50% 10px; opacity: 0; transition: opacity .3s ease, translate .3s ease; pointer-events: none;
  }
  .caption.on { opacity: 1; translate: -50% 0; }
  @media (prefers-reduced-motion: reduce) { .cursor, .caption { transition: none; } }
</style>
