---
// A live prototype screen in a small browser frame: opens on one screen (and optionally a hover state), stays clickable.
interface Props { src: string; url: string; hover?: string; width?: number; height?: number }
const { src, url, hover = "", width = 1440, height = 900 } = Astro.props;
---
<figure class="pf" data-pf data-hover={hover} data-w={width} data-h={height}>
  <div class="chrome" aria-hidden="true"><i></i><i></i><i></i><span>{url}</span></div>
  <div class="view"><iframe src={src} title="Prototype screen" loading="lazy" tabindex="-1"></iframe></div>
</figure>

<script>
  for (const pf of document.querySelectorAll<HTMLElement>("[data-pf]")) {
    const view = pf.querySelector<HTMLElement>(".view")!;
    const frame = pf.querySelector("iframe")!;
    const W = +pf.dataset.w!, H = +pf.dataset.h!;
    new ResizeObserver(() => {
      const k = view.clientWidth / W;
      frame.style.transform = `scale(${k})`;
      view.style.height = `${H * k}px`;
    }).observe(view);
    // Show the hover state this beat is about
    frame.addEventListener("load", () => {
      const sel = pf.dataset.hover;
      if (!sel) return;
      setTimeout(() => {
        const el = frame.contentDocument?.querySelector<HTMLElement>(sel);
        el?.classList.add("is-hover");
        el?.dispatchEvent(new MouseEvent("mouseenter"));
      }, 500);
    });
  }
</script>

<style>
  .pf { margin: 0; border-radius: 10px; overflow: hidden; background: #0b0c0e; box-shadow: 0 24px 60px rgba(0, 0, 0, .4), 0 0 0 1px rgba(255, 255, 255, .08); }
  .chrome { display: flex; align-items: center; gap: 6px; height: 26px; padding: 0 12px; background: #1b1d22; }
  .chrome i { width: 9px; height: 9px; border-radius: 50%; background: #3a3d44; }
  .chrome span { flex: 1; color: rgba(255, 255, 255, .4); font: 11px/1 ui-monospace, monospace; text-align: center; transform: translateX(-20px); }
  .view { position: relative; overflow: hidden; aspect-ratio: 16 / 10; }
  .view iframe { position: absolute; left: 0; top: 0; width: 1440px; height: 900px; border: 0; transform-origin: 0 0; background: #181b1f; }
</style>
