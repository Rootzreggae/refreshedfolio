---
// Full-screen theatre for the guided demo: the prototype at a real size, captions over it. Opens on "theater:open",
// starts the demo, and stops it on close (button, Esc or clicking the backdrop).
import PrototypeStage, { type Step } from "./PrototypeStage.astro";
interface Props { src: string; url: string; steps: Step[] }
const { src, url, steps } = Astro.props;
---
<dialog class="theater" data-theater aria-label="Guided demo">
  <div class="inner">
    <button class="close" data-theater-close aria-label="Close demo"><svg width="16" height="16" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2 2 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
    <PrototypeStage src={src} url={url} steps={steps} />
  </div>
</dialog>

<script>
  const dlg = document.querySelector<HTMLDialogElement>("[data-theater]")!;
  document.addEventListener("theater:open", () => {
    if (!dlg.open) dlg.showModal();
    setTimeout(() => document.dispatchEvent(new Event("demo:play")), 350);
  });
  const close = () => { document.dispatchEvent(new Event("demo:pause")); dlg.close(); };
  dlg.querySelector("[data-theater-close]")!.addEventListener("click", close);
  dlg.addEventListener("cancel", (e) => { e.preventDefault(); close(); });
  dlg.addEventListener("click", (e) => { if (e.target === dlg) close(); });
</script>

<style>
  .theater { width: 100vw; max-width: none; height: 100vh; max-height: none; margin: 0; padding: 0; border: 0; background: transparent; }
  .theater::backdrop { background: rgba(8, 14, 24, .86); backdrop-filter: blur(8px); }
  .theater[open] { display: grid; place-items: center; animation: rise .35s cubic-bezier(.2, .8, .2, 1); }
  @keyframes rise { from { opacity: 0; translate: 0 24px; } }
  .inner { position: relative; width: min(92vw, calc((100vh - 96px) * 1.6)); }
  .close { position: absolute; top: -48px; right: 0; display: grid; place-items: center; width: 38px; height: 38px; border: 0; border-radius: 10px; background: rgba(255, 255, 255, .12); color: #fff; cursor: pointer; }
  .close:hover { background: rgba(255, 255, 255, .22); }
  .close:focus-visible { outline: 2px solid #ff8833; outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .theater[open] { animation: none; } }
</style>
