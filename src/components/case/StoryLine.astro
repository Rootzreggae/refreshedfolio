---
// The scroll story: a heading, then one line that drops from it, curves to the left and runs down the page as a spine.
// The line draws itself as you scroll; each beat (a dot, a short statement, a visual) lights up as the line reaches it.
// Beats are the children: <div class="beat"><div class="beat-text">…</div><div class="beat-visual">…</div></div>
import { words } from "./words";
interface Props { id: string; heading: string }
const { id, heading } = Astro.props;
---
<section class="storyline" id={id} data-storyline>
  <h2 class="sl-heading">{words(heading).map(({ w, accent }) => <span class:list={["w", { accent }]}>{w} </span>)}</h2>
  <svg class="sl-svg" aria-hidden="true"><path class="sl-track" /><path class="sl-path" /></svg>
  <div class="sl-beats"><slot /></div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-storyline]")) {
    const svg = root.querySelector<SVGSVGElement>(".sl-svg")!;
    const track = root.querySelector<SVGPathElement>(".sl-track")!;
    const path = root.querySelector<SVGPathElement>(".sl-path")!;
    const heading = root.querySelector<HTMLElement>(".sl-heading")!;
    const beats = [...root.querySelectorAll<HTMLElement>(".beat")];
    let total = 0;
    let dots: number[] = [];

    // Lay the line out from where things actually are
    function layout() {
      const box = root.getBoundingClientRect();
      const h = heading.getBoundingClientRect();
      const firstDot = beats[0]?.querySelector<HTMLElement>(".dot")?.getBoundingClientRect();
      if (!firstDot) return;
      const cx = h.left + h.width / 2 - box.left;
      const sx = firstDot.left + firstDot.width / 2 - box.left;
      const y0 = h.bottom - box.top + 28;
      dots = beats.map((b) => { const d = b.querySelector<HTMLElement>(".dot")!.getBoundingClientRect(); return d.top + d.height / 2 - box.top; });
      const yCurveEnd = Math.min(dots[0] - 40, y0 + 360);
      const k = (yCurveEnd - y0) * 0.55;
      const yEnd = box.height - 40;
      const d = `M${cx} ${y0} L${cx} ${y0 + 30} C${cx} ${y0 + 30 + k} ${sx} ${yCurveEnd - k} ${sx} ${yCurveEnd} L${sx} ${yEnd}`;
      svg.setAttribute("viewBox", `0 0 ${box.width} ${box.height}`);
      svg.style.height = `${box.height}px`;
      track.setAttribute("d", d);
      path.setAttribute("d", d);
      total = path.getTotalLength();
      path.style.strokeDasharray = `${total} ${total}`;
      draw();
    }

    // The tip of the line follows a point a little below the middle of the screen
    function draw() {
      const box = root.getBoundingClientRect();
      const tipY = innerHeight * 0.62 - box.top;
      let lo = 0, hi = total;
      for (let i = 0; i < 22; i++) { const mid = (lo + hi) / 2; if (path.getPointAtLength(mid).y < tipY) lo = mid; else hi = mid; }
      path.style.strokeDashoffset = String(total - lo);
      heading.classList.toggle("on", box.top < innerHeight * 0.75);
      beats.forEach((b, i) => b.classList.toggle("on", dots[i] < tipY));
    }

    let raf = 0;
    addEventListener("scroll", () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(draw); }, { passive: true });
    new ResizeObserver(() => layout()).observe(root);
    addEventListener("load", layout);
    layout();

    // Visuals rise into place as they enter
    const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && e.target.classList.add("in")), { rootMargin: "0px 0px -12% 0px" });
    root.querySelectorAll(".beat-visual").forEach((v) => io.observe(v));
  }
</script>

<style>
  .storyline { position: relative; padding: 120px clamp(16px, 4vw, 72px) 80px; }
  .sl-heading { position: relative; z-index: 1; margin: 0 auto; max-width: 18ch; text-align: center; font-size: clamp(34px, 4vw, 60px); line-height: 1.08; font-weight: 400; }
  .sl-svg { position: absolute; left: 0; top: 0; width: 100%; pointer-events: none; overflow: visible; }
  .sl-track { fill: none; stroke: rgba(255, 255, 255, .08); stroke-width: 1.5; }
  .sl-path { fill: none; stroke: rgba(255, 255, 255, .85); stroke-width: 1.5; stroke-linecap: round; }
  .sl-beats { position: relative; padding-top: 360px; }

  /* Words light up in order; accent words take the brand colour */
  .storyline :global(.w) { color: rgba(255, 255, 255, .22); transition: color .5s ease; }
  .storyline :global(.on .w), .sl-heading.on :global(.w) { color: #fff; }
  .storyline :global(.on .w.accent), .sl-heading.on :global(.w.accent) { color: #ff8833; }
  .storyline :global(.on .w:nth-child(2)) { transition-delay: .05s; } .storyline :global(.on .w:nth-child(3)) { transition-delay: .1s; }
  .storyline :global(.on .w:nth-child(4)) { transition-delay: .15s; } .storyline :global(.on .w:nth-child(5)) { transition-delay: .2s; }
  .storyline :global(.on .w:nth-child(6)) { transition-delay: .25s; } .storyline :global(.on .w:nth-child(7)) { transition-delay: .3s; }
  .storyline :global(.on .w:nth-child(n + 8)) { transition-delay: .35s; }

  .storyline :global(.beat) { position: relative; display: grid; grid-template-columns: 56px minmax(0, 400px) minmax(0, 1fr); gap: 0 clamp(32px, 4vw, 72px); align-items: start; margin-bottom: 200px; }
  .storyline :global(.beat-text) { grid-column: 2; }
  .storyline :global(.dot) { position: absolute; left: 22px; top: 18px; width: 12px; height: 12px; border-radius: 50%; background: #0f1d2e; border: 1.5px solid rgba(255, 255, 255, .3); transition: background .3s ease, border-color .3s ease, box-shadow .3s ease; }
  .storyline :global(.beat.on .dot) { background: #fff; border-color: #fff; box-shadow: 0 0 0 6px rgba(255, 136, 51, .18); }
  .storyline :global(.beat h3) { margin: 0 0 16px; font-family: "NB International", sans-serif; font-weight: 400; font-size: clamp(26px, 2.4vw, 36px); line-height: 1.15; }
  .storyline :global(.beat p) { color: rgba(255, 255, 255, .62); max-width: 36ch; margin: 0 0 12px; opacity: 0; translate: 0 10px; transition: opacity .6s .25s ease, translate .6s .25s ease; }
  .storyline :global(.beat.on p) { opacity: 1; translate: 0 0; }
  .storyline :global(.beat-visual) { grid-column: 3; margin-top: 90px; opacity: 0; translate: 0 70px; scale: .96; transition: opacity .9s cubic-bezier(.2, .7, .2, 1), translate .9s cubic-bezier(.2, .7, .2, 1), scale .9s cubic-bezier(.2, .7, .2, 1); }
  .storyline :global(.beat-visual.in) { opacity: 1; translate: 0 0; scale: 1; }

  @media (prefers-reduced-motion: reduce) {
    .storyline :global(.w), .storyline :global(.beat p), .storyline :global(.beat-visual) { transition: none; }
    .storyline :global(.beat-visual), .storyline :global(.beat p) { opacity: 1; translate: none; scale: none; }
  }
  @media (max-width: 900px) {
    .storyline { padding: 80px 16px 40px; }
    .sl-beats { padding-top: 220px; }
    .storyline :global(.beat) { grid-template-columns: 28px minmax(0, 1fr); gap: 0 14px; margin-bottom: 110px; }
    .storyline :global(.dot) { left: 8px; }
    .storyline :global(.beat-visual) { grid-column: 2; margin-top: 28px; }
  }
</style>
