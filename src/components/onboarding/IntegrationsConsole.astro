---
// Integrations and Connections, rebuilt from the 2022 console design. One component, several starting states:
// a search ("loki", "tempo"), a category, or the installed view. Search, filters and installing all work.
import "./grafana.css";
interface Props { q?: string; category?: string; installed?: boolean }
const { q = "", category = "", installed = false } = Astro.props;
const A = "/prototypes/grafana-onboarding";

type Item = { name: string; kind: "Integration" | "Data source" | "Hosted data" | "Data forwarding"; logo: string; tags?: string; to?: string; pro?: boolean; preinstalled?: boolean };
const items: Item[] = [
  { name: "Hosted metrics", kind: "Hosted data", logo: `${A}/ds-prom.svg`, tags: "prometheus metrics", to: "#dest-prom" },
  { name: "Hosted logs", kind: "Hosted data", logo: `${A}/ds-loki.svg`, tags: "loki logs" },
  { name: "Hosted traces", kind: "Hosted data", logo: `${A}/ds-tempo.svg`, tags: "tempo traces" },
  { name: "Loki data source", kind: "Data source", logo: `${A}/ds-loki.svg`, tags: "loki logs" },
  { name: "Tempo data source", kind: "Data source", logo: `${A}/ds-tempo.svg`, tags: "tempo traces" },
  { name: "Graphite data source", kind: "Data source", logo: `${A}/ds-graphite.svg`, tags: "graphite metrics", to: "#dest-graphite" },
  { name: "AppDynamics", kind: "Data source", logo: "appdynamics", pro: true },
  { name: "Datadog", kind: "Data source", logo: "datadog", pro: true, preinstalled: true },
  { name: "Caddy", kind: "Integration", logo: "caddy" },
  { name: "Ceph", kind: "Integration", logo: "ceph", preinstalled: true },
  { name: "Cert Manager", kind: "Integration", logo: "cert-manager" },
  { name: "Cloudwatch Metrics", kind: "Integration", logo: "cloudwatch-metrics", tags: "aws", preinstalled: true },
  { name: "Cloudwatch Logs", kind: "Integration", logo: "cloudwatch-logs", tags: "aws logs", preinstalled: true },
  { name: "cockroachdb", kind: "Integration", logo: "cockroachdb", tags: "database" },
  { name: "Consul", kind: "Integration", logo: "consul" },
  { name: "CoreDNS", kind: "Integration", logo: "coredns", tags: "dns" },
  { name: "dnsmasq", kind: "Integration", logo: "dnsmasq", tags: "dns" },
  { name: "Docker", kind: "Integration", logo: "docker", tags: "containers", preinstalled: true },
  { name: "Elasticsearch", kind: "Integration", logo: "elasticsearch", tags: "logs search" },
  { name: "etcd", kind: "Integration", logo: "etcd" },
  { name: "GitHub", kind: "Integration", logo: "github" },
  { name: "Go", kind: "Integration", logo: "go", tags: "golang" },
  { name: "HAProxy", kind: "Integration", logo: "haproxy", tags: "load balancer" },
  { name: "JVM", kind: "Integration", logo: "jvm", tags: "java", preinstalled: true },
  { name: "Kubernetes", kind: "Integration", logo: "kubernetes", tags: "k8s containers", to: "#dest-kube", preinstalled: true },
  { name: "Linux Server", kind: "Integration", logo: "linux-server", tags: "node exporter host" },
  { name: "Loki", kind: "Data forwarding", logo: `${A}/ds-loki.svg`, tags: "logs promtail" },
  { name: "Memcached", kind: "Integration", logo: "memcached", tags: "cache" },
  { name: "MySQL", kind: "Integration", logo: "mysql", tags: "database" },
  { name: "Nginx", kind: "Integration", logo: "nginx", tags: "web server" },
];
const logo = (l: string) => (l.startsWith("/") ? l : `${A}/int/${l}.webp`);
const kinds = ["Integration", "Data source", "Hosted data", "Data forwarding"];
const icon: Record<string, string> = {
  "Integration": `<svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M9.5 1 3 9h4.5L6.5 15 13 7H8.5Z" fill="currentColor"/></svg>`,
  "Data source": `<svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><ellipse cx="8" cy="3.5" rx="5" ry="2" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M3 3.5v9c0 1.1 2.2 2 5 2s5-.9 5-2v-9M3 8c0 1.1 2.2 2 5 2s5-.9 5-2" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>`,
  "Hosted data": `<svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 12.5h7a3 3 0 0 0 .4-6A4.5 4.5 0 0 0 3.3 7.6 2.5 2.5 0 0 0 4.5 12.5Z" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>`,
  "Data forwarding": `<svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h10m-3-3 3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>`,
};
---
<div class="gp console" data-console data-q={q} data-category={category} data-installed={String(installed)}>
  <header class="title"><img src={`${A}/nav/onboarding.svg`} alt="" width="32" height="32" /><h1>Integrations and Connections</h1></header>

  <div class="wrap">
    <h2>Add and manage Grafana Cloud integrations and connections</h2>
    <p class="sub">Select an integration to see more details.</p>
    <label class="search">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.8" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="m10.6 10.6 3.4 3.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      <input type="search" placeholder="Search integrations or tags" aria-label="Search integrations or tags" data-search value={q} />
    </label>
    <div class="filters">
      <select aria-label="Filter by category" data-cat>
        <option value="">Filter by category</option>
        {kinds.map((k) => <option value={k} selected={k === category}>{k === "Integration" ? "Integrations" : k === "Data source" ? "Data sources" : k}</option>)}
      </select>
      <div class="seg" role="radiogroup" aria-label="Show">
        <button role="radio" aria-checked="true" data-show="all">All</button>
        <button role="radio" aria-checked="false" data-show="installed">Installed</button>
      </div>
    </div>

    <ul class="grid">
      {items.map((it) => (
        <li data-item data-name={it.name.toLowerCase()} data-tags={`${it.tags ?? ""} ${it.kind.toLowerCase()}`} data-kind={it.kind} data-preinstalled={String(!!it.preinstalled)}>
          <button class="card" data-open={it.name} data-to={it.to ?? ""}>
            <span class="head"><img src={logo(it.logo)} alt="" width="32" height="32" /><strong>{it.name}</strong></span>
            <span class="badges">
              <span class="badge"><Fragment set:html={icon[it.kind]} />{it.kind}</span>
              {it.pro && <span class="badge pro">Pro</span>}
              <span class="installed" title="Already installed"><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>Installed</span>
            </span>
          </button>
        </li>
      ))}
    </ul>
    <p class="none" data-none hidden>No integrations match. <button class="textlink" data-reset>Show all integrations</button></p>
  </div>

  <div class="drawer" data-drawer hidden>
    <div class="sheet" role="dialog" aria-modal="true" data-sheet>
      <button class="x" data-close aria-label="Close"><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2 2 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
      <header><img data-d-logo alt="" width="40" height="40" /><div><h3 data-d-name></h3><span class="badge" data-d-kind></span></div></header>
      <p data-d-text></p>
      <ol>
        <li>Install the Grafana Agent on the host or cluster that runs it.</li>
        <li>Turn on the integration to add its scrape config, dashboards and alerts.</li>
        <li>Check the dashboards: data shows up within a minute.</li>
      </ol>
      <button class="primary" data-install>Install integration</button>
    </div>
  </div>
  <p class="toast" role="status" aria-live="polite"></p>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-console]")) {
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const search = $<HTMLInputElement>("[data-search]");
    const cat = $<HTMLSelectElement>("[data-cat]");
    const rows = [...root.querySelectorAll<HTMLElement>("[data-item]")];
    let onlyInstalled = false;

    // The installed view starts with what the 2022 frame showed as installed; elsewhere nothing is installed yet
    if (root.dataset.installed === "true") rows.forEach((r) => r.classList.toggle("is-installed", r.dataset.preinstalled === "true"));

    function filter() {
      const q = search.value.trim().toLowerCase();
      let shown = 0;
      for (const r of rows) {
        const ok = (!q || `${r.dataset.name} ${r.dataset.tags}`.includes(q))
          && (!cat.value || r.dataset.kind === cat.value)
          && (!onlyInstalled || r.classList.contains("is-installed"));
        r.hidden = !ok;
        if (ok) shown++;
      }
      $("[data-none]").hidden = shown > 0;
    }
    search.addEventListener("input", filter);
    cat.addEventListener("change", filter);
    const seg = [...root.querySelectorAll<HTMLElement>("[data-show]")];
    seg.forEach((b) => b.addEventListener("click", () => {
      seg.forEach((x) => x.setAttribute("aria-checked", String(x === b)));
      onlyInstalled = b.dataset.show === "installed";
      filter();
    }));
    $("[data-reset]").addEventListener("click", () => { search.value = ""; cat.value = ""; seg[0].click(); });

    // Open a card: real pages where they exist, a detail drawer for the rest
    const drawer = $("[data-drawer]");
    let current: HTMLElement | null = null;
    root.querySelectorAll<HTMLElement>("[data-open]").forEach((card) => card.addEventListener("click", () => {
      if (card.dataset.to) { location.hash = card.dataset.to; return; }
      current = card.closest("[data-item]");
      $<HTMLImageElement>("[data-d-logo]").src = card.querySelector("img")!.src;
      $("[data-d-name]").textContent = card.dataset.open!;
      $("[data-sheet]").setAttribute("aria-label", card.dataset.open!);
      $("[data-d-kind]").textContent = current!.dataset.kind!;
      $("[data-d-text]").textContent = `Collect ${card.dataset.open} metrics and logs with the Grafana Agent, with prebuilt dashboards and alerts.`;
      const done = current!.classList.contains("is-installed");
      $<HTMLButtonElement>("[data-install]").textContent = done ? "Installed" : "Install integration";
      $<HTMLButtonElement>("[data-install]").disabled = done;
      drawer.hidden = false;
      $<HTMLButtonElement>("[data-close]").focus();
    }));
    const close = () => { drawer.hidden = true; };
    $("[data-close]").addEventListener("click", close);
    drawer.addEventListener("click", (e) => { if (e.target === drawer) close(); });
    root.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
    $("[data-install]").addEventListener("click", () => {
      current?.classList.add("is-installed");
      close();
      toast(`${current?.querySelector("strong")?.textContent} installed`);
      filter();
    });

    const toastEl = $(".toast");
    let toastTimer = 0;
    function toast(text: string) {
      toastEl.textContent = text;
      toastEl.classList.add("on");
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toastEl.classList.remove("on"), 1800);
    }
    filter();
  }
</script>

<style>
  .title { display: flex; align-items: center; gap: 12px; padding: 32px 0 20px 125px; border-bottom: 1px solid var(--line); }
  .title h1 { margin: 0; font-size: 24px; line-height: 32px; font-weight: 400; color: #d8d9da; }
  .wrap { max-width: 1230px; padding: 39px 48px 120px 125px; }
  .wrap h2 { margin: 0; font-size: 18px; line-height: 24px; font-weight: 500; color: #d8d9da; }
  .sub { margin: 8px 0 24px; color: var(--dim); }
  .search { display: flex; align-items: center; gap: 8px; height: 32px; padding: 0 8px; color: var(--dim); background: #111217; border: 1px solid var(--line); border-radius: 2px; }
  .search:focus-within { outline: 2px solid #5794f2; outline-offset: -1px; }
  .search input { flex: 1; height: 100%; padding: 0; font: inherit; color: #ccccdc; background: none; border: 0; outline: 0; }
  .filters { display: flex; justify-content: space-between; align-items: center; margin: 16px 0 32px; }
  .filters select { width: 280px; }
  .seg { display: inline-flex; padding: 2px; border: 1px solid var(--line); border-radius: 2px; }
  .seg button { min-width: 68px; padding: 4px 14px; font: inherit; font-weight: 500; color: var(--dim); background: none; border: 0; border-radius: 2px; cursor: pointer; }
  .seg [aria-checked="true"] { background: #2c3235; color: #d8d9da; }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 10px; }
  .card {
    position: relative; display: flex; flex-direction: column; align-items: stretch; justify-content: flex-start; width: 100%; height: 160px; padding: 24px; text-align: left; font: inherit; color: #ccccdc; cursor: pointer;
    background: #22252b; border: 1px solid transparent; border-radius: 2px; transition: border-color .15s ease, background .15s ease;
  }
  .card:hover { background: #2c3032; border-color: rgba(87, 148, 242, .5); }
  .head { display: flex; align-items: center; gap: 12px; }
  .head img { object-fit: contain; }
  .head strong { font-size: 16px; font-weight: 500; color: #d8d9da; }
  .badges { display: flex; align-items: center; gap: 8px; margin-top: auto; }
  .badge { display: inline-flex; align-items: center; gap: 6px; height: 24px; padding: 0 8px; border-radius: 2px; background: #181b1f; font-size: 12px; color: #ccccdc; }
  .pro { background: rgba(255, 136, 51, .15); color: #ff8833; }
  .installed { display: none; align-items: center; gap: 4px; margin-left: auto; padding: 0 8px; height: 24px; border-radius: 2px; background: rgba(108, 207, 142, .15); color: #6ccf8e; font-size: 12px; }
  .is-installed .installed { display: inline-flex; }
  .none { margin-top: 24px; color: var(--dim); }
  .textlink { padding: 0; font: inherit; color: var(--link); background: none; border: 0; cursor: pointer; }
  .textlink:hover { text-decoration: underline; }

  .drawer { position: fixed; inset: 0; z-index: 4; display: flex; justify-content: flex-end; background: rgba(0, 0, 0, .45); animation: fade .15s ease; }
  .drawer[hidden] { display: none; }
  @keyframes fade { from { opacity: 0; } }
  .sheet { position: relative; width: min(480px, 100%); height: 100%; padding: 32px; overflow: auto; background: #181b1f; border-left: 1px solid var(--line); animation: slide .2s ease-out; }
  @keyframes slide { from { translate: 24px 0; } }
  .sheet header { display: flex; align-items: center; gap: 16px; margin-bottom: 20px; }
  .sheet h3 { margin: 0 0 6px; font-size: 20px; font-weight: 500; color: #d8d9da; }
  .sheet ol { margin: 0 0 24px; padding-left: 20px; display: flex; flex-direction: column; gap: 10px; color: var(--dim); }
  .x { position: absolute; top: 16px; right: 16px; display: grid; place-items: center; width: 28px; height: 28px; border: 0; border-radius: 2px; background: none; color: var(--dim); cursor: pointer; }
  .x:hover { background: #22252b; color: #fff; }

  @media (max-width: 1100px) { .title { padding-left: 48px; } .wrap { padding-left: 48px; } }
  @media (max-width: 900px) {
    .title, .wrap { padding-left: 16px; padding-right: 16px; }
    .filters { flex-direction: column; align-items: stretch; gap: 12px; }
    .filters select { width: 100%; }
  }
</style>
