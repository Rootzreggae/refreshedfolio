---
// Graphite plugin page: where "Send metrics → Graphite" lands. Rebuilt from the 2022 screen; creating the data source works.
import "./grafana.css";
const A = "/prototypes/grafana-onboarding";
const versions = [["5.0.0", "Graphite 1.1 support, tag explorer"], ["4.6.0", "Query editor: function autocomplete"], ["4.2.0", "Templating with tags"]];
---
<div class="gp graphite" data-graphite>
  <header class="top">
    <img src={`${A}/ds-graphite.svg`} alt="" width="48" height="45" />
    <div>
      <h1><a href="#dest-console">Plugins</a> / Graphite</h1>
      <p class="meta"><span>Grafana Labs</span><a href="#dest-graphite">Learn more</a><a href="#dest-graphite">Graphite 1.1 Release</a><span>◇ 18</span><span>5.0.0</span><span class="core">Core</span></p>
      <p class="desc">Open source time series database</p>
      <button class="primary" data-create>Create a Graphite data source</button>
    </div>
  </header>

  <div class="tabs" role="tablist">
    <button class="tab" role="tab" aria-selected="true" data-tab="overview">Overview</button>
    <button class="tab" role="tab" aria-selected="false" data-tab="versions">Version history</button>
  </div>

  <section class="panel" data-pane="overview">
    <form class="ds" data-form hidden>
      <h2>New Graphite data source</h2>
      <label>Name<input value="graphite" /></label>
      <label>URL<input data-url placeholder="http://localhost:8080" /></label>
      <label>Version<select><option>1.1.x</option><option>1.0.x</option><option>0.9.x</option></select></label>
      <div class="actions"><button class="primary" type="submit">Save &amp; test</button><button class="ghost" type="button" data-cancel>Cancel</button></div>
      <p class="result" data-result role="status"></p>
    </form>

    <h2>Graphite Data Source - Native Plugin</h2>
    <p>Grafana ships with built in support for Graphite (of course!).</p>
    <p>Grafana has an advanced Graphite query editor that lets you quickly navigate the metric space, add functions, change function parameters and much more. The editor can handle all types of graphite queries. It can even handle complex nested queries through the use of query references.</p>
    <p>Read more about it here:</p>
    <p><a class="inline" href="#dest-graphite">http://docs.grafana.org/datasources/graphite/</a></p>
    <p>Graphite 1.1 Release:</p>
    <p><a class="inline" href="#dest-graphite">https://grafana.com/blog/2018/01/11/graphite-1.1-teaching-an-old-dog-new-tricks/</a></p>
  </section>

  <section class="panel" data-pane="versions" hidden>
    <ul class="versions">{versions.map(([v, t]) => <li><b>{v}</b><span>{t}</span></li>)}</ul>
  </section>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-graphite]")!;
  const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
  const tabs = [...root.querySelectorAll<HTMLElement>("[data-tab]")];
  const open = (id: string) => {
    tabs.forEach((t) => t.setAttribute("aria-selected", String(t.dataset.tab === id)));
    root.querySelectorAll<HTMLElement>("[data-pane]").forEach((p) => (p.hidden = p.dataset.pane !== id));
  };
  tabs.forEach((t) => t.addEventListener("click", () => open(t.dataset.tab!)));

  const form = $<HTMLFormElement>("[data-form]");
  $("[data-create]").addEventListener("click", () => { open("overview"); form.hidden = false; $<HTMLInputElement>("[data-url]").focus(); });
  $("[data-cancel]").addEventListener("click", () => { form.hidden = true; });
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const url = $<HTMLInputElement>("[data-url]").value.trim();
    const result = $("[data-result]");
    result.className = "result";
    result.textContent = "Testing…";
    setTimeout(() => {
      const ok = /^https?:\/\/\S+/.test(url);
      result.classList.add(ok ? "ok" : "bad");
      result.textContent = ok ? "Data source is working" : "Enter the URL of your Graphite server, like http://graphite:8080";
    }, 900);
  });
</script>

<style>
  .graphite { max-width: 1000px; padding: 32px 48px 120px 136px; }
  .top { display: flex; gap: 20px; margin-bottom: 24px; }
  .top h1 { margin: 0 0 8px; font-size: 24px; line-height: 32px; font-weight: 400; color: #d8d9da; }
  .top h1 a { color: inherit; text-decoration: underline; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 0 8px; }
  .meta > * + *::before { content: "|"; margin-right: 8px; color: var(--dim); }
  .meta a { color: #ccccdc; text-decoration: none; }
  .meta a:hover { text-decoration: underline; }
  .core { padding: 0 6px; border-radius: 2px; background: #3d71d9; color: #fff; font-size: 11px; }
  .core::before { display: none; }
  .desc { margin: 0 0 14px; font-size: 12px; }
  .graphite .tabs { padding-left: 0; border-bottom: 0; }
  .graphite .panel { padding: 32px 26px; }
  .panel h2 { margin: 0 0 16px; font-size: 20px; line-height: 28px; font-weight: 500; color: #d8d9da; }
  .panel p { margin: 0 0 14px; }
  .ds { display: flex; flex-direction: column; gap: 14px; max-width: 460px; margin-bottom: 32px; padding: 20px; border: 1px solid var(--line); border-radius: 2px; background: #111217; }
  .ds[hidden] { display: none; }
  .ds label { display: flex; flex-direction: column; gap: 6px; font-weight: 500; }
  .ds input, .ds select { width: 100%; }
  .actions { display: flex; gap: 8px; }
  .ghost { height: 32px; padding: 0 16px; font: inherit; color: #ccccdc; background: none; border: 1px solid var(--line); border-radius: 2px; cursor: pointer; }
  .result { min-height: 21px; margin: 0 !important; color: var(--dim); }
  .result.ok { color: #6ccf8e; }
  .result.bad { color: #ff7383; }
  .versions { list-style: none; margin: 0; padding: 0; }
  .versions li { display: flex; gap: 24px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .versions b { width: 60px; font-weight: 500; color: #d8d9da; }
  @media (max-width: 900px) { .graphite { padding: 24px 16px 96px; } .top { flex-direction: column; } }
</style>
