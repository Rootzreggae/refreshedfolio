      >
        <div
          aria-hidden="true"
          style="position:absolute; top:0; left:0; right:0; height:32px; padding:0 6px; display:flex; align-items:center; justify-content:space-between; background:#0A1626;"
        >
          <span
            style="height:22px; padding:0 8px; display:flex; align-items:center; background:#182E49; font-size:11px;"
