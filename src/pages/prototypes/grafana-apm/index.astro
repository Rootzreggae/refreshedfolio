    .listen { display: flex; align-items: center; gap: 16px; padding: 18px 22px; border: 1px solid var(--line); border-radius: 8px; background: #121722; }
    .listen div { display: flex; flex-direction: column; } .listen b { color: #fff; font-weight: 600; } .listen span { color: var(--text); } .listen code { border: 0; background: none; padding: 0; font-size: 15px; }
    .spin { flex: none; width: 22px; height: 22px; border-radius: 50%; border: 2px solid rgba(110, 159, 255, .25); border-top-color: #6e9fff; animation: spin 1s linear infinite; }
