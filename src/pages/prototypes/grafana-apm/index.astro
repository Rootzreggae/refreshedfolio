    .empty-s { margin: auto; display: flex; flex-direction: column; align-items: center; gap: 14px; } .empty-s p { margin: 0; font-size: 12px; color: var(--dim); }
    .hint-tip { margin-top: 24px; color: var(--dim); font-size: 13px; }

    .panel { background: var(--panel); border: 1px solid var(--line); border-radius: 2px; padding: 20px; }
