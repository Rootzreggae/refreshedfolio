    .qbtns { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 12px; }
    .trace { padding: 12px; border: 1px solid var(--line); border-radius: 2px; background: var(--page); min-width: 0; }
    .tr-meta { margin: 0; font-size: 12px; color: var(--dim); } .tr-meta b { color: var(--text); font-weight: 500; }
    .ticks { display: flex; justify-content: space-between; margin: 0 0 6px 38%; padding: 0; list-style: none; font-size: 10px; color: var(--dim); }
    .spans { margin: 0; padding: 0; list-style: none; }
    .spans li { display: grid; grid-template-columns: 38% minmax(0, 1fr); align-items: center; height: 26px; border-bottom: 1px solid rgba(204, 204, 220, .05); font-size: 12px; cursor: default; }
    .spans li:hover { background: rgba(255, 255, 255, .03); }
    .sname { padding-left: calc(var(--d) * 16px + 6px); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--dim); } .sname b { font-weight: 500; color: var(--text); }
    .sbar { position: relative; height: 100%; } .sbar i { position: absolute; top: 8px; height: 10px; border-radius: 2px; } .sbar em { position: absolute; top: 5px; font-style: normal; font-size: 11px; color: var(--dim); white-space: nowrap; }
    .volume { display: flex; align-items: flex-end; gap: 3px; height: 140px; margin: 8px 0 0; } .volume i { flex: 1; background: #ff9830; opacity: .85; border-radius: 1px 1px 0 0; }
    .logopts { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin: 14px 0 8px; font-size: 12px; } .logopts label { display: inline-flex; gap: 6px; align-items: center; }
    .logs { margin: 0; padding: 0; list-style: none; font: 12px/1.6 ui-monospace, monospace; } .logs li { padding: 4px 10px; border-left: 3px solid #5794f2; border-bottom: 1px solid rgba(204, 204, 220, .05); }
    .logs.nowrap li { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .smap { width: 100%; height: auto; max-height: 520px; } .edges path { fill: none; stroke: rgba(204, 204, 220, .3); stroke-width: 2; }
    .node circle { fill: var(--page); stroke: #3cc39a; stroke-width: 3; } .node.me circle { stroke: #ff9830; stroke-width: 4; } .node text { fill: var(--text); font-size: 13px; text-anchor: middle; } .node .v { fill: var(--dim); font-size: 11px; }
    .quality { margin: 0; padding: 0; list-style: none; max-width: 820px; } .quality li { display: flex; flex-direction: column; gap: 4px; padding: 16px 0; border-bottom: 1px solid var(--line); } .quality b { color: var(--strong); font-weight: 500; } .quality span { color: var(--dim); }
    .toast { position: fixed; left: 50%; bottom: 28px; z-index: 50; translate: -50% 12px; margin: 0; padding: 10px 16px; border-radius: 4px; background: #2c3235; color: var(--strong); box-shadow: 0 6px 20px rgba(0, 0, 0, .5); opacity: 0; pointer-events: none; transition: opacity .2s ease, translate .2s ease; } .toast.on { opacity: 1; translate: -50% 0; }
    :is(.btn, .tab, .lang, .burger, .mega-item, .side-group a, .seg button):focus-visible { outline: 2px solid #5794f2; outline-offset: 2px; }
    @media (max-width: 1100px) { .charts, .two, .split { grid-template-columns: 1fr; } .langs { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 800px) { .app { grid-template-columns: 1fr; } .side { display: none; } .trio { grid-template-columns: 1fr; } .usage { flex-wrap: wrap; } }
