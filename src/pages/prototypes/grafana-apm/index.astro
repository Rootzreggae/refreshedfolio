    .code { margin: 0; padding: 14px; background: var(--page); border: 1px solid var(--line); border-radius: 2px; font: 12px/1.6 ui-monospace, monospace; white-space: pre-wrap; }
    .send { display: flex; justify-content: flex-end; align-items: center; gap: 16px; margin-top: 24px; } .send span { color: var(--dim); font-size: 13px; }

    .row-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 16px; }
    .tools { display: flex; gap: 10px; align-items: center; }
