---
// Grafana Application Observability, rebuilt in code from Nilson's original design file: from the empty state and
// language setup to a service's overview, traces, logs and map. Charts are drawn from generated sample data.
const A = "/prototypes/grafana-apm";

// --- sample data (deterministic, so the page looks the same on every load) ---
function rng(seed: number) { let s = seed; return () => ((s = (s * 16807) % 2147483647) / 2147483647); }
function series(seed: number, n: number, base: number, spread: number, trend = 0) {
  const r = rng(seed); let v = base; const out: number[] = [];
  for (let i = 0; i < n; i++) { v = Math.max(0, v + (r() - 0.5) * spread + trend); out.push(v); }
  return out;
}
function area(vals: number[], w: number, h: number, max: number) {
  const pts = vals.map((v, i) => `${((i / (vals.length - 1)) * w).toFixed(1)},${(h - (v / max) * h).toFixed(1)}`);
  return { line: `M${pts.join("L")}`, fill: `M0,${h}L${pts.join("L")}L${w},${h}Z` };
}
const W = 400, H = 130;
const dur = series(7, 60, 22, 9, 0.25), dur99 = dur.map((v) => v * 1.5), durAvg = dur.map((v) => v * 0.6);
const err = series(11, 60, 2.1, 0.8), rate = series(23, 60, 26, 6, 0.08);
const durPrev = series(31, 60, 18, 7, 0.1), errPrev = series(37, 60, 1.6, 0.6), ratePrev = series(41, 60, 22, 5);
const charts = [
  { id: "duration", title: "Duration, p95", unit: "ms", max: 63, ticks: ["63 ms", "31 ms", "16 ms", "8 ms", "4 ms", "0 ms"], lines: [
    { name: "p95", color: "#ff9830", fill: true, d: area(dur, W, H, 63) },
    { name: "p99", color: "#fade2a", d: area(dur99.map((v) => Math.min(v, 62)), W, H, 63) },
    { name: "average", color: "#b877d9", d: area(durAvg, W, H, 63) },
  ], prev: area(durPrev, W, H, 63) },
  { id: "errors", title: "Errors", unit: "%", max: 5, ticks: ["5%", "4%", "3%", "2%", "1%", "0%"], lines: [
    { name: "errors", color: "#ff5286", fill: true, d: area(err, W, H, 5) },
  ], prev: area(errPrev, W, H, 5) },
  { id: "rate", title: "Rate", unit: "req/s", max: 50, ticks: ["50", "40", "30", "20", "10", "0"], lines: [
    { name: "rate", color: "#3cc39a", fill: true, d: area(rate, W, H, 50) },
  ], prev: area(ratePrev, W, H, 50) },
];
const times = ["08:15", "08:20", "08:25", "08:30", "08:35", "08:40"];
const hist = series(53, 40, 30, 40).map((v, i) => Math.max(2, v * Math.exp(-((i - 14) ** 2) / 60) + (i > 24 && i < 28 ? 25 : 0)));
const spark = (seed: number, color: string) => ({ color, d: area(series(seed, 24, 10, 5), 90, 22, 22).line });
const downstream = [
  { name: "redis", icon: "redis", req: "ms 100", err: "1,4%", rate: "20.2", s: [spark(61, "#ff9830"), spark(62, "#ff5286"), spark(63, "#3cc39a")] },
  { name: "checkoutservice", icon: "svc", req: "ms 100", err: "1,4%", rate: "20.2", s: [spark(64, "#ff9830"), spark(65, "#ff5286"), spark(66, "#3cc39a")] },
  { name: "postgres", icon: "db", req: "ms 100", err: "1,4%", rate: "20.2", s: [spark(67, "#ff9830"), spark(68, "#ff5286"), spark(69, "#3cc39a")] },
];
const upstream = ["frontend", "couponcalculator", "invoiceservice"].map((name, i) => ({ name, s: [spark(71 + i, "#ff9830"), spark(81 + i, "#ff5286"), spark(91 + i, "#3cc39a")] }));
const ops = [
  { name: "POST /order", d: spark(101, "#ff9830"), e: spark(102, "#ff5286"), r: spark(103, "#3cc39a") },
  { name: "GET /cart", d: spark(104, "#ff9830"), e: spark(105, "#ff5286"), r: spark(106, "#3cc39a") },
  { name: "adservice", d: spark(107, "#ff9830"), e: spark(108, "#ff5286"), r: spark(109, "#3cc39a") },
  { name: "redis", d: spark(110, "#ff9830"), e: spark(111, "#ff5286"), r: spark(112, "#3cc39a") },
];
const logVolume = series(131, 48, 30, 30).map((v) => Math.max(4, Math.min(58, v)));
const logLines = Array.from({ length: 12 }, (_, i) => {
  const m = 42 + Math.floor(i / 2), s = (41 - i * 3 + 60) % 60;
  return `2023-01-26 08:${m}:${String(s).padStart(2, "0")} {"body":{"MESSAGE":"Window manager warning: Last user time (11233) is greater than comparison timestamp (11233). This most likely represents a buggy client sending inaccurate timestamps in messages such as _NET_ACTIVE_WINDOW."}}`;
});
const spans = [
  { name: "Adservice-requester", op: "requester..", depth: 0, start: 0, len: 100, ms: "509.56ms", color: "#3cc39a" },
  { name: "Adservice-requester", op: "GET /:endpoint", depth: 1, start: 2, len: 33, ms: "167.24ms", color: "#3cc39a" },
  { name: "Adservice-requester", op: "GET /:endpoint ..", depth: 2, start: 3, len: 4, ms: "17.98ms", color: "#5794f2" },
  { name: "Adservice-requester", op: "GET /:endpoint ...", depth: 2, start: 8, len: 0.4, ms: "14 μs", color: "#5794f2" },
  { name: "Adservice-requester", op: "GET /:endpoint ...", depth: 2, start: 9, len: 0.6, ms: "42μs", color: "#5794f2" },
  { name: "Adservice-requester", op: "GET /:endpoint ...", depth: 2, start: 10, len: 0.8, ms: "57μs", color: "#5794f2" },
  { name: "Adservice-requester", op: "GET /:endpoint ...", depth: 2, start: 11, len: 0.3, ms: "3μs", color: "#5794f2" },
  { name: "Adservice-requester", op: "GET /:endpoint ...", depth: 2, start: 12, len: 2.4, ms: "12.1ms", color: "#5794f2" },
  { name: "Adservice-requester", op: "GET /:endpoint", depth: 1, start: 36, len: 13, ms: "67.24ms", color: "#3cc39a" },
  { name: "cartservice", op: "GET /cart", depth: 1, start: 50, len: 33, ms: "167.24ms", color: "#ff9830" },
  { name: "cartservice", op: "redis GET", depth: 2, start: 52, len: 4, ms: "17.98ms", color: "#ff9830" },
  { name: "cartservice", op: "postgres SELECT", depth: 2, start: 58, len: 22, ms: "112.4ms", color: "#ff9830" },
];
const languages = [
  { id: "java", ic: "Jv", name: "Java", fw: "Java 8+, Kotlin, Scala", on: true },
  { id: "go", ic: "Go", name: "Go", fw: "SDK, or zero-code with eBPF" },
  { id: "python", ic: "Py", name: "Python", fw: "Django, Flask, FastAPI" },
  { id: "node", ic: "JS", name: "Node.js", fw: "Express, Nest, Fastify" },
  { id: "net", ic: "C#", name: ".NET", fw: "ASP.NET Core, .NET 6+" },
];
const side = [
  ["Kubernetes", ["Nodes", "Dashboards", "Alerts", "Cluster efficiency"]],
  ["Application", ["Services", "Service map", "Configuration"]],
  ["Frontend", ["Error awareness", "Starred"]],
  ["Synthetics", ["Data sources", "Infrastructure", "Custom data"]],
] as const;
const steps = ["Pick a language", "Run the agent", "See your data"];
const megamenu = ["Home", "Starred", "Dashboards", "Explore", "Alerts & Incidents", "Connections", "Observability", "Administration"];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Application Observability · Prototype</title>
  <meta name="robots" content="noindex" />
  <link rel="preload" href={`${A}/inter.woff2`} as="font" type="font/woff2" crossorigin />
  <style is:global>
    @font-face { font-family: "Inter"; src: url("/prototypes/grafana-apm/inter.woff2") format("woff2"); font-weight: 100 900; font-display: swap; }
    :root { --page: #111217; --panel: #181b1f; --raise: #22252b; --line: rgba(204, 204, 220, .12); --text: #ccccdc; --strong: #d8d9da; --dim: rgba(204, 204, 220, .65); --blue: #3d71d9; --link: #6e9fff; }
    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; background: var(--page); color: var(--text); font: 14px/1.5 Inter, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
    button { font: inherit; color: inherit; }
    a { color: inherit; }
    [data-screen] { display: none; } [data-screen].active { display: block; animation: in .25s ease; }
    @keyframes in { from { opacity: 0; } }
  </style>
</head>
<body>
  <!-- One top bar: menu, logo and breadcrumb on the left, search on the right -->
  <header class="topbar">
    <button class="burger" data-menu aria-label="Open menu" aria-expanded="false"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button>
    <img src={`${A}/grafana.svg`} alt="Grafana" width="26" height="26" />
    <nav class="crumbs" data-crumbs aria-label="Breadcrumb"></nav>
    <label class="search"><svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.8" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="m10.6 10.6 3.4 3.4" stroke="currentColor" stroke-width="1.4"/></svg><input placeholder="Search or jump to" aria-label="Search" /><kbd>⌘K</kbd></label>
    <span class="avatar" aria-hidden="true"></span>
  </header>

  <aside class="mega" data-mega hidden>
    {megamenu.map((m) => (
      <a href={m === "Observability" ? "#services-empty" : m === "Home" ? "#home" : m === "Connections" ? "#config" : "#home"} class:list={["mega-item", { strong: m === "Observability" }]}>{m}<span aria-hidden="true">›</span></a>
    ))}
  </aside>

  <!-- 1. Home -->
  <main class="screen home" data-screen="home" data-crumb="Home">
    <div class="home-head">
      <h1>Welcome to <b>Grafana Cloud</b> <span class="plan">Free plan</span></h1>
      <a class="btn primary" href="#services-empty">+ Connect data</a>
    </div>
    <nav class="home-links">{["Stacks", "Users", "API keys", "Billing/Usage dashboard", "Manage subscription"].map((l) => <a href="#home">{l}</a>)}</nav>
    <section class="panel usage"><div><b>Current usage</b><small>*Month to date</small></div><ul><li><em>9.5k</em> Metrics*</li><li><em>1GB</em> Logs*</li><li><em>21</em> Alerts*</li><li><em>1</em> Users</li></ul></section>
    <div class="trio">
      <section class="panel box"><header><h2>Data connections</h2><a href="#services-empty">All connections →</a></header><div class="empty-s"><p>No data connections yet</p><a class="btn primary" href="#services-empty">+ Connect data</a></div></section>
      <section class="panel box"><header><h2>Dashboards</h2><a href="#home">All dashboards →</a></header><div class="empty-s"><p>No dashboards yet</p></div></section>
      <section class="panel box"><header><h2>Alerts</h2><a href="#home">All alerts →</a></header><div class="empty-s"><p>No alerts yet</p></div></section>
    </div>
    <p class="hint-tip">Open the menu (☰) and pick <b>Observability</b>, or Connect data.</p>
  </main>

  <!-- Observability app frame: sidebar + content (screens 2 to 6) -->
  <div class="app" data-app>
    <aside class="side">
      <p class="side-title"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M1 9h3l2-6 4 10 2-4h3" fill="none" stroke="#ff8833" stroke-width="1.6"/></svg>Observability</p>
      {side.map(([group, items]) => (
        <div class="side-group">
          <p>{group}</p>
          {items.map((it) => <a href={it === "Services" ? "#services" : it === "Configuration" ? "#services-empty" : it === "Service map" ? "#svc-map" : "#services"} data-side={it}>{it}</a>)}
        </div>
      ))}
      <div class="side-foot"><a href="#services">Documentation</a><a href="#services">Give feedback</a></div>
    </aside>

    <div class="content">
      <!-- 2. Add your first service: the empty state is the first step of setup -->
      <main class="screen page" data-screen="services-empty" data-crumb="Home/Application/Services" data-side-on="Services">
        <p class="eyebrow">Services · 0 reporting</p>
        <h1 class="title">Add your first service</h1>
        <p class="lede">Instrument an app and its latency, errors and request rate show up here, usually within a few minutes of it getting traffic.</p>
        <ol class="stepper" data-step="1">{steps.map((st, i) => <li><span>{i + 1}</span>{st}</li>)}</ol>
        <h2 class="q">What is your service written in?</h2>
        <div class="langs">
          {languages.map((l) => (
            <a class:list={["lang", { off: !l.on }]} href={l.on ? "#jvm" : "#services-empty"} aria-disabled={!l.on} title={l.on ? undefined : "Java is wired up in this prototype"}>
              <span class="lang-ic">{l.ic}</span><span><b>{l.name}</b><small>{l.fw}</small></span>
            </a>
          ))}
          <a class="lang dashed off" href="#services-empty" aria-disabled="true"><span class="lang-ic">{"{ }"}</span><span><b>Something else</b><small>Any OpenTelemetry SDK</small></span></a>
        </div>
        <div class="callout-k">
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5 20.5 7v10L12 21.5 3.5 17V7Z" fill="none" stroke="#6e9fff" stroke-width="1.6"/><circle cx="12" cy="12" r="3" fill="none" stroke="#6e9fff" stroke-width="1.6"/></svg>
          <div><b>Running on Kubernetes?</b><span>Instrument every service in a namespace at once, no code changes.</span></div>
          <a href="#services-empty">Use the Kubernetes integration →</a>
        </div>
        <p class="minor-h">Once a service reports, it appears here</p>
        <div class="skeleton"><div class="sk-head"><span>Service</span><span>p95 latency</span><span>Error rate</span><span>Requests</span></div>{[0, 1].map(() => <div class="sk-row"><i></i><i></i><i></i><i></i></div>)}</div>
      </main>

      <!-- 3. Instrument a Java service: three steps, the stack's endpoint and token filled in -->
      <main class="screen page" data-screen="jvm" data-crumb="Home/Services/Add a Java service" data-side-on="Services">
        <div class="jvm-grid">
          <div>
            <a class="back-link" href="#services-empty">← Change language</a>
            <h1 class="title">Instrument a Java service</h1>
            <p class="lede">Three steps. We fill in your stack's endpoint and credentials for you.</p>

            <section class="stepcard" data-card="1">
              <span class="stepnum">1</span>
              <h2>Create an access token</h2>
              <label class="lbl" for="tok">Token name</label>
              <div class="inline"><input id="tok" class="field" value="apm-cart-service" /><button class="btn primary big" data-token>Generate token</button></div>
              <p class="help" data-token-help>Scoped to write metrics, logs and traces. You can revoke it any time in Access policies.</p>
            </section>

            <section class="stepcard" data-card="2">
              <span class="stepnum">2</span>
              <h2>Run your app with the agent</h2>
              <label class="lbl" for="svcname">Service name</label>
              <input id="svcname" class="field mono half" value="cart_service" data-svcname />
              <div class="seg big" role="tablist">{["JVM flag", "Docker", "Kubernetes"].map((t, i) => <button class:list={{ on: i === 0 }} data-run={i}>{t}</button>)}</div>
              <div class="codebox"><button class="copy" data-copy>Copy</button><pre data-code></pre></div>
              <p class="help">Uses the OpenTelemetry Java agent. Auto-instruments HTTP, JDBC, gRPC, Kafka and more. <a class="lnk" href="#jvm">Prefer manual instrumentation?</a></p>
            </section>

            <section class="stepcard" data-card="3">
              <span class="stepnum">3</span>
              <h2>Send some traffic</h2>
              <div class="listen" data-listen><span class="spin" aria-hidden="true"></span><div><b>Listening for <code data-svcname-out>cart_service</code></b><span>Hit any endpoint on your app. This updates on its own when the first span lands.</span></div></div>
              <details class="trouble"><summary>Nothing after a few minutes?</summary><ul><li>Check the app can reach the OTLP endpoint over HTTPS.</li><li>Make sure the token is in the headers, not the URL.</li><li>Restart the app after setting the variables.</li></ul></details>
              <p class="sim"><button class="textbtn" data-simulate>Prototype: simulate first data →</button></p>
            </section>
          </div>
          <aside class="rail">
            <div class="rail-box"><b>Before you start</b><ul><li>Java 8 or newer</li><li>Outbound HTTPS from the app</li><li>Permission to restart the app</li></ul></div>
            <div class="rail-plain"><b>You will get</b><ul><li>Latency, errors and request rate per endpoint</li><li>Traces linked to logs</li><li>A service map of what it calls</li></ul></div>
          </aside>
        </div>
      </main>

      <!-- 5. Services -->
      <main class="screen page" data-screen="services" data-crumb="Home/Application/Services" data-side-on="Services">
        <div>
          <div class="row-head"><h1 class="h1">Services</h1><span class="tools"><span class="sel">Environment <b>All</b></span><a class="btn" href="#services">Add Alert</a><a class="btn primary" href="#services-empty">+ Add Service</a></span></div>
          <div class="filterbar"><label class="input grow"><input placeholder="Search by service name" aria-label="Search by service name" data-svc-search /></label><span class="sel">Last 30 minutes <b>UTC</b></span></div>
          <div class="filterbar"><span class="chip">Filters +</span><span class="demo">Demo</span></div>
          <table class="tbl">
            <thead><tr><th>Name</th><th>Namespace</th><th>Duration (p95)</th><th>Errors</th><th>Rate</th></tr></thead>
            <tbody>
              <tr class="click" data-href="#svc" data-name="cartservice">
                <td><span class="svc-ic"></span><span data-svc-row>cart_service</span></td><td><a class="lnk" href="#svc">payment</a></td>
                <td><span class="num">20.2ms</span><svg viewBox="0 0 90 22" class="sp"><path d={spark(201, "").d} stroke="#ff9830" /></svg></td>
                <td><span class="num">28.2req/s</span><svg viewBox="0 0 90 22" class="sp"><path d={spark(202, "").d} stroke="#ff5286" /></svg></td>
                <td><span class="num">10.9req/s</span><svg viewBox="0 0 90 22" class="sp"><path d={spark(203, "").d} stroke="#3cc39a" /></svg></td>
              </tr>
            </tbody>
          </table>
        </div>
      </main>

      <!-- 6. A service: overview, traces, logs, map -->
      <main class="screen page svc" data-screen="svc" data-crumb="Home/Application/Services/cartservice" data-side-on="Services">
        <div>
          <div class="row-head">
            <h1 class="h1"><span data-svc-title>cart_service</span> <span class="badges" aria-hidden="true"><i style="--c:#ff5286">●</i><i style="--c:#ff9830">●</i><i style="--c:#f55f3e">∞</i></span></h1>
            <span class="tools"><span class="sel">Environment <b>All</b></span><a class="btn" href="#svc">Add Alert</a><a class="btn primary" href="#services-empty">+ Add Service</a></span>
          </div>
          <div class="tabs" role="tablist">
            {[["overview", "Overview"], ["traces", "Traces"], ["logs", "Logs"], ["map", "Service map", "22"], ["quality", "Instrumentation Quality", "3"]].map(([id, label, n]) => (
              <button class="tab" role="tab" data-tab={id} aria-selected={id === "overview" ? "true" : "false"}>{label}{n && <span class="count">{n}</span>}</button>
            ))}
          </div>

          <section data-pane="overview">
            <div class="filterbar">
              <span class="sel">Metrics <b>dev cortex</b></span><span class="sel">Traces <b>Tempo (tempo-ops)</b></span><span class="sel">Last 30 minutes <b>UTC</b></span>
              <label class="tfa"><input type="checkbox" data-tfa /> Timeframe Analysis</label>
              <select class="cmp" data-cmp aria-label="Compare with" disabled><option>Hour before</option><option>Day before</option><option>Week before</option></select>
            </div>
            <h2 class="sec">Health Indicators</h2>
            <div class="charts">
              {charts.map((c) => (
                <figure class="chart">
                  <figcaption>{c.title}</figcaption>
                  <div class="plot">
                    <ul class="yax">{c.ticks.map((t) => <li>{t}</li>)}</ul>
                    <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
                      <g class="grid">{[0, 1, 2, 3, 4].map((i) => <line x1="0" x2={W} y1={(i * H) / 5} y2={(i * H) / 5} />)}</g>
                      <path class="prev" d={c.prev.line} />
                      {c.lines.map((l) => <>{l.fill && <path d={l.d.fill} fill={l.color} opacity=".18" />}<path d={l.d.line} stroke={l.color} class="ln" /></>)}
                    </svg>
                  </div>
                  <ul class="xax">{times.map((t) => <li>{t}</li>)}</ul>
                  <ul class="legend">{c.lines.map((l) => <li style={`--c:${l.color}`}>{l.name}</li>)}<li class="prev-l">hour before</li></ul>
                </figure>
              ))}
            </div>
            <div class="two">
              <figure class="chart">
                <figcaption>Duration distribution</figcaption>
                <div class="bars">{hist.map((v) => <i style={`height:${Math.min(100, v)}%`}></i>)}</div>
                <ul class="xax"><li>10 ms</li><li>100 ms</li><li>1000 ms</li></ul>
              </figure>
              <figure class="chart rel">
                <figcaption>Relationships</figcaption>
                <p class="minor">Downstream &amp; Databases</p>
                <table class="tbl small"><thead><tr><th>Name</th><th>Requests</th><th>Errors</th><th>Rate</th></tr></thead><tbody>
                  {downstream.map((d) => <tr><td>{d.name}</td>{d.s.map((s) => <td><svg viewBox="0 0 90 22" class="sp"><path d={s.d} stroke={s.color} /></svg></td>)}</tr>)}
                </tbody></table>
                <p class="minor">Upstream</p>
                <table class="tbl small"><tbody>{upstream.map((u) => <tr><td>{u.name}</td>{u.s.map((s) => <td><svg viewBox="0 0 90 22" class="sp"><path d={s.d} stroke={s.color} /></svg></td>)}</tr>)}</tbody></table>
              </figure>
            </div>
            <h2 class="sec">Operations</h2>
            <table class="tbl"><thead><tr><th>Name</th><th>Duration, p95</th><th>Errors</th><th>Rate</th></tr></thead><tbody>
              {ops.map((o) => <tr class="click" data-tab-go="traces"><td>{o.name}</td><td><svg viewBox="0 0 90 22" class="sp"><path d={o.d.d} stroke="#ff9830" /></svg></td><td><svg viewBox="0 0 90 22" class="sp"><path d={o.e.d} stroke="#ff5286" /></svg></td><td>28.2 req/s <svg viewBox="0 0 90 22" class="sp"><path d={o.r.d} stroke="#3cc39a" /></svg></td></tr>)}
            </tbody></table>
          </section>

          <section data-pane="traces" hidden>
            <div class="filterbar"><label class="input grow"><input value="deployment.environment=dev" aria-label="Filter" /></label><span class="sel">now-15m to now</span><span class="sel">Compare with</span></div>
            <div class="split">
              <div class="query">
                <div class="seg">{["Search Beta", "TraceID", "JSON File", "Service Graph", "Loki Search"].map((q, i) => <button class:list={{ on: i === 0 }}>{q}</button>)}</div>
                {[["Service Name", "Ad service"], ["Span Name", "--"], ["Tags", ""], ["Min Duration", ""], ["Max Duration", ""], ["Limit", ""]].map(([k, v]) => <label class="qrow"><span>{k}</span><input value={v} aria-label={k} /></label>)}
                <div class="qbtns"><button class="btn">+ Add query</button><button class="btn">Query history</button><button class="btn">Inspector</button></div>
              </div>
              <div class="trace">
                <div class="row-head"><p class="tr-meta">Trace Start: <b>2023-01-25</b> · Duration: <b>509.56ms</b> · Services: <b>2</b> · Depth <b>4</b> · Total Spans: <b>22</b></p><button class="btn" data-tab-go="logs">Open Logs in explore</button></div>
                <ul class="ticks"><li>0μs</li><li>127.39ms</li><li>274.39ms</li><li>382.17ms</li><li>509.56ms</li></ul>
                <ul class="spans">
                  {spans.map((s) => (
                    <li style={`--d:${s.depth}`}>
                      <span class="sname"><b>{s.name}</b> {s.op}</span>
                      <span class="sbar"><i style={`left:${s.start}%;width:${Math.max(0.4, s.len)}%;background:${s.color}`}></i><em style={`left:calc(${s.start + Math.max(0.4, s.len)}% + 6px)`}>{s.ms}</em></span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </section>

          <section data-pane="logs" hidden>
            <div class="filterbar"><label class="input grow"><input value="deployment.environment=dev" aria-label="Filter" /></label><span class="sel">now-15m to now</span><span class="sel">Compare with</span><button class="btn">Open Logs in explore</button></div>
            <div class="volume">{logVolume.map((v) => <i style={`height:${(v / 60) * 100}%`}></i>)}</div>
            <ul class="xax wide">{["10:00", "12:00", "14:00", "16:00", "18:00", "20:00", "22:00", "26 Jan", "08:00"].map((t) => <li>{t}</li>)}</ul>
            <div class="logopts">
              <label><input type="checkbox" checked /> Time</label><label><input type="checkbox" /> Unique labels</label><label><input type="checkbox" checked data-wrap /> Wrap lines</label><label><input type="checkbox" /> Prettify JSON</label>
              <span class="seg">Dedup {["None", "Exact", "Numbers", "Signature"].map((d, i) => <button class:list={{ on: i === 0 }}>{d}</button>)}</span>
              <span class="seg">{["Newest first", "Oldest first"].map((d, i) => <button class:list={{ on: i === 0 }} data-order={i}>{d}</button>)}</span>
            </div>
            <p class="minor">Common labels: <code>OTLP</code> <code>6</code> · Line limit: 1000 (12 returned) · Total bytes processed: 49.8 kb</p>
            <ol class="logs" data-logs>{logLines.map((l) => <li>{l}</li>)}</ol>
          </section>

          <section data-pane="map" hidden>
            <svg class="smap" viewBox="0 0 900 360" aria-label="Service map">
              <g class="edges">
                <path d="M180 180 C 300 180, 330 110, 440 110" /><path d="M180 180 C 300 180, 330 250, 440 250" /><path d="M540 110 C 620 110, 650 70, 740 70" /><path d="M540 110 C 620 110, 650 160, 740 160" /><path d="M540 250 C 620 250, 650 280, 740 280" />
              </g>
              {[["frontend", 130, 180], ["cartservice", 490, 110], ["checkoutservice", 490, 250], ["redis", 790, 70], ["postgres", 790, 160], ["paymentservice", 790, 280]].map(([n, x, y]) => (
                <g class:list={["node", { me: n === "cartservice" }]} transform={`translate(${x} ${y})`}><circle r="34" /><text y="54">{n}</text><text class="v" y="5">20 ms</text></g>
              ))}
            </svg>
          </section>

          <section data-pane="quality" hidden>
            <ul class="quality">
              <li><b>Missing service.version</b><span>Deploys can’t be compared without it. Add <code>-Dotel.resource.attributes=service.version=…</code></span></li>
              <li><b>Spans without status codes</b><span>12% of server spans don’t set a status, so errors are undercounted.</span></li>
              <li><b>Logs not correlated</b><span>Log lines don’t carry the trace ID. Enable the logback appender to jump from a trace to its logs.</span></li>
            </ul>
          </section>
        </div>
      </main>
    </div>
  </div>
  <p class="toast" role="status" aria-live="polite"></p>

  <script>
    const screens = [...document.querySelectorAll<HTMLElement>("[data-screen]")];
    const app = document.querySelector<HTMLElement>("[data-app]")!;
    const crumbs = document.querySelector<HTMLElement>("[data-crumbs]")!;
    const mega = document.querySelector<HTMLElement>("[data-mega]")!;
    const burger = document.querySelector<HTMLElement>("[data-menu]")!;
    const toastEl = document.querySelector<HTMLElement>(".toast")!;
    let tt = 0;
    const toast = (t: string) => { toastEl.textContent = t; toastEl.classList.add("on"); clearTimeout(tt); tt = window.setTimeout(() => toastEl.classList.remove("on"), 2200); };

    // Router: #home, #services-empty, #config, #jvm, #services, #svc (and #svc-map opens the map tab)
    function show() {
      let id = location.hash.slice(1) || "home";
      let tab = "";
      if (id === "svc-map") { id = "svc"; tab = "map"; }
      if (id === "config") id = "services-empty";
      const target = screens.find((s) => s.dataset.screen === id) ?? screens[0];
      screens.forEach((s) => s.classList.toggle("active", s === target));
      app.style.display = target.closest("[data-app]") ? "grid" : "none";
      const parts = (target.dataset.crumb ?? "Home").split("/");
      crumbs.innerHTML = parts.map((p, i) => (i === parts.length - 1 ? `<b>${p}</b>` : `<a href="${p === "Home" ? "#home" : "#services"}">${p}</a>`)).join("<i>/</i>");
      document.querySelectorAll<HTMLElement>("[data-side]").forEach((a) => a.classList.toggle("on", a.dataset.side === (tab === "map" ? "Service Map" : target.dataset.sideOn)));
      if (tab) openTab(tab);
      mega.hidden = true; burger.setAttribute("aria-expanded", "false");
      scrollTo(0, 0);
    }
    addEventListener("hashchange", show);

    burger.addEventListener("click", () => { mega.hidden = !mega.hidden; burger.setAttribute("aria-expanded", String(!mega.hidden)); });
    document.addEventListener("click", (e) => { if (!mega.hidden && !mega.contains(e.target as Node) && !burger.contains(e.target as Node)) { mega.hidden = true; burger.setAttribute("aria-expanded", "false"); } });

    // Java setup: token, service name and run mode fill the command; step 3 listens, then the service reports
    let token = "[token]";
    const svcInput = document.querySelector<HTMLInputElement>("[data-svcname]")!;
    const code = document.querySelector<HTMLElement>("[data-code]")!;
    const endpoint = "https://otlp-gateway-prod-eu-west-2.grafana.net/otlp";
    let mode = 0;
    function cmd() {
      const n = svcInput.value.trim() || "cart_service";
      document.querySelector("[data-svcname-out]")!.textContent = n;
      const lines =
        mode === 0 ? [
          "curl -Lo opentelemetry-javaagent.jar \\",
          "  https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/latest/download/opentelemetry-javaagent.jar",
          "",
          `export OTEL_SERVICE_NAME=${n}`,
          `export OTEL_EXPORTER_OTLP_ENDPOINT=${endpoint}`,
          `export OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic ${token}"`,
          "",
          "java -javaagent:opentelemetry-javaagent.jar -jar app.jar",
        ] : mode === 1 ? [
          "docker run \\",
          `  -e OTEL_SERVICE_NAME=${n} \\`,
          `  -e OTEL_EXPORTER_OTLP_ENDPOINT=${endpoint} \\`,
          `  -e OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic ${token}" \\`,
          '  -e JAVA_TOOL_OPTIONS="-javaagent:/otel/opentelemetry-javaagent.jar" \\',
          "  your-image:latest",
        ] : [
          "kubectl create secret generic grafana-otlp \\",
          `  --from-literal=headers="Authorization=Basic ${token}"`,
          "",
          "# then let the operator inject the agent",
          `kubectl annotate deployment/${n} \\`,
          "  instrumentation.opentelemetry.io/inject-java=true",
        ];
      code.textContent = lines.join("\n");
    }
    svcInput.addEventListener("input", cmd);
    document.querySelectorAll<HTMLElement>("[data-run]").forEach((b) => b.addEventListener("click", () => {
      mode = +b.dataset.run!;
      b.parentElement!.querySelectorAll("button").forEach((x) => x.classList.toggle("on", x === b));
      cmd();
    }));
    document.querySelector("[data-token]")!.addEventListener("click", (e) => {
      token = "glc_eyJvIjoiODQ0MDc2IiwibiI6ImFwbS1jYXJ0LXNlcnZpY2UifQ";
      (e.currentTarget as HTMLButtonElement).textContent = "Token created ✓";
      document.querySelector("[data-card='1']")!.classList.add("done");
      document.querySelector("[data-token-help]")!.textContent = "Created and added to the command below. Scoped to write metrics, logs and traces.";
      cmd();
    });
    document.querySelector("[data-copy]")!.addEventListener("click", (e) => {
      navigator.clipboard?.writeText(code.textContent ?? "").catch(() => {});
      const b = e.currentTarget as HTMLButtonElement; b.textContent = "Copied"; setTimeout(() => (b.textContent = "Copy"), 1400);
    });
    document.querySelector("[data-simulate]")!.addEventListener("click", () => {
      const n = svcInput.value.trim() || "cart_service";
      const l = document.querySelector<HTMLElement>("[data-listen]")!;
      l.classList.add("got");
      l.querySelector("b")!.innerHTML = `First span from <code>${n}</code>`;
      l.querySelector("div span")!.textContent = "Opening Services…";
      document.querySelector("[data-svc-row]")!.textContent = n;
      document.querySelector<HTMLElement>("tr[data-name]")!.dataset.name = n.toLowerCase();
      document.querySelectorAll<HTMLElement>("[data-svc-title]").forEach((t) => (t.textContent = n));
      setTimeout(() => { toast(`${n} is reporting`); location.hash = "#services"; }, 1300);
    });
    cmd();

    // Services: the row opens the service; search filters it
    document.querySelectorAll<HTMLElement>("tr[data-href]").forEach((r) => r.addEventListener("click", (e) => { if (!(e.target as HTMLElement).closest("a")) location.hash = r.dataset.href!; }));
    document.querySelector<HTMLInputElement>("[data-svc-search]")!.addEventListener("input", (e) => {
      const q = (e.target as HTMLInputElement).value.toLowerCase();
      document.querySelectorAll<HTMLElement>("tr[data-name]").forEach((r) => (r.hidden = !r.dataset.name!.includes(q)));
    });

    // Service tabs
    const tabs = [...document.querySelectorAll<HTMLElement>("[data-tab]")];
    function openTab(id: string) {
      tabs.forEach((t) => t.setAttribute("aria-selected", String(t.dataset.tab === id)));
      document.querySelectorAll<HTMLElement>("[data-pane]").forEach((p) => (p.hidden = p.dataset.pane !== id));
    }
    tabs.forEach((t) => t.addEventListener("click", () => openTab(t.dataset.tab!)));
    document.querySelectorAll<HTMLElement>("[data-tab-go]").forEach((el) => el.addEventListener("click", () => openTab(el.dataset.tabGo!)));

    // Timeframe Analysis: overlay the comparison period on every chart
    const tfa = document.querySelector<HTMLInputElement>("[data-tfa]")!;
    const cmp = document.querySelector<HTMLSelectElement>("[data-cmp]")!;
    const svc = document.querySelector<HTMLElement>(".svc")!;
    const legendPrev = () => document.querySelectorAll<HTMLElement>(".prev-l").forEach((l) => (l.textContent = cmp.value.toLowerCase()));
    tfa.addEventListener("change", () => { svc.classList.toggle("compare", tfa.checked); cmp.disabled = !tfa.checked; legendPrev(); });
    cmp.addEventListener("change", legendPrev);

    // Logs: wrap and order
    document.querySelector<HTMLInputElement>("[data-wrap]")!.addEventListener("change", (e) => document.querySelector("[data-logs]")!.classList.toggle("nowrap", !(e.target as HTMLInputElement).checked));
    document.querySelectorAll<HTMLElement>("[data-order]").forEach((b) => b.addEventListener("click", () => {
      const list = document.querySelector("[data-logs]")!;
      b.parentElement!.querySelectorAll("button").forEach((x) => x.classList.toggle("on", x === b));
      if ((b.dataset.order === "1") !== list.classList.contains("old")) { list.classList.toggle("old"); [...list.children].reverse().forEach((li) => list.appendChild(li)); }
    }));
    // segmented buttons elsewhere just switch
    document.querySelectorAll<HTMLElement>(".seg").forEach((sg) => sg.querySelectorAll<HTMLButtonElement>("button:not([data-order])").forEach((b) => b.addEventListener("click", () => sg.querySelectorAll("button").forEach((x) => x.classList.toggle("on", x === b)))));

    show();
  </script>

  <style>
    .topbar { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; gap: 16px; height: 48px; padding: 0 16px; background: #181b1f; border-bottom: 1px solid var(--line); }
