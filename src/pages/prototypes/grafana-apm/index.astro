    .seg button { padding: 3px 9px; border: 0; border-radius: 2px; background: none; color: var(--dim); font-size: 12px; cursor: pointer; } .seg button.on { background: var(--raise); color: #fff; }
    .query .seg { margin-bottom: 12px; }
