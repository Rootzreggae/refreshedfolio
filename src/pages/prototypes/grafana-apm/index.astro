    .warn { color: #f8d06b; font-size: 12px; } .qlink { margin-top: 14px !important; color: var(--link); font-size: 12px; }
    .key { display: block; margin-top: 12px; padding: 10px 12px; background: var(--page); border: 1px solid var(--line); font: 12px ui-monospace, monospace; }
