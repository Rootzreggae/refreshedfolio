---
// Grafana Cloud onboarding, rebuilt in code from the original Figma file (2022).
const A = "/prototypes/grafana-onboarding";
const benefits = [
  "Enjoy all the benefits of a fully-managed cloud environment- true horizontal scalability, instant upgrades, security patches, and backups",
  "Monitor your entire stack using out-of-the-box integrations\n(Just install an agent, and we'll take care of the rest)",
  "Same Grafana plugins, dashboards and visualizations you know and love, only hosted in Grafana Cloud so it's easier to manage",
  "Visualize and alert on your Kubernetes cluster in minutes",
  "Manage your on-call rotations through simpler workflows and interfaces",
];

// Four ways in, each card says what it takes. Hovering or focusing a card brings its docs into the left panel.
const paths = [
  { id: "mlt", icon: "icon-mlt", title: "Send metrics, logs and traces", body: "Connect Prometheus, Loki or Tempo, or point an agent you already run at your stack.", meta: ["~10 min", "access to your hosts"],
    doc: { title: "Made for you, managed by us", body: "Grafana Cloud integrates metrics, traces and logs with Grafana. Use Prometheus, Loki and Tempo without installing, maintaining or scaling them yourself.", link: "Learn more on metrics, logs and traces" } },
  { id: "kube", icon: "icon-kube", title: "Monitor Kubernetes", body: "Install the agent on your cluster and get cluster, node and pod views out of the box.", meta: ["~15 min", "kubectl access"],
    doc: { title: "Monitoring Kubernetes with Grafana", body: "Install the Grafana Agent on your cluster and in minutes your metrics, logs and Kubernetes events arrive in Grafana Cloud, with prebuilt dashboards and alerts.", link: "Learn more on Kubernetes with Grafana" } },
  { id: "dashboard", icon: "icon-dash", title: "Build a dashboard", body: "Start from sample data, or connect a data source you already use.", meta: ["~5 min", "no setup needed"],
    doc: { title: "Dashboards", body: "Query, visualize and alert on your metrics no matter where they are stored, then share the dashboard with your team.", link: "Learn more on creating your first dashboard" } },
  { id: "oncall", icon: "icon-oncall", title: "Set up on-call", body: "Create a schedule, add your team and route alerts to whoever is on shift.", meta: ["~10 min", "your teammates’ emails"],
    doc: { title: "On-call, without the toil", body: "Grafana OnCall gives engineers simpler schedules, escalations and alert routing, right next to the dashboards that fired them.", link: "Learn more about on-call management" } },
];
const tour = { id: "explore", doc: { title: "Explore Grafana Cloud", body: "A short guided tour of Grafana Cloud with sample data. Connect your own data whenever you are ready." } };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Welcome to Grafana Cloud · Onboarding prototype</title>
  <meta name="robots" content="noindex" />
  <link rel="preload" href={`${A}/inter.woff2`} as="font" type="font/woff2" crossorigin />
  <style is:global>
    @font-face { font-family: "Inter"; src: url("/prototypes/grafana-onboarding/inter.woff2") format("woff2"); font-weight: 100 900; font-display: swap; }
    :root {
      --bg: #22252b;
      --canvas: #181b1f;
      --text: #ccccdc;
      --text-dim: rgba(204, 204, 220, .65);
      --text-faint: rgba(204, 204, 220, .4);
      --primary: #3d71d9;
      --primary-hover: #4e7fe0;
      --link: #6e9fff;
      --focus: #5794f2;
      --accent: linear-gradient(90deg, #f55f3e, #ff8833);
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; background: var(--bg); color: var(--text); font-family: Inter, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
    [data-screen] { display: none; }
    [data-screen].active { display: grid; animation: in .3s linear; }
    @keyframes in { from { opacity: 0; } }
    a { color: inherit; }
  </style>
</head>
<body>
  <!-- 1. Welcome -->
  <main class="welcome" data-screen="welcome">
    <aside class="panel" aria-hidden="true">
      <img class="logo" src={`${A}/logo.svg`} alt="" width="220" height="23" />
      <span class="shape shape-a"></span>
      <span class="shape shape-b"></span>
      <img class="illus" src={`${A}/illus.svg`} alt="" width="631" height="631" />
      <span class="bar"></span>
    </aside>

    <section class="content">
      <div class="inner">
        <h1>Welcome to Grafana Cloud</h1>
        <ul>
          {benefits.map((b) => (
            <li><img src={`${A}/bullet.svg`} alt="" width="24" height="24" /><span>{b}</span></li>
          ))}
        </ul>
        <a class="button" href="#setup">Get started</a>
      </div>
    </section>
  </main>

  <!-- 2. Setup: pick a way in. The left panel answers "what is this?" for the path you are looking at -->
  <main class="setup" data-screen="setup">
    <aside class="side">
      <img class="side-logo" src={`${A}/logo-stacked.svg`} alt="Grafana" width="46" height="61" />
      <div class="doc" data-doc="intro">
        <h2>What is Grafana Cloud</h2>
        <p>A fully managed observability platform for your applications and infrastructure: one place for all your metrics, logs and traces, wherever the data lives.</p>
        <ul class="doc-links">
          {["Grafana Cloud fundamentals", "Quick starts", "Integrations"].map((l) => (
            <li><a href="#setup">{l}<img src={`${A}/arrow.svg`} alt="" width="20" height="20" /></a></li>
          ))}
        </ul>
      </div>
      {[...paths, tour].map((p) => (
        <div class="doc" data-doc={p.id} hidden>
          <h2>{p.doc.title}</h2>
          <p>{p.doc.body}</p>
          {"link" in p.doc && <a class="doc-link" href="#setup">{p.doc.link}<img src={`${A}/arrow.svg`} alt="" width="20" height="20" /></a>}
        </div>
      ))}
      <img class="plugs" src={`${A}/plugs.svg`} alt="" width="478" height="478" aria-hidden="true" />
    </aside>

    <section class="main">
      <a class="skip" href="#home">Skip to Home<img src={`${A}/skip.svg`} alt="" width="16" height="16" /></a>
      <div class="column">
        <h1>How would you like to begin?</h1>
        <p class="lede">Pick what matters most right now. We’ll walk you through it.</p>
        <div class="cards">
          {paths.map((p) => (
            <a class="card" href={`#${p.id}`} data-path={p.id}>
              <img class="card-icon" src={`${A}/${p.icon}.svg`} alt="" />
              <img class="card-go" src={`${A}/arrow.svg`} alt="" width="20" height="20" />
              <strong>{p.title}</strong>
              <span class="card-body">{p.body}</span>
              <span class="card-meta">{p.meta[0]}<i aria-hidden="true">·</i>{p.meta[1]}</span>
            </a>
          ))}
        </div>
        <p class="tour">
          <img src={`${A}/icon-explore.svg`} alt="" width="28" height="26" />
          Not sure yet? <a href="#explore" data-path="explore">Take a 2-minute tour of Grafana Cloud</a>
        </p>
      </div>
    </section>
  </main>

  <style>
    /* ---------- 1. Welcome ---------- */
    .welcome { grid-template-columns: 1fr 1fr; min-height: 100vh; }

    /* Left: brand panel. Gradient, two soft rotated squares, the isometric illustration, orange base line */
    .panel {
      position: relative; overflow: hidden; min-height: 100vh;
      background: linear-gradient(180deg, rgba(41, 64, 105, .83) 0%, #294069 14%, #2a518e 50%, #2861b8 75%, #2773e0 100%);
    }
    .logo { position: absolute; left: 38px; top: 38px; width: 220px; height: auto; z-index: 2; }
    .shape {
      position: absolute; width: 462px; height: 462px; border-radius: 40px; opacity: .3;
      background: linear-gradient(90deg, #091e3a 0%, #2f80ed 50%, #2d9ee0 100%);
    }
    /* Figma rotates counter-clockwise around the layer's top-left corner */
    .shape { transform-origin: 0 0; }
    .shape-a { left: 38.6%; top: -2.6%; transform: rotate(-55deg); }
    .shape-b { left: 66%; top: 104%; transform: rotate(125.3deg); }
    /* scales with the panel: as wide as the panel allows, never taller than ~75% of it */
    .illus { position: absolute; left: 50%; top: 46%; width: min(92%, 76vh); height: auto; transform: translate(-50%, -50%); z-index: 1; }
    .bar { position: absolute; left: 0; right: 0; bottom: 0; height: 6px; background: var(--accent); }

    /* Right: what Grafana Cloud is, in five lines, then one action */
    .content { display: flex; align-items: center; justify-content: center; padding: 64px 48px; }
    .inner { width: 100%; max-width: 438px; }
    .welcome h1 { margin: 0 0 24px -35px; white-space: nowrap; font-size: 39.4px; line-height: 52.5px; font-weight: 600; letter-spacing: 0; color: var(--text); }
    .welcome ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 36px; }
    .welcome li { display: flex; gap: 16px; align-items: flex-start; font-size: 16px; line-height: 22px; white-space: pre-line; }
    .welcome li img { flex: none; margin-top: 5px; }
    .button {
      display: flex; align-items: center; justify-content: center; height: 44px; margin-top: 24px; border-radius: 2px;
      background: var(--primary); color: #fff; font-size: 14px; line-height: 20px; font-weight: 500; text-decoration: none;
      transition: background .15s ease;
    }
    .button:hover { background: var(--primary-hover); }
    .button:active { background: #3563c2; }
    .button:focus-visible, .skip:focus-visible, .tour a:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

    /* ---------- 2. Setup ---------- */
    .setup { grid-template-columns: 440px 1fr; min-height: 100vh; background: var(--canvas); }

    .side { position: relative; overflow: hidden; background: var(--bg); padding: 40px; display: flex; flex-direction: column; }
    .side > .doc { margin-block: auto; }
    .side-logo { display: block; }
    .plugs { position: absolute; left: -32px; bottom: -28px; width: 478px; height: 478px; pointer-events: none; }
    .doc {
      position: relative; z-index: 1; padding: 24px; border-radius: 4px; animation: in .2s linear;
      background: rgba(61, 113, 217, .1); display: flex; flex-direction: column; gap: 16px;
    }
    .doc[hidden] { display: none; }
    .doc h2 { margin: 0; font-size: 24px; line-height: 32px; font-weight: 500; }
    .doc p { margin: 0; font-size: 14px; line-height: 21px; }
    .doc-links { list-style: none; margin: 4px 0 0; padding: 0 0 0 18px; display: flex; flex-direction: column; gap: 14px; }
    .doc-links li { position: relative; }
    .doc-links li::before { content: ""; position: absolute; left: -14px; top: 9px; width: 4px; height: 4px; border-radius: 50%; background: var(--primary); }
    .doc-links a, .doc-link { display: inline-flex; align-items: center; gap: 6px; color: var(--link); font-size: 14px; line-height: 22px; text-decoration: none; }
    .doc-links a:hover, .doc-link:hover { text-decoration: underline; }
    .doc-links a img, .doc-link img { transition: transform .15s ease; }
    .doc-links a:hover img, .doc-link:hover img { transform: translateX(3px); }

    /* One centred column instead of the fixed 1440 frame */
    .main { position: relative; display: flex; align-items: center; justify-content: center; padding: 96px 56px; }
    .column { width: 100%; max-width: 920px; }
    .skip { position: absolute; right: 36px; top: 36px; display: inline-flex; align-items: center; color: var(--primary); font-weight: 700; font-size: 16px; line-height: 20px; text-decoration: none; }
    .skip img { margin-left: 4px; transition: transform .15s ease; }
    .skip:hover img { transform: translateX(3px); }

    .setup h1 { margin: 0; font-size: 28px; line-height: 36px; font-weight: 500; color: var(--text); }
    .lede { margin: 8px 0 32px; color: var(--text-dim); font-size: 16px; line-height: 22px; }
    .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .card {
      position: relative; display: flex; flex-direction: column; padding: 24px; border-radius: 2px;
      background: var(--bg); color: var(--text); text-decoration: none;
      transition: box-shadow .15s ease;
    }
    .card:hover, .card:focus-visible { outline: 0; box-shadow: inset 0 0 0 2px #5794f2, 0 2px 9px rgba(50, 116, 217, 1); }
    .card-icon { height: 26px; width: auto; align-self: flex-start; margin-bottom: 16px; }
    .card-go { position: absolute; right: 22px; top: 24px; opacity: .45; transition: opacity .15s ease, transform .15s ease; filter: grayscale(1) brightness(1.6); }
    .card:hover .card-go, .card:focus-visible .card-go { opacity: 1; transform: translateX(3px); filter: none; }
    .card strong { font-size: 16px; line-height: 24px; font-weight: 700; }
    .card-body { margin-top: 6px; font-size: 14px; line-height: 20px; }
    .card-meta { margin-top: auto; padding-top: 16px; display: flex; gap: 6px; color: var(--text-dim); font-size: 12px; line-height: 16px; }
    .card-meta i { font-style: normal; }

    .tour { display: flex; align-items: center; gap: 10px; margin: 32px 0 0; color: var(--text-dim); font-size: 14px; line-height: 20px; }
    .tour a { color: var(--link); text-decoration: none; }
    .tour a:hover { text-decoration: underline; }
    .tour img { height: 18px; width: auto; }

    @media (max-width: 900px) {
      .welcome { grid-template-columns: 1fr; }
      .panel { min-height: 0; aspect-ratio: 720 / 560; }
      .illus { width: min(62%, 460px); top: 57%; }
      .content { padding: 40px 16px 56px; }
      .welcome h1 { margin-left: 0; white-space: normal; font-size: 30px; line-height: 40px; }
      .welcome ul { gap: 24px; }

      .setup { grid-template-columns: 1fr; }
      .side { order: 2; padding: 24px 16px 40px; }
      .side-logo, .plugs { display: none; }
      .main { padding: 72px 16px 32px; }
      .skip { top: 26px; right: 16px; }
      .setup h1 { font-size: 24px; line-height: 32px; }
      .cards { grid-template-columns: 1fr; gap: 12px; }
      .tour { flex-wrap: wrap; }
    }
  </style>

  <script>
    // Hash router: #welcome (default), #setup. A step that isn't built yet keeps you where you are.
    const screens = [...document.querySelectorAll<HTMLElement>("[data-screen]")];
    function show() {
      const id = location.hash.slice(1);
      const target = screens.find((s) => s.dataset.screen === id) ?? screens.find((s) => s.classList.contains("active")) ?? screens[0];
      screens.forEach((s) => s.classList.toggle("active", s === target));
      scrollTo(0, 0);
    }
    addEventListener("hashchange", show);
    show();

    // Setup: looking at a path (hover or keyboard focus) brings its docs into the left panel
    const docs = [...document.querySelectorAll<HTMLElement>("[data-doc]")];
    function showDoc(id: string) { docs.forEach((d) => (d.hidden = d.dataset.doc !== id)); }
    document.querySelectorAll<HTMLElement>(".setup [data-path]").forEach((el) => {
      const id = el.dataset.path!;
      el.addEventListener("mouseenter", () => showDoc(id));
      el.addEventListener("focus", () => showDoc(id));
    });
    document.querySelector(".setup .cards")!.addEventListener("mouseleave", () => showDoc("intro"));
  </script>
</body>
</html>
