---
// Grafana Cloud onboarding, rebuilt in code from the original Figma file (2022) and refined.
import ChoiceScreen from "../../../components/onboarding/ChoiceScreen.astro";

const A = "/prototypes/grafana-onboarding";
const benefits = [
  "Enjoy all the benefits of a fully-managed cloud environment- true horizontal scalability, instant upgrades, security patches, and backups",
  "Monitor your entire stack using out-of-the-box integrations\n(Just install an agent, and we'll take care of the rest)",
  "Same Grafana plugins, dashboards and visualizations you know and love, only hosted in Grafana Cloud so it's easier to manage",
  "Visualize and alert on your Kubernetes cluster in minutes",
  "Manage your on-call rotations through simpler workflows and interfaces",
];

const intro = {
  title: "What is Grafana Cloud",
  body: "A fully managed observability platform for your applications and infrastructure: one place for all your metrics, logs and traces, wherever the data lives.",
  links: ["Grafana Cloud fundamentals", "Quick starts", "Integrations"],
};

// Each card says what it takes. Looking at a card (hover or focus) brings its docs into the left panel.
const setup = [
  { id: "mlt", icon: "icon-mlt.svg", to: "mlt", title: "Send metrics, logs and traces", body: "Connect Prometheus, Loki or Tempo, or point an agent you already run at your stack.", meta: ["~10 min", "access to your hosts"],
    doc: { title: "Made for you, managed by us", body: "Grafana Cloud integrates metrics, traces and logs with Grafana. Use Prometheus, Loki and Tempo without installing, maintaining or scaling them yourself.", link: "Learn more on metrics, logs and traces" } },
  { id: "kube", icon: "icon-kube.svg", to: "done-kube", title: "Monitor Kubernetes", body: "Install the agent on your cluster and get cluster, node and pod views out of the box.", meta: ["~15 min", "kubectl access"],
    doc: { title: "Monitoring Kubernetes with Grafana", body: "Install the Grafana Agent on your cluster and in minutes your metrics, logs and Kubernetes events arrive in Grafana Cloud, with prebuilt dashboards and alerts.", link: "Learn more on Kubernetes with Grafana" } },
  { id: "dashboard", icon: "icon-dash.svg", to: "dashboard", title: "Build a dashboard", body: "Start from sample data, or connect a data source you already use.", meta: ["~5 min", "no setup needed"],
    doc: { title: "Dashboards", body: "Query, visualize and alert on your metrics no matter where they are stored, then share the dashboard with your team.", link: "Learn more on creating your first dashboard" } },
  { id: "oncall", icon: "icon-oncall.svg", to: "done-oncall", title: "Set up on-call", body: "Create a schedule, add your team and route alerts to whoever is on shift.", meta: ["~10 min", "your teammates’ emails"],
    doc: { title: "On-call, without the toil", body: "Grafana OnCall gives engineers simpler schedules, escalations and alert routing, right next to the dashboards that fired them.", link: "Learn more about on-call management" } },
];

const sources = [
  { id: "prom", icon: "ds-prom.png", to: "done-prom", title: "Prometheus metrics", body: "Remote-write from your Prometheus, or let the agent scrape for you.", meta: ["metrics", "~10 min"],
    doc: { title: "Prometheus", body: "An open source monitoring system with a multidimensional data model and PromQL. Grafana Cloud stores your Prometheus metrics long term, highly available, with nothing to run.", link: "Learn more about Prometheus" } },
  { id: "loki", icon: "ds-loki.png", to: "done-loki", title: "Logs with Loki", body: "Ship logs from files, containers or systemd. Loki indexes labels, not content, so it stays cheap.", meta: ["logs", "~10 min"],
    doc: { title: "Grafana Loki", body: "A horizontally scalable log aggregation system inspired by Prometheus. It indexes a set of labels for each stream instead of the full text, which keeps it cost effective and easy to operate.", link: "Learn more about Grafana Loki" } },
  { id: "tempo", icon: "ds-tempo.png", to: "done-tempo", title: "Traces with Tempo", body: "Send OpenTelemetry, Jaeger or Zipkin traces and jump from a trace to its logs.", meta: ["traces", "~10 min"],
    doc: { title: "Grafana Tempo", body: "A high-scale distributed tracing backend that only needs object storage, deeply integrated with Grafana, Prometheus and Loki.", link: "Learn more about Grafana Tempo" } },
  { id: "graphite", icon: "ds-graphite.png", to: "done-graphite", title: "Graphite metrics", body: "Point your existing Graphite setup at a hosted, horizontally scalable backend.", meta: ["metrics", "~10 min"],
    doc: { title: "Graphite", body: "Keep your Graphite metrics and lose the maintenance: a replicated, horizontally scalable service with fast queries and access policies for your data.", link: "Learn more about Graphite" } },
];

const dataFor = [
  { id: "agent", icon: "ds-agent.png", to: "done-console", title: "Install the agent", body: "Collect data with ready-made integrations, dashboards and alerts.", meta: ["~10 min", "access to your hosts"],
    doc: { title: "Grafana Agent", body: "The agent runs on your hosts, collects Prometheus-style metrics and logs, and sends them to Grafana Cloud.", link: "Learn more on installing the Grafana Agent" } },
  { id: "external", icon: "ds-external.png", to: "done-console-ext", title: "Connect an external data source", body: "Query data where it already lives, without copying it.", meta: ["~5 min", "the source’s URL and credentials"],
    doc: { title: "Data sources", body: "Grafana connects natively to dozens of databases and services, and community plugins cover many more. Search for yours in Integrations and Connections and follow the steps.", link: "Learn more about installing data sources" } },
];

const explore = [
  { id: "tour", icon: "ex-tour.png", to: "done-home", title: "Take a product tour", body: "An interactive walkthrough of the main features.", meta: ["~2 min", "nothing to install"],
    doc: { title: "Product tour", body: "See where dashboards, Explore, alerting and your data sources live, then try them on sample data." } },
  { id: "demo", icon: "ex-demo.png", to: "done-play", title: "Try a demo environment", body: "A sandbox full of sample data to click around in.", meta: ["~5 min", "nothing to install"],
    doc: { title: "Demo environment", body: "A live Grafana with real-looking data and ready-made dashboards. Change anything, nothing breaks." } },
  { id: "easy", icon: "ex-data.png", to: "connect", title: "Connect data you already have", body: "Start with something close at hand, like your own machine.", meta: ["~5 min"],
    doc: { title: "Your own data, quickly", body: "The fastest way to see your own data in Grafana Cloud is the machine you are on, or a ready-made source like TestData.", link: "Learn more on connecting your data" } },
];

const connect = [
  { id: "linux", icon: "os-linux.png", to: "done-console-paid", title: "Linux server" },
  { id: "windows", icon: "os-windows.png", to: "done-console-paid", title: "Windows" },
  { id: "macos", icon: "os-macos.png", to: "done-console-paid", title: "macOS" },
  { id: "testdata", icon: "os-testdata.png", to: "done-console-paid", title: "TestData DB" },
  { id: "synthetic", icon: "os-synthetic.png", to: "done-console-paid", title: "Synthetic monitoring" },
  { id: "other", icon: "os-other.png", to: "done-console-paid", title: "Something else" },
];

// Where each path lands: the Grafana screen, the Restart button on it, and the onboarding entry in the menu.
const dests = {
  kube: { w: 1440, h: 1000, restart: [1233, 866] },
  oncall: { w: 1723, h: 1000, restart: [1367, 866] },
  prom: { w: 1552, h: 1024, restart: [1367, 866], pulse: [23, 453] },
  loki: { w: 1600, h: 1000, restart: [1367, 866], pulse: [23, 453] },
  tempo: { w: 1600, h: 1000, restart: [1367, 866], pulse: [23, 453] },
  graphite: { w: 1600, h: 1024, restart: [1367, 866], pulse: [23, 453] },
  play: { w: 1655, h: 950, restart: [1492, 866], pulse: [23, 453] },
  console: { w: 1600, h: 1000, restart: [1367, 866], pulse: [23, 453] },
  "console-ext": { w: 1600, h: 1000, restart: [1367, 866], pulse: [21, 453] },
  "console-paid": { w: 1600, h: 1024, restart: [1367, 866], pulse: [23, 453] },
  home: { w: 1440, h: 1000, restart: [1247, 866] },
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Welcome to Grafana Cloud · Onboarding prototype</title>
  <meta name="robots" content="noindex" />
  <link rel="preload" href={`${A}/inter.woff2`} as="font" type="font/woff2" crossorigin />
  <style is:global>
    @font-face { font-family: "Inter"; src: url("/prototypes/grafana-onboarding/inter.woff2") format("woff2"); font-weight: 100 900; font-display: swap; }
    :root {
      --bg: #22252b;
      --canvas: #181b1f;
      --text: #ccccdc;
      --text-dim: rgba(204, 204, 220, .65);
      --text-faint: rgba(204, 204, 220, .4);
      --primary: #3d71d9;
      --primary-hover: #4e7fe0;
      --link: #6e9fff;
      --focus: #5794f2;
      --accent: linear-gradient(90deg, #f55f3e, #ff8833);
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; background: var(--bg); color: var(--text); font-family: Inter, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
    [data-screen] { display: none; }
    [data-screen].active { display: grid; animation: in .3s linear; }
    @keyframes in { from { opacity: 0; } }
    a { color: inherit; }
  </style>
</head>
<body>
  <!-- 1. Welcome -->
  <main class="welcome" data-screen="welcome">
    <aside class="panel" aria-hidden="true">
      <img class="logo" src={`${A}/logo.svg`} alt="" width="220" height="23" />
      <span class="shape shape-a"></span>
      <span class="shape shape-b"></span>
      <img class="illus" src={`${A}/illus.svg`} alt="" width="631" height="631" />
      <span class="bar"></span>
    </aside>

    <section class="content">
      <div class="inner">
        <h1>Welcome to Grafana Cloud</h1>
        <ul>
          {benefits.map((b) => (
            <li><img src={`${A}/bullet.svg`} alt="" width="24" height="24" /><span>{b}</span></li>
          ))}
        </ul>
        <a class="button" href="#setup">Get started</a>
      </div>
    </section>
  </main>

  <!-- 2. Pick a way in, then narrow it down -->
  <ChoiceScreen id="setup" title="How would you like to begin?" lede="Pick what matters most right now. We’ll walk you through it." intro={intro} options={setup}>
    <div slot="docs" class="doc" data-doc="explore" hidden>
      <h2>Explore Grafana Cloud</h2>
      <p>A short guided tour, a demo environment, or your own data in a few minutes. No commitment either way.</p>
    </div>
    <p class="tour">
      <img src={`${A}/icon-explore.svg`} alt="" width="28" height="26" />
      Not sure yet? <a href="#explore" data-path="explore">Take a 2-minute tour of Grafana Cloud</a>
    </p>
  </ChoiceScreen>

  <ChoiceScreen id="mlt" back="setup" title="Which data do you want to send first?" lede="Start with one. You can add the others from Connections at any time." intro={setup[0].doc} options={sources} />
  <ChoiceScreen id="dashboard" back="setup" title="Where does the data for your dashboard live?" lede="Bring it into Grafana Cloud, or leave it where it is and query it." intro={setup[2].doc} options={dataFor} />
  <ChoiceScreen id="explore" back="setup" title="How do you want to explore?" lede="The first two need no data at all." intro={{ title: "Explore Grafana Cloud", body: "Explore Grafana Cloud with a guided tour and become acquainted with some of its features. Connect your data to the cloud to get the most out of it." }} options={explore} columns={3} />
  <ChoiceScreen id="connect" back="explore" title="What do you want to connect?" lede="Start with the machine in front of you, or a ready-made source." intro={explore[2].doc} options={connect} columns={3} compact />

  <!-- 3. Done: a short confirmation, then straight into the product -->
  <main class="done" data-screen="done">
    <div class="done-inner" role="status">
      <svg width="56" height="56" viewBox="0 0 56 56" aria-hidden="true"><circle cx="28" cy="28" r="26" fill="none" stroke="#6ccf8e" stroke-width="3" /><path d="M18 29l7 7 13-15" fill="none" stroke="#6ccf8e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <h1>Awesome work</h1>
      <p>Now let’s start your Grafana journey!</p>
    </div>
  </main>

  <!-- 4. The product, with a way back into onboarding -->
  <main class="dest" data-screen="dest">
    <div class="shot">
      <img class="shot-img" alt="" />
      <span class="pulse" aria-hidden="true"></span>
      <p class="hint" aria-hidden="true">Restart your onboarding here</p>
      <a class="restart" href="#welcome" aria-label="Restart onboarding"></a>
    </div>
  </main>

  <script type="application/json" id="dests" set:html={JSON.stringify(dests)} />

  <style>
    /* ---------- 1. Welcome ---------- */
    .welcome { grid-template-columns: 1fr 1fr; min-height: 100vh; }

    /* Left: brand panel. Gradient, two soft rotated squares, the isometric illustration, orange base line */
    .panel {
      position: relative; overflow: hidden; min-height: 100vh;
      background: linear-gradient(180deg, rgba(41, 64, 105, .83) 0%, #294069 14%, #2a518e 50%, #2861b8 75%, #2773e0 100%);
    }
    .logo { position: absolute; left: 38px; top: 38px; width: 220px; height: auto; z-index: 2; }
    .shape {
      position: absolute; width: 462px; height: 462px; border-radius: 40px; opacity: .3;
      background: linear-gradient(90deg, #091e3a 0%, #2f80ed 50%, #2d9ee0 100%);
    }
    /* Figma rotates counter-clockwise around the layer's top-left corner */
    .shape { transform-origin: 0 0; }
    .shape-a { left: 38.6%; top: -2.6%; transform: rotate(-55deg); }
    .shape-b { left: 66%; top: 104%; transform: rotate(125.3deg); }
    /* scales with the panel: as wide as the panel allows, never taller than ~75% of it */
    .illus { position: absolute; left: 50%; top: 46%; width: min(92%, 76vh); height: auto; transform: translate(-50%, -50%); z-index: 1; }
    .bar { position: absolute; left: 0; right: 0; bottom: 0; height: 6px; background: var(--accent); }

    /* Right: what Grafana Cloud is, in five lines, then one action */
    .content { display: flex; align-items: center; justify-content: center; padding: 64px 48px; }
    .inner { width: 100%; max-width: 438px; }
    .welcome h1 { margin: 0 0 24px -35px; white-space: nowrap; font-size: 39.4px; line-height: 52.5px; font-weight: 600; letter-spacing: 0; color: var(--text); }
    .welcome ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 36px; }
    .welcome li { display: flex; gap: 16px; align-items: flex-start; font-size: 16px; line-height: 22px; white-space: pre-line; }
    .welcome li img { flex: none; margin-top: 5px; }
    .button {
      display: flex; align-items: center; justify-content: center; height: 44px; margin-top: 24px; border-radius: 2px;
      background: var(--primary); color: #fff; font-size: 14px; line-height: 20px; font-weight: 500; text-decoration: none;
      transition: background .15s ease;
    }
    .button:hover { background: var(--primary-hover); }
    .button:active { background: #3563c2; }
    .button:focus-visible, .tour a:focus-visible, .restart:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }

    /* ---------- 2. Tour link under the setup cards ---------- */
    .tour { display: flex; align-items: center; gap: 10px; margin: 32px 0 0; color: var(--text-dim); font-size: 14px; line-height: 20px; }
    .tour a { color: var(--link); text-decoration: none; }
    .tour a:hover { text-decoration: underline; }
    .tour img { height: 18px; width: auto; }

    /* ---------- 3. Done ---------- */
    .done { min-height: 100vh; place-items: center; background: var(--canvas); }
    .done-inner { display: flex; flex-direction: column; align-items: center; text-align: center; }
    .done svg circle { stroke-dasharray: 164; stroke-dashoffset: 164; animation: draw .5s ease-out forwards; }
    .done svg path { stroke-dasharray: 30; stroke-dashoffset: 30; animation: draw .3s .4s ease-out forwards; }
    @keyframes draw { to { stroke-dashoffset: 0; } }
    .done h1 { margin: 20px 0 6px; font-size: 24px; line-height: 32px; font-weight: 500; }
    .done p { margin: 0; color: var(--text-dim); font-size: 14px; line-height: 20px; }

    /* ---------- 4. Destination ---------- */
    .dest { min-height: 100vh; background: #111217; align-content: start; }
    .shot { position: relative; width: 100%; }
    .shot-img { display: block; width: 100%; height: auto; }
    .restart { position: absolute; width: calc(109 / var(--w) * 100%); aspect-ratio: 109 / 32; border-radius: 2px; }
    .restart:hover { box-shadow: 0 0 0 2px rgba(255, 255, 255, .5); }
    .pulse { position: absolute; width: calc(25 / var(--w) * 100%); aspect-ratio: 1; border-radius: 50%; pointer-events: none; }
    .pulse::after { content: ""; position: absolute; inset: 0; border-radius: 50%; box-shadow: 0 0 0 0 rgba(108, 207, 142, .7); animation: pulse 1.8s ease-out infinite; }
    @keyframes pulse { to { box-shadow: 0 0 0 14px rgba(108, 207, 142, 0); } }
    .hint {
      position: absolute; margin: 0; padding: 8px 12px; border-radius: 4px; white-space: nowrap;
      background: #2c3235; color: var(--text); font-size: 13px; line-height: 18px; box-shadow: 0 4px 16px rgba(0, 0, 0, .45);
      opacity: 0; animation: hint .5s 1s ease-out forwards, bob 2.4s 1.5s ease-in-out infinite;
    }
    .hint::before { content: ""; position: absolute; left: -6px; top: 50%; margin-top: -6px; border: 6px solid transparent; border-left: 0; border-right-color: #2c3235; }
    @keyframes hint { from { opacity: 0; translate: 8px 0; } to { opacity: 1; translate: 0 0; } }
    @keyframes bob { 50% { translate: 4px 0; } }
    .shot[data-pulse="none"] .pulse, .shot[data-pulse="none"] .hint { display: none; }

    @media (max-width: 900px) {
      .welcome { grid-template-columns: 1fr; }
      .panel { min-height: 0; aspect-ratio: 720 / 560; }
      .illus { width: min(62%, 460px); top: 57%; }
      .content { padding: 40px 16px 56px; }
      .welcome h1 { margin-left: 0; white-space: normal; font-size: 30px; line-height: 40px; }
      .welcome ul { gap: 24px; }
      .tour { flex-wrap: wrap; }
      .hint { display: none; }
    }
  </style>

  <script>
    type Dest = { w: number; h: number; restart: [number, number]; pulse?: [number, number] };
    const dests: Record<string, Dest> = JSON.parse(document.getElementById("dests")!.textContent!);
    const screens = [...document.querySelectorAll<HTMLElement>("[data-screen]")];
    const shot = document.querySelector<HTMLElement>(".shot")!;
    let timer = 0;

    // Hash router. #done-x shows the confirmation, then lands on #dest-x. Unknown steps keep you where you are.
    function show() {
      clearTimeout(timer);
      const hash = location.hash.slice(1);
      const [, kind, dest] = hash.match(/^(done|dest)-(.+)$/) ?? [];
      const known = Boolean(kind && dests[dest]);
      if (known && kind === "done") timer = window.setTimeout(() => location.replace(`#dest-${dest}`), 1700);
      if (known && kind === "dest") land(dest);
      const id = known ? kind : hash;
      const target = screens.find((s) => s.dataset.screen === id) ?? screens.find((s) => s.classList.contains("active")) ?? screens[0];
      screens.forEach((s) => s.classList.toggle("active", s === target));
      scrollTo(0, 0);
    }

    // Place the Restart hotspot and the onboarding pointer on the product screenshot, in percentages so it scales.
    function land(id: string) {
      const d = dests[id];
      const pct = (v: number, of: number) => `${(v / of) * 100}%`;
      shot.style.setProperty("--w", String(d.w));
      shot.querySelector<HTMLImageElement>(".shot-img")!.src = `/prototypes/grafana-onboarding/dest/${id}.webp`;
      Object.assign(shot.querySelector<HTMLElement>(".restart")!.style, { left: pct(d.restart[0], d.w), top: pct(d.restart[1], d.h) });
      shot.dataset.pulse = d.pulse ? "on" : "none";
      if (d.pulse) {
        const hint = shot.querySelector<HTMLElement>(".hint")!;
        Object.assign(shot.querySelector<HTMLElement>(".pulse")!.style, { left: pct(d.pulse[0], d.w), top: pct(d.pulse[1], d.h) });
        Object.assign(hint.style, { left: pct(d.pulse[0] + 44, d.w), top: `calc(${pct(d.pulse[1] + 12.5, d.h)} - 17px)` });
        // replay the hint on every landing
        hint.style.animation = "none";
        void hint.offsetWidth;
        hint.style.animation = "";
      }
    }
    addEventListener("hashchange", show);
    show();

    // Looking at a path (hover or keyboard focus) brings its docs into that screen's left panel
    for (const screen of document.querySelectorAll<HTMLElement>(".setup")) {
      const docs = [...screen.querySelectorAll<HTMLElement>("[data-doc]")];
      const showDoc = (id: string) => {
        const target = docs.some((d) => d.dataset.doc === id) ? id : "intro";
        docs.forEach((d) => (d.hidden = d.dataset.doc !== target));
      };
      screen.querySelectorAll<HTMLElement>("[data-path]").forEach((el) => {
        el.addEventListener("mouseenter", () => showDoc(el.dataset.path!));
        el.addEventListener("focus", () => showDoc(el.dataset.path!));
      });
      screen.querySelector(".cards")?.addEventListener("mouseleave", () => showDoc("intro"));
    }
  </script>
</body>
</html>
