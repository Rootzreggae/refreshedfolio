    .l-ic { flex: none; display: grid; place-items: center; width: 76px; height: 76px; border-radius: 50%; background: #3a3d44; } .l-ic img { width: 54px; height: 54px; object-fit: contain; }
    .l-props b { display: block; max-width: 18ch; font-size: 19px; line-height: 1.2; font-weight: 500; color: #fff; } .l-props em { font-style: normal; color: #6e9fff; }
    .l-props p { margin: 8px 0 0; color: var(--text); font-size: 14px; } .l-props p a { color: #6e9fff; text-decoration: none; }
    /* the slab and the object keep their designed proportions and stay inside the band */
    .l-art { position: relative; min-height: 440px; display: grid; place-items: center; }
    .l-art .base { position: absolute; right: -36px; bottom: -56px; width: min(92%, 560px); }
    .l-art .obj { position: relative; width: min(42%, 230px); translate: -6% -8%; }
    .l-start { padding: 40px 36px 0; } .l-start h2 { margin: 0 0 16px; font-size: 19px; font-weight: 500; color: #fff; }
    .l-start ol { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 0 0 24px; padding: 0; list-style: none; }
    .l-start li { display: flex; gap: 14px; padding: 18px 20px; border: 1px solid var(--line); border-radius: 2px; } .l-start li > span { flex: none; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--blue); color: #fff; font-size: 14px; }
    .l-start b { display: block; color: #fff; font-weight: 500; } .l-start small { color: var(--dim); font-size: 14px; }
    @media (max-width: 1100px) { .l-hero, .l-cols { grid-template-columns: 1fr; } .l-props { border: 0; padding: 0; } .l-art { min-height: 300px; } .l-start ol { grid-template-columns: 1fr; } }
    /* ---------- Setup, as designed: a centred card with the steps in a rail, no app sidebar ---------- */
    .focus .side { display: none; } .focus .app { grid-template-columns: 1fr; }
    .focus .page[data-screen="setup"] { display: grid; place-items: center; min-height: calc(100vh - 56px); padding: 48px 24px; }
    .wcard { display: grid; grid-template-columns: 300px minmax(0, 1fr); width: min(1240px, 100%); height: min(760px, calc(100vh - 140px)); min-height: 640px; box-shadow: 0 8px 30px rgba(0, 0, 0, .35); }
    .wrail { padding: 40px 36px; background: #16181d; }
    .wlogo { display: flex; align-items: center; gap: 12px; margin: 0 0 90px; font-size: 18px; color: #fff; }
    .vsteps { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 34px; }
    .vsteps > li { display: grid; grid-template-columns: 40px 1fr; align-items: center; gap: 0 16px; font-size: 17px; letter-spacing: .02em; text-transform: uppercase; color: var(--text); }
    .vsteps > li > span { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; border: 1px solid rgba(204, 204, 220, .2); background: #111217; font-size: 14px; color: #fff; text-transform: none; }
    .vsteps > li.on { color: #6e9fff; } .vsteps > li.on > span { border-color: transparent; background: #3d71d9; }
    .vsteps > li.done > span { border-color: transparent; background: var(--good); color: #0b0c0e; }
    .vsteps ul { grid-column: 2; margin: 18px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 16px; font-size: 15px; letter-spacing: 0; text-transform: none; color: var(--dim); }
    .vsteps ul .or { padding-top: 16px; border-top: 1px solid var(--line); }
    .vsteps > li.on ul { color: var(--text); }
    .wmain { position: relative; display: flex; flex-direction: column; padding: 40px 44px 36px; background: var(--raise); overflow: auto; }
    .trouble-top { position: absolute; right: 44px; top: 36px; margin: 0; color: var(--dim); font-size: 14px; }
    .wmain .wiz { flex: 1; display: flex; flex-direction: column; max-width: none; padding: 0; border: 0; background: none; }
    .wmain .wiz[hidden] { display: none; }
    .wtitle { margin: 28px 0 20px; font-size: 24px; font-weight: 500; color: #fff; }
    .windent { padding-left: 20px; }
    .lbl2 { display: block; margin: 0 0 4px; font-size: 17px; color: #fff; } .help2 { margin: 0 0 14px; color: var(--dim); font-size: 14px; }
    .windent .field { margin-bottom: 24px; } .windent .inline .field { margin: 0; }
    .addbtn { min-width: 140px; justify-content: center; }
    .cors { margin-top: 16px; } .cors summary { color: #6e9fff; cursor: pointer; }
    .wmain .wiz-foot { margin-top: auto; padding-top: 28px; } .wmain .wiz-foot .btn { min-width: 140px; justify-content: center; }
    @media (max-width: 900px) { .wcard { grid-template-columns: 1fr; } .wlogo { margin-bottom: 24px; } .vsteps { flex-direction: row; gap: 16px; } .vsteps ul { display: none; } }
    /* setup steps 2 and 3, as designed */
    .vsteps ul li.on { color: #6e9fff; }
    .vsteps > li.done > span { font-size: 0; } .vsteps > li.done > span::before { content: "✓"; font-size: 15px; }
    .vsteps > li.done { color: #6e9fff; } .vsteps > li.done > span { background: transparent; border-color: rgba(204, 204, 220, .3); color: #fff; }
    .okbox { display: flex; gap: 14px; align-items: center; margin-bottom: 24px; padding: 14px 18px; border: 1px solid rgba(60, 195, 154, .55); border-radius: 2px; background: rgba(60, 195, 154, .12); }
    .okbox > span { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--good); color: #0b0c0e; font-weight: 700; } .okbox div { display: flex; flex-direction: column; } .okbox b { color: #fff; font-weight: 500; } .okbox small { color: var(--text); font-size: 14px; }
    .srcs { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 26px; }
    .src { display: flex; flex-direction: column; gap: 8px; padding: 18px; border: 1px solid var(--line); border-radius: 2px; background: #1c1f24; } .src.on { border-color: #5794f2; }
    .src b { display: flex; align-items: center; gap: 10px; color: #fff; font-weight: 500; font-size: 16px; } .src span { color: var(--text); min-height: 44px; } .src .sel { justify-content: center; border-radius: 999px; margin-top: auto; }
    .imp { margin-top: 4px; } .drop { display: block; padding: 26px; border: 1px dashed rgba(204, 204, 220, .25); border-radius: 2px; text-align: center; color: var(--dim); cursor: pointer; } .drop:hover { border-color: #5794f2; color: var(--text); }
    .fws { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; margin-bottom: 24px; }
    .fw { height: 38px; border: 0; border-radius: 2px; background: #2c3035; color: var(--text); cursor: pointer; } .fw.on { background: var(--blue); color: #fff; } .fw:not(.on):hover { background: #34383e; }
    .codepanel { padding: 16px 18px 18px; border-radius: 2px; background: #1a1d21; }
    .pms { display: flex; gap: 4px; margin-bottom: 14px; } .pms button { padding: 8px 18px; border: 0; border-radius: 2px; background: none; color: var(--dim); cursor: pointer; } .pms button.on { background: #2c3035; color: #fff; }
    .codebox.flat { margin: 0 0 16px; border: 0; background: none; } .codebox.flat pre { padding: 8px 40px 8px 4px; }
    .copy.icon { width: 32px; padding: 0; display: grid; place-items: center; }
    .bigcheck { display: grid; place-items: center; width: 64px; height: 64px; margin: 0 auto 22px; border-radius: 50%; background: var(--good); color: #0b0c0e; font-size: 32px; font-weight: 700; }
    .sumpanel { padding: 20px 22px; border-radius: 2px; background: #1a1d21; } .sumpanel b { display: block; margin-bottom: 12px; color: #fff; font-weight: 500; font-size: 17px; }
    .sumpanel dl { display: grid; grid-template-columns: 220px 1fr; gap: 10px 16px; margin: 0; } .sumpanel dt { color: var(--text); } .sumpanel dd { margin: 0; color: #fff; overflow-wrap: anywhere; }
    .ns { margin-top: 26px; } .nextcard { display: flex; flex-direction: column; gap: 4px; width: 100%; padding: 18px 22px; border: 1px solid transparent; border-radius: 2px; background: #1a1d21; text-align: left; cursor: pointer; } .nextcard:hover { border-color: #5794f2; } .nextcard b { color: #fff; font-weight: 500; } .nextcard span { color: var(--dim); }
    /* app space: the card as designed */
    .apps { grid-template-columns: repeat(auto-fill, minmax(340px, 370px)); }
    .appcard { padding: 0; gap: 0; overflow: hidden; border: 1px solid rgba(204, 204, 220, .16); background: #22252b; }
    .appcard:hover { box-shadow: none; border-color: rgba(87, 148, 242, .6); }
