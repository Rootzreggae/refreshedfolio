    .app-ic { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 2px; background: #2c3035; }
    .app-acts { display: flex; gap: 8px; } .app-acts button { display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid var(--line); border-radius: 50%; background: #1c1f24; color: var(--dim); cursor: pointer; }
    .app-acts button:hover { color: #fff; border-color: rgba(204, 204, 220, .35); } .app-acts button.on { color: #fade2a; }
    .app-name { display: block; padding: 14px 20px 16px; font-size: 18px; letter-spacing: .02em; color: #fff; text-decoration: none; }
    .app-body { display: block; padding: 12px 20px 20px; background: #1c1f24; text-decoration: none; border-top: 1px solid rgba(204, 204, 220, .08); }
    .stack { display: flex; align-items: flex-end; gap: 10px; height: 64px; padding: 6px 10px 0; border: 1px solid var(--line); border-bottom: 0; border-radius: 2px 2px 0 0; background: #111217; }
    .stack span { flex: 1; display: flex; flex-direction: column-reverse; height: 100%; } .stack i { display: block; } .stack .l { background: #6e9fff; } .stack .e { background: #ff5286; }
    .stack-x { display: flex; justify-content: space-between; margin: 0 0 14px; padding: 2px 10px 6px; list-style: none; border: 1px solid var(--line); border-top: 0; border-radius: 0 0 2px 2px; background: #111217; font-size: 10px; color: var(--dim); }
    .tiles2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; } .tiles2 div { display: flex; flex-direction: column; align-items: center; padding: 10px 0 6px; border: 1px solid var(--line); background: #111217; }
    .tiles2 span { font-size: 14px; } .tiles2 b { font-size: 54px; line-height: 1.1; font-weight: 400; } .tiles2 .e { color: #ff5286; } .tiles2 .l { color: #6e9fff; }
