---
// Grafana Frontend Observability (RUM), rebuilt in code from Nilson's original design file: the landing page, the
// three-step setup (create the app, connect it, finish), the app list and an app's overview with web vitals,
// errors and sessions. Charts are drawn from generated sample data.
const A = "/prototypes/grafana-apm"; // shared shell assets: font and logo

function rng(seed: number) { let s = seed; return () => ((s = (s * 16807) % 2147483647) / 2147483647); }
function series(seed: number, n: number, base: number, spread: number) {
  const r = rng(seed); let v = base; const out: number[] = [];
  for (let i = 0; i < n; i++) { v = Math.max(0, v + (r() - 0.5) * spread); out.push(v); }
  return out;
}
const path = (vals: number[], w: number, h: number, max: number) =>
  "M" + vals.map((v, i) => `${((i / (vals.length - 1)) * w).toFixed(1)},${(h - (Math.min(v, max) / max) * h).toFixed(1)}`).join("L");
const loads = series(5, 60, 5, 3), errs = series(9, 60, 1.5, 1.4), onload = series(13, 60, 4, 1.6);
const onloadMax = Math.ceil(Math.max(...onload)) + 1;
const W = 600, H = 150;

const vitals = [
  { id: "ttfb", name: "Time to First Byte", v: "826", unit: "ms", good: 62, ni: 25, poor: 13, state: "needs" },
  { id: "fcp", name: "First Contentful Paint", v: "0.21", unit: "s", good: 91, ni: 6, poor: 3, state: "good" },
  { id: "lcp", name: "Largest Contentful Paint", v: "2.1", unit: "s", good: 78, ni: 15, poor: 7, state: "good" },
  { id: "cls", name: "Cumulative Layout Shift", v: "0.23", unit: "", good: 54, ni: 21, poor: 25, state: "poor" },
  { id: "fid", name: "First Input Delay", v: "48", unit: "ms", good: 94, ni: 4, poor: 2, state: "good" },
  { id: "inp", name: "Interaction to Next Paint", v: "234", unit: "ms", good: 70, ni: 22, poor: 8, state: "needs" },
];
const sessions = [
  ["a91f…2c", "Chrome 129 · macOS", "Lisbon", "6 pages", "1 error", "4m 12s"],
  ["77be…e0", "Safari 18 · iOS", "Berlin", "3 pages", "", "1m 48s"],
  ["c3d0…91", "Firefox 131 · Windows", "Madrid", "9 pages", "2 errors", "7m 03s"],
  ["0e5a…7b", "Chrome 129 · Android", "Porto", "2 pages", "", "0m 52s"],
];
const side = [
  ["Kubernetes", ["Nodes", "Dashboards", "Alerts"]],
  ["Application", ["Services", "Service map"]],
  ["Frontend", ["Applications", "Error awareness", "Starred"]],
  ["Synthetics", ["Checks", "Probes"]],
] as const;
const frameworks = ["React", "Angular", "Vue", "JavaScript", "Other"];
const steps = ["Create app", "Connect it", "Finish"];
// Overview data, after the original design
const smooth = (vals: number[], w: number, h: number, max: number) => {
  const pts = vals.map((v, i) => [(i / (vals.length - 1)) * w, h - (Math.min(v, max) / max) * h]);
  let d = `M${pts[0][0]},${pts[0][1]}`;
  for (let i = 1; i < pts.length; i++) { const [x0, y0] = pts[i - 1], [x1, y1] = pts[i]; const cx = (x0 + x1) / 2; d += ` C${cx},${y0} ${cx},${y1} ${x1},${y1}`; }
  return d;
};
const area = (d: string, w: number, h: number) => `${d} L${w},${h} L0,${h} Z`;
const ovBars = series(31, 24, 5, 4).map((l, i) => [Math.max(0.6, Math.min(9, l)), Math.max(0, Math.min(6, series(37, 24, 3, 3)[i]))]);
const onloadSmooth = [7.6, 8.4, 9.6, 7.2, 9.4, 6.8, 4.6, 3.8, 3.3, 5.2, 8.6, 6.1, 4.2, 5.4, 4.8, 5.0, 3.6, 0];
const spk = (seed: number, kind: "wave" | "noise" | "ramp" | "bump") => {
  const r = rng(seed); const n = 28; const v: number[] = [];
  for (let i = 0; i < n; i++) {
    const t = i / (n - 1);
    v.push(kind === "wave" ? 5 + 4 * Math.sin(t * 9 + r()) : kind === "noise" ? 5 + (r() - 0.5) * (i > 10 && i < 20 ? 9 : 2) : kind === "ramp" ? 1 + 8 / (1 + Math.exp(-(t - 0.5) * 10)) : 1 + 8 * Math.exp(-((t - 0.5) ** 2) / 0.03));
  }
  return smooth(v, 200, 32, 10);
};
const kinds = ["wave", "noise", "ramp", "bump"] as const;
const tone = ["#e0226e", "#3cc39a", "#ff9830"];
const perf = [
  ["/", "826ms", "0.21s", "1.9s", "234ms", "2347ms", "18ms"], ["product_detail", "740ms", "0.22s", "2.1s", "200ms", "743ms", "4ms"],
  ["/products/1/detail", "630ms", "1.02s", "4.6s", "100ms", "200ms", "120ms"], ["product_detail", "530ms", "3s", "1.2s", "0.94ms", "1114ms", "4ms"],
  ["/products/1/detail", "412ms", "0.98s", "12.7s", "100ms", "123ms", "4ms"], ["product_detail", "90ms", "2s", "6.0s", "800ms", "355ms", "4ms"],
];
const pageIds = perf.map((r) => r[0]);
const msets = [
  { id: "perf", tab: "Performance Metrics", title: "Page Performance", cols: ["TTFB", "FCP", "LCP", "CLS", "INP"], last: "Load Time", rows: perf },
  { id: "biz", tab: "Business Metrics", title: "Behavioural Metrics", cols: ["Bounce Rate", "Avg Session Duration", "Conversion Rate"], last: "",
    rows: [["89%", "2m 41s", "3.4%"], ["75%", "3m 12s", "5.1%"], ["40%", "4m 05s", "8.2%"], ["43%", "1m 58s", "4.7%"], ["45%", "2m 20s", "6.0%"], ["12%", "5m 33s", "11.9%"]].map((v, i) => [pageIds[i], ...v]) },
  { id: "tech", tab: "Technical Metrics", title: "Technical Metrics", cols: ["JS Errors", "Failed Requests", "Long Tasks"], last: "Page Weight",
    rows: [["12", "3", "41", "2.4 MB"], ["4", "0", "18", "1.1 MB"], ["9", "6", "33", "3.8 MB"], ["2", "1", "12", "1.2 MB"], ["7", "2", "27", "3.6 MB"], ["0", "0", "6", "0.9 MB"]].map((v, i) => [pageIds[i], ...v]) },
];
const jsErrors = [
  ["TypeError", "Failed to fetch", 2, 7, "wave"], ["Error", "{}", 3, 2, "bump"], ["SyntaxError", "Unexpected end of JSON input", 27, 26, "noise"],
  ["Error", "Script error", 1, 4, "bump"], ["Error", "Request failed with status code of 401", 24, 19, "noise"], ["Error", "Request failed with status code of 403", 4, 5, "wave"],
  ["Error", "ResizeObserver loop completed with undelivered notifications", 5, 8, "ramp"], ["Error", "Cannot read properties of undefined reading ('pathname')", 2, 5, "wave"],
  ["Error", "JSON.parse: unexpected end of data at line 1 column 1 of JSON data", 2, 6, "bump"], ["Error", "Non-Error exception captured with keys: message", 2, 11, "wave"],
  ["Error", "Non-Error exception captured with keys: refID, message, status, traceID", 2, 20, "bump"], ["Error", "NetworkError when attempting to fetch resource.", 2, 23, "wave"],
] as const;
const spkDown = (i: number) => smooth(Array.from({ length: 28 }, (_, k) => 9 - 8 / (1 + Math.exp(-(k / 27 - 0.5) * 10))), 200, 32, 10);
const errSpk = jsErrors.map(([, , , , k], i) => (k === "ramp" ? spkDown(i) : spk(200 + (i % 3), k as (typeof kinds)[number])));
const errCol = jsErrors.map(([, , , , k]) => (k === "noise" ? "#e0226e" : k === "ramp" ? "#ff9830" : "#3cc39a"));
// Flyout content, after the original Flyout frames
const fyLines = [["FCP", "#5794f2"], ["TTFB", "#e0b400"], ["LCP", "#f2495c"], ["CLS", "#ff9830"], ["FID", "#73bf69"], ["INP", "#b877d9"]].map(([n, c], i) => ({ n, c, d: smooth(series(70 + i, 14, 2 + i * 1.2, 4).map((v) => Math.max(0.3, Math.min(9.7, v))), 600, 200, 10) }));
const waterfall = [["Redirect", "4.49ms", "1%", "#ff9830", 2], ["App Cache", "3.32ms", "1%", "#5794f2", 2], ["DNS", "152.15ms", "38%", "#b877d9", 37], ["TCP", "235.83ms", "60%", "#56a64b", 54], ["Request", "0.20ms", "<1%", "#e02f44", 5]] as const;
const fyData = {
  errors: jsErrors.map(([t, m, c, u]) => ({ t, m, c, u })),
  pages: perf.map((r, i) => ({ id: r[0], ttfb: r[1], fcp: r[2], lcp: r[3], inp: r[5], load: r[6], cls: [0.02, 0.08, 0.31, 0.12, 0.04, 0.27][i] })),
  pageIds: perf.map((r) => r[0]),
};
const views = [["/", "2347ms", 826, "18ms"], ["product_detail", "743ms", 740, "4ms"], ["/products/1/detail", "200ms", 630, "120ms"], ["product_detail", "1114ms", 530, "4ms"], ["/products/1/detail", "123ms", 412, "4ms"], ["product_detail", "355ms", 90, "4ms"]];
const p75 = [
  { title: "Page Load, p75", ticks: ["25 s", "20 s", "15 s", "10 s", "5 s", "0 ms"], color: "#f2b736", legend: [["TTFB", "#73bf69"], ["FCP", "#f2b736"], ["LCP", "#b877d9"]], d: series(51, 90, 6, 4).map((v, i) => v + (i > 45 && i < 80 ? 10 + Math.sin(i / 6) * 4 : 0)), max: 26 },
  { title: "Cumulative Layout Shift, p75", ticks: ["0.5 ms", "0.4 ms", "0.3 ms", "0.2 ms", "0.1 ms", "0 ms"], color: "#73bf69", legend: [["CLS", "#73bf69"]], d: series(53, 90, 0.2, 0.25).map((v, i) => (i < 15 ? 0 : v * (0.2 + i / 90))), max: 0.55 },
  { title: "First Input Delay, p75", ticks: ["10 ms", "8 ms", "6 ms", "4 ms", "2 ms", "0 ms"], color: "#73bf69", legend: [["FID", "#73bf69"]], d: series(57, 90, 2.5, 1.5).map((v, i) => v + (i > 50 ? 2 : 0)), max: 10.5 },
];
const bars = [[6, 4], [4, 7], [2, 1.2], [5, 4], [9, 0], [3, 2], [5, 4]]; // page loads, errors per 5 min
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Frontend Observability · Prototype</title>
  <meta name="robots" content="noindex" />
  <link rel="preload" href={`${A}/inter.woff2`} as="font" type="font/woff2" crossorigin />
  <style is:global>
    @font-face { font-family: "Inter"; src: url("/prototypes/grafana-apm/inter.woff2") format("woff2"); font-weight: 100 900; font-display: swap; }
    :root { --page: #111217; --panel: #181b1f; --raise: #22252b; --line: rgba(204, 204, 220, .12); --text: #ccccdc; --dim: rgba(204, 204, 220, .65); --blue: #3d71d9; --link: #6e9fff; --good: #3cc39a; --ni: #ff9830; --poor: #ff5286; }
    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; background: var(--page); color: var(--text); font: 15px/1.5 Inter, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
    button { font: inherit; color: inherit; } a { color: inherit; }
    [data-screen] { display: none; } [data-screen].active { display: block; animation: in .25s ease; }
    @keyframes in { from { opacity: 0; } }
  </style>
</head>
<body>
  <header class="topbar">
    <img src={`${A}/grafana.svg`} alt="Grafana" width="26" height="26" />
    <nav class="crumbs" data-crumbs aria-label="Breadcrumb"></nav>
    <label class="search"><svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.8" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="m10.6 10.6 3.4 3.4" stroke="currentColor" stroke-width="1.4"/></svg><input placeholder="Search or jump to" aria-label="Search" /><kbd>⌘K</kbd></label>
    <span class="avatar" aria-hidden="true"></span>
  </header>

  <div class="app">
    <aside class="side">
      <p class="side-title"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M1 9h3l2-6 4 10 2-4h3" fill="none" stroke="#ff8833" stroke-width="1.6"/></svg>Observability</p>
      {side.map(([g, items]) => (
        <div class="side-group"><p>{g}</p>{items.map((it) => <a href={it === "Applications" ? "#apps" : it === "Error awareness" ? "#app-errors" : "#landing"} data-side={it}>{it}</a>)}</div>
      ))}
      <div class="side-foot"><a href="#landing">Documentation</a><a href="#landing">Give feedback</a></div>
    </aside>

    <div class="content">
      <!-- 1. Landing, as designed in the original file: hero with the product, then three promises beside the illustration -->
      <main class="screen page landing" data-screen="landing" data-crumb="Home/Frontend" data-side-on="Applications">
        <div class="l-top"><p class="l-app"><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3h12M2 8h9M2 13h6" stroke="#ff8833" stroke-width="2" stroke-linecap="round"/></svg>Frontend Observability</p><span class="ds"><i aria-hidden="true"></i>Prometheus<svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></span></div>
        <section class="l-hero">
          <div>
            <h1 class="l-title">Empower your decisions with real user monitoring insights</h1>
            <p class="l-lede">Gain precise, end-to-end user insight. Empower your team, optimise products, and stay ahead of the competition.</p>
            <a class="btn primary big" href="#setup"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M1 8s2.6-5 7-5 7 5 7 5-2.6 5-7 5-7-5-7-5Z" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="8" r="2.2" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>Start observing</a>
          </div>
          <figure class="l-screen"><img src="/prototypes/grafana-rum/fe-screen.webp" alt="An application's Frontend Observability overview" /></figure>
        </section>
        <section class="l-power">
          <h2>Experience the power of our solutions<br />and see what they can achieve for you.</h2>
          <div class="l-cols">
            <ul class="l-props">
              {[["ic-stack", "Monitor", "end user experience", "Track and report essential *web vitals* metrics to understand and improve user experience."], ["ic-faro", "Track", "errors with complete stack traces", "Automatically group similar errors, assess their importance, and pinpoint the specific lines of code causing each error."], ["ic-e2e", "See", "the whole user journey, from start to finish.", "Link frontend sessions with request traces for a complete view of the entire stack."]].map(([ic, a, rest, d]) => (
                <li><span class="l-ic"><img src={`/prototypes/grafana-rum/${ic}.svg`} alt="" /></span><div><b><em>{a}</em> {rest}</b><p>{d.split("*").map((part, k) => (k === 1 ? <a href="#app">{part}</a> : part))}</p></div></li>
              ))}
            </ul>
            <div class="l-art" aria-hidden="true"><img class="base" src="/prototypes/grafana-rum/iso-base.svg" alt="" /><img class="obj" src="/prototypes/grafana-rum/web-performance.svg" alt="" /></div>
          </div>
        </section>
        <section class="l-start">
          <h2>How to get started</h2>
          <ol>
            {[["Register your application", "Set your app’s name and the domains that send data."], ["Integrate the Faro Web SDK", "One package and a few lines in your entry file."], ["End-to-end user insight", "Connect frontend sessions to request traces for the full picture."]].map(([t, d], i) => (
              <li><span>{i + 1}</span><div><b>{t}</b><small>{d}</small></div></li>
            ))}
          </ol>
          <p class="billing">Logs and traces for Frontend Observability are stored in your Grafana Cloud stack, at regular Grafana Cloud pricing. <a class="lnk" href="#landing">Grafana Cloud pricing</a> · <a class="lnk" href="#landing">Blog post</a></p>
        </section>
      </main>

      <!-- 2. Setup: three steps in one place -->
      <main class="screen page" data-screen="setup" data-crumb="Home/Frontend/New application" data-side-on="Applications">
        <div class="wcard">
        <aside class="wrail">
          <p class="wlogo"><img src="/prototypes/grafana-rum/faro.svg" alt="" width="22" height="29" />Frontend Observability</p>
          <ol class="vsteps">
            <li data-st="0"><span>1</span>Create app</li>
            <li data-st="1"><span>2</span>Configure app
              <ul><li data-sub="1">Connect source</li><li data-sub="2">Set endpoints</li><li class="or" data-sub="import">Or import config</li></ul>
            </li>
            <li data-st="2"><span>3</span>Finish</li>
          </ol>
        </aside>
        <div class="wmain">
        <p class="trouble-top">Having trouble? Get <a class="lnk" href="#setup">Help</a></p>

        <section class="wiz" data-wiz="0">
          <h2 class="wtitle">Setup App</h2>
          <div class="windent">
            <label class="lbl2" for="appname">App Name</label>
            <p class="help2">A unique name to identify and differentiate this frontend observability application from your others.</p>
            <input id="appname" class="field" value="acme-monitoring" data-appname />
            <label class="lbl2" for="dom">Domain</label>
            <p class="help2">Allowed CORS origins for app access. See docs for details.</p>
            <div class="inline"><input id="dom" class="field" placeholder="*.acme.com" data-dom /><button class="btn big addbtn" data-add-dom>Add</button></div>
            <p class="chips" data-chips><span>*.acme-monitoring.com<button aria-label="Remove">×</button></span></p>
            <details class="cors"><summary>Advanced CORS settings</summary><p class="help2">Allow credentials, exposed headers and max age, if your app needs them.</p></details>
          </div>
          <div class="wiz-foot"><a class="btn big" href="#landing">Cancel</a><button class="btn primary big" data-next="1" data-create>Next</button></div>
        </section>

        <section class="wiz" data-wiz="1" hidden>
          <h2 class="wtitle">Configure Your Application</h2>
          <div class="windent">
            <div class="okbox"><span aria-hidden="true">✓</span><div><b>App created successfully!</b><small>Now let’s set up frontend observability for <span data-appname-out>acme-monitoring</span>.</small></div></div>
            <p class="lbl2">Connect Your Application</p>
            <p class="help2">Choose how you want to connect your frontend application</p>
            <div class="srcs">
              <div class="src on" data-src="sdk"><b><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="8" r="2" fill="currentColor"/></svg>Automatic Setup</b><span>Easy SDK integration (React, Angular, Vue, JS)</span><button class="btn primary sel" data-pick="sdk">Selected</button></div>
              <div class="src" data-src="manual"><b><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="2" width="10" height="12" rx="1" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>Manual Config</b><span>Manual observability setup (web)</span><button class="btn sel" data-pick="manual">Select</button></div>
            </div>
            <p class="lbl2 imp">Import Existing Configuration</p>
            <p class="help2">Already have a configuration file? Upload it here.</p>
            <label class="drop"><input type="file" hidden data-import />Drag your configuration file here or click to select it from your device.</label>
          </div>
          <div class="wiz-foot"><button class="btn big" data-next="0">Back</button><button class="btn primary big" data-next="2">Next</button></div>
        </section>

        <section class="wiz" data-wiz="2" hidden>
          <h2 class="wtitle">Configure Your Application</h2>
          <div class="windent">
            <p class="lbl2">Select your application framework</p>
            <div class="fws">{frameworks.map((f, i) => <button class:list={["fw", { on: i === 0 }]} data-fw={f}>{f}</button>)}</div>
            <p class="lbl2">Installation method:</p>
            <div class="codepanel">
              <div class="pms">{["npm", "yarn", "CDN"].map((m, i) => <button class:list={{ on: i === 0 }} data-pm={m}>{m.toUpperCase()}</button>)}</div>
              <div class="codebox flat"><button class="copy icon" data-copy aria-label="Copy"><svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><rect x="5" y="5" width="9" height="9" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg></button><pre data-code></pre></div>
              <div class="inline"><input class="field" placeholder="*Allowed domains" data-dom2 /><button class="btn big addbtn" data-add-dom2>Add</button></div>
            </div>
          </div>
          <div class="wiz-foot"><button class="btn big" data-next="1">Back</button><button class="btn primary big" data-next="3">Next</button></div>
        </section>

        <section class="wiz" data-wiz="3" hidden>
          <h2 class="wtitle">Setup Complete!</h2>
          <div class="bigcheck" aria-hidden="true">✓</div>
          <div class="sumpanel">
            <b>Configuration Summary</b>
            <dl>
              <dt>App Name:</dt><dd data-sum-name>acme-monitoring</dd>
              <dt>Application Framework:</dt><dd data-sum-fw>React</dd>
              <dt>Allowed Domains:</dt><dd data-sum-dom>*.acme-monitoring.com</dd>
              <dt>Endpoint URL:</dt><dd>https://faro-collector-prod-eu-west-2.grafana.net/collect</dd>
            </dl>
          </div>
          <p class="lbl2 ns">Next steps</p>
          <button class="nextcard" data-finish><b>View Dashboard</b><span>Monitor your application’s performance in real-time</span></button>
          <div class="wiz-foot"><button class="btn big" data-next="2">Back</button><button class="btn primary big" data-finish2>Finish</button></div>
        </section>
        </div>
        </div>
      </main>

      <!-- 3. Applications -->
      <main class="screen page" data-screen="apps" data-crumb="Home/Frontend/Applications" data-side-on="Applications">
        <div class="row-head"><h1 class="title">Applications</h1><a class="btn primary" href="#setup">+ New application</a></div>
        <div class="apps">
          <div class="appcard" data-appcard>
            <header>
              <span class="app-ic" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24"><path d="M12 3 2 8l10 5 10-5Z M2 12l10 5 10-5 M2 16l10 5 10-5" fill="none" stroke="#ff8833" stroke-width="1.7" stroke-linejoin="round"/></svg></span>
