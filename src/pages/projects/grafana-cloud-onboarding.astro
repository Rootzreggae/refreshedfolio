---
// Case study: Grafana Cloud onboarding. The page is one pinned scene: the prototype rises out of the hero and a camera
// moves over it chapter by chapter, with headlines sliding in from the edges and the colour shifting. The details peel
// up over it at the end. Play opens the working prototype in a new tab.
import Chapters, { type Chapter } from "../../components/case/Chapters.astro";

// The story in three chapters. Camera keys: at = 0..1 through the chapter, zoom around the focus point (fx, fy)
const I = "/images/grafana";
const chapters: Chapter[] = [
  { id: "ch-question", label: "About the question", bg: "#1d3a5f", ghost: "?",
    left: "Nobody knew what", right: "*Loki, Mimir or Tempo* were.",
    keys: [{ at: 0, hash: "#welcome", zoom: 1.9, fx: 0.24, fy: 0.46 }, { at: 0.35, zoom: 1.9, fx: 0.24, fy: 0.46 }, { at: 0.72, zoom: 1, fx: 0.5, fy: 0.5 }],
    sheet: [
      { kicker: "The finding", title: "New users didn’t know what the products were for.", img: "https://i.postimg.cc/jS15ZYq0/feedback-onboard.png", alt: "User feedback showing confusion about the products",
        text: "In 2022 Grafana Cloud kept adding products, and research kept showing the same thing. The people who needed the docs most were the ones who never opened them." },
      { kicker: "The decision", title: "Answer the question before asking anything.", img: `${I}/onb-welcome.webp`, alt: "The welcome screen",
        text: "The welcome screen does one job: explain what Grafana Cloud is, in five lines and one picture." },
      { kicker: "The craft", title: "I drew the illustration from scratch.", img: "/images/grafana/welcome-illustration-affinity.webp", alt: "The illustration open in Affinity Designer",
        text: "The Grafana core, the cloud above it, and one object for each part of the platform, so the answer is visible before it’s read." },
    ] },
  { id: "ch-goals", label: "About setup", bg: "#3a2d5e", ghost: "Goals",
    left: "Ask what they came to do,", right: "*then bring the docs to them.*",
    keys: [{ at: 0, hash: "#setup", zoom: 1.4, fx: 0.68, fy: 0.52 }, { at: 0.38, zoom: 1.4, fx: 0.68, fy: 0.52, hover: '.active .card[data-path="kube"]' }, { at: 0.7, zoom: 1.65, fx: 0.16, fy: 0.5 }],
    sheet: [
      { kicker: "The decision", title: "Goals, not product names.", img: `${I}/onb-setup.webp`, alt: "The setup step with four goals",
        text: "Send metrics, monitor Kubernetes, build a dashboard, set up on-call. A new user knows what they want to do long before they know what Tempo is." },
      { kicker: "The decision", title: "The docs come to them.", img: `${I}/onb-docs.webp`, alt: "The docs panel explaining Kubernetes monitoring",
        text: "Point at a path and the panel explains it, with a link for anyone who wants more. No new tab, no digging." },
      { kicker: "The detail", title: "Every path says what it takes.", img: `${I}/onb-cost.webp`, alt: "Cards showing time and access needed",
        text: "Time and access up front, so nobody starts something they can’t finish." },
    ] },
  { id: "ch-real", label: "About the landing", bg: "#1e4848", ghost: "Real",
    left: "Every path ends", right: "*somewhere real.*",
    keys: [{ at: 0, hash: "#dest-kube", zoom: 1, fx: 0.5, fy: 0.4 }, { at: 0.35, zoom: 1, fx: 0.5, fy: 0.4 }, { at: 0.76, zoom: 2.6, fx: 0.02, fy: 0.52 }],
    sheet: [
      { kicker: "The decision", title: "A short confirmation, then the real page.", img: `${I}/onb-done.webp`, alt: "The confirmation screen",
        text: "No dead end: every path lands on the product page it was about, with the next step ready." },
      { kicker: "The detail", title: "Onboarding stays findable.", img: `${I}/onb-menu.webp`, alt: "The pulsing onboarding entry in the menu",
        text: "The menu entry pulses, so people know where onboarding lives when they want it again." },
    ] },
];

const shipped = [
  ["Login", "A login screen that introduces the product"],
  ["Welcome", "A welcome screen built around “What is Grafana Cloud?”"],
  ["Setup", "Doc snippets inside each setup step"],
  ["Tutorials", "Interactive tutorials and tooltips"],
];
const principles = [
  ["Integrate documentation", "Concise, relevant doc snippets inside each onboarding step."],
  ["Visual communication", "Clear pictures of complex products, so abstract ideas become tangible."],
  ["Progressive disclosure", "Complexity arrives gradually: deeper docs when the user is ready, not forced."],
  ["Interactive learning", "Hands-on tutorials and contextual tooltips instead of passive reading."],
];
const iterations = [
  ["https://i.postimg.cc/ZK67ZpDC/cloud-1.png", "Initial exploration focusing on product ecosystem visualization"],
  ["https://i.postimg.cc/NG3JWpD3/cloud-2.png", "Iteration emphasizing clear navigation paths and product discovery"],
  ["https://i.postimg.cc/1Rn7CLG0/cloud-3.png", "Final version with balanced information hierarchy and visual clarity"],
];
const videos = [
  ["https://www.youtube-nocookie.com/embed/qj0o3uY8bHE", "Welcome screen walkthrough"],
  ["https://www.youtube-nocookie.com/embed/QXZHoQk0ubA", "Integrated learning walkthrough"],
  ["https://www.youtube-nocookie.com/embed/ThLqQUa4IKc", "Tutorials walkthrough"],
];
const facts: [string, string][] = [
  ["Role", "Product Designer"],
  ["Company", "Grafana Labs"],
  ["Year", "2022"],
  ["Shipped", "Login, welcome, setup, tutorials"],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>Grafana Cloud Onboarding Redesign - Nilson Gaspar</title>
    <meta
      name="title"
      content="Grafana Cloud Onboarding Redesign - Nilson Gaspar"
    />
    <meta
      name="description"
      content="Redesigning the Grafana Cloud onboarding experience around one question: what is Grafana Cloud? Login, welcome, setup and tutorials."
    />
    <meta name="author" content="Nilson Gaspar" />
    <meta
      name="keywords"
      content="Grafana Labs, onboarding redesign, user experience, login design, cloud platform"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content="https://nilsongaspar.omg.lol/projects/grafana-cloud-onboarding"
    />
    <meta
      property="og:title"
      content="Grafana Cloud Onboarding Redesign - Nilson Gaspar"
    />
    <meta
      property="og:description"
      content="Redesigning the Grafana Cloud onboarding experience around one question: what is Grafana Cloud? Login, welcome, setup and tutorials."
    />
    <meta
      property="og:image"
      content="https://i.postimg.cc/HW5wrDjc/app-o11y.png"
    />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta
      property="twitter:url"
      content="https://nilsongaspar.omg.lol/projects/grafana-cloud-onboarding"
    />
    <meta
      property="twitter:title"
      content="Grafana Cloud Onboarding Redesign - Nilson Gaspar"
    />
    <meta
      property="twitter:description"
      content="Redesigning the Grafana Cloud onboarding experience around one question: what is Grafana Cloud? Login, welcome, setup and tutorials."
    />
    <meta
      property="twitter:image"
      content="https://i.postimg.cc/HW5wrDjc/app-o11y.png"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/font/NB International Regular.otf" as="font" type="font/otf" crossorigin />
  </head>
  <body>
    <nav class="nav"><a href="/projects/grafana" class="back">← Grafana projects</a></nav>

    <Chapters src="/prototypes/grafana-onboarding/#welcome" url="grafana.com/cloud" heroBg="#1d3a5f" chapters={chapters} play="/prototypes/grafana-onboarding/">
      <div slot="hero" class="hero-in">
        <p class="eyebrow">Grafana Labs · 2022</p>
        <h1 class="hero-title"><span>Grafana Cloud</span> <span>onboarding</span></h1>
        <p class="lede">New users signed up without knowing what they’d signed up for. I redesigned their first ten minutes around one question: what is Grafana Cloud?</p>
        <div class="actions">
          <a class="play" href="/prototypes/grafana-onboarding/" target="_blank" rel="noopener"><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.8v10.4L12 7Z" fill="currentColor"/></svg>Play the prototype</a>
        </div>
        <p class="facts">Product Designer · Grafana Labs · 2022 · Shipped</p>
      </div>
    </Chapters>

    <!-- The details peel up over the scene -->
    <div class="rest">
      <section class="block" id="shipped">
        <p class="kicker">What shipped</p>
        <h2>The first ten minutes, rebuilt.</h2>
        <p class="sub">By rethinking the first ten minutes, we lowered the barrier of entry for new users, especially non-technical ones.</p>
        <ul class="shipped">
          {shipped.map(([k, v]) => <li><span>{k}</span>{v}</li>)}
        </ul>
      </section>

      <section class="block" id="process">
        <details>
          <summary><span>How I got there</span><small>Research, iterations, the login, the illustration</small></summary>
          <div class="process">
            <h3>The approach</h3>
            <p>The critical outcome from our team workshops was the idea to visually answer: “What is Grafana Cloud?”</p>
            <ol class="principles">
              {principles.map(([t, d]) => <li><strong>{t}</strong><span>{d}</span></li>)}
            </ol>

            <h3>What users told us</h3>
            <figure class="wipe"><img src="https://i.postimg.cc/jS15ZYq0/feedback-onboard.png" alt="User feedback highlighting confusion with product offerings" loading="lazy" /><figcaption>User feedback highlighting confusion with product offerings</figcaption></figure>

            <h3>The login starts answering too</h3>
            <div class="duo">
              <figure class="wipe"><img src="https://i.postimg.cc/pLY6QzDg/old-login.png" alt="Before: the old login" loading="lazy" /><figcaption>Before</figcaption></figure>
              <figure class="wipe"><img src="https://i.postimg.cc/jjM3mT3c/proposed-login.png" alt="After: a login that introduces the product" loading="lazy" /><figcaption>After</figcaption></figure>
            </div>

            <h3>Welcome screen iterations</h3>
            <div class="trio">
              {iterations.map(([src, cap]) => <figure class="wipe"><img src={src} alt={cap} loading="lazy" /><figcaption>{cap}</figcaption></figure>)}
            </div>

            <h3>The illustration</h3>
            <figure class="wipe"><img src="/images/grafana/welcome-illustration-affinity.webp" alt="The welcome screen illustration open in Affinity Designer, with its layers" loading="lazy" /><figcaption>Drawn from scratch in Affinity Designer: the Grafana core with the cloud above it and one object for each part of the platform around it.</figcaption></figure>

            <h3>Walkthroughs</h3>
            <div class="videos">
              {videos.map(([src, title]) => <iframe src={src} title={title} loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>)}
            </div>
          </div>
        </details>
      </section>

      <section class="block" id="change">
        <p class="kicker">Reflection</p>
        <h2>What I’d change</h2>
        <p>We shipped it and the feedback from users was good. But I didn’t agree on a baseline metric with the PM before we started, so today I can describe the impact better than I can prove it.</p>
        <p>Now I set the metric and the baseline first, and I write my own notes while the work is fresh. It’s the first thing I’d change, and it’s the habit I took from this project into every one after it.</p>
      </section>

      <footer class="foot"><a href="/prototypes/grafana-onboarding/" target="_blank" rel="noopener" class="end-play"><svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.8v10.4L12 7Z" fill="currentColor"/></svg>Play prototype</a><a href="/projects/grafana" class="back">← Grafana projects</a></footer>
    </div>


    <script>
      import Lenis from "lenis";
      import "lenis/dist/lenis.css";
      // Smooth, eased scrolling drives every scene transition; on desktop it runs for everyone, like the references
      if (matchMedia("(min-width: 901px)").matches) new Lenis({ autoRaf: true, anchors: true, lerp: 0.085, wheelMultiplier: 0.9 });
      // The details card is tossed in: tilted while it rises, flat once it lands
      const rest = document.querySelector<HTMLElement>(".rest")!;
      const toss = () => { const top = rest.getBoundingClientRect().top; const u = Math.min(1, Math.max(0, (innerHeight - top) / (innerHeight * 0.8))); rest.style.rotate = `${(1 - u) * -3}deg`; };
      addEventListener("scroll", toss, { passive: true });
      toss();
      // Images in the details wipe into view
      const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && e.target.classList.add("in")), { rootMargin: "0px 0px -10% 0px" });
      document.querySelectorAll(".wipe").forEach((f) => io.observe(f));
      // Open the details when someone jumps to them from the dock
      document.querySelector('a[href="#process"]')?.addEventListener("click", () => ((document.querySelector("#process details") as HTMLDetailsElement).open = true));
    </script>

    <style>
      @font-face { font-family: "NB International"; src: url("/font/NB International Regular.otf") format("opentype"); font-weight: 400; font-display: swap; }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { background: #1d3a5f; color: #fff; font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", sans-serif; font-size: 18px; line-height: 1.6; overflow-x: hidden; }
      h1, h2 { font-family: "NB International", -apple-system, sans-serif; font-weight: 400; letter-spacing: -.01em; }
      a { color: inherit; }

      .nav { position: absolute; top: 0; left: 0; z-index: 10; padding: 22px clamp(24px, 4vw, 64px); }
      .back { color: rgba(255, 255, 255, .8); text-decoration: none; font-size: 15px; }
      .back:hover { color: #fff; }

      /* Hero, inside the pinned scene: huge title lines rise in, the prototype peeks from below */
      .hero-in { position: absolute; left: clamp(24px, 4vw, 64px); right: clamp(24px, 4vw, 64px); top: 13vh; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); gap: 0 4vw; align-items: end; }
      .eyebrow { grid-column: 1 / -1; color: #ffb27a; font-size: 15px; letter-spacing: .04em; margin-bottom: 14px; }
      .hero-title { grid-column: 1; font-size: clamp(48px, 7.4vw, 136px); line-height: .95; letter-spacing: -.03em; }
      .hero-title span { display: inline-block; animation: up .9s cubic-bezier(.2, .7, .2, 1) both; }
      .hero-title span + span { animation-delay: .12s; }
      @keyframes up { from { opacity: 0; translate: 0 60px; } }
      .lede { grid-column: 2; grid-row: 2; font-size: clamp(17px, 1.3vw, 21px); line-height: 1.5; color: rgba(255, 255, 255, .88); max-width: 36ch; animation: up .9s .25s cubic-bezier(.2, .7, .2, 1) both; }
      .actions { grid-column: 1; display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; animation: up .9s .35s cubic-bezier(.2, .7, .2, 1) both; }
      .facts { grid-column: 2; margin-top: 30px; align-self: center; color: rgba(255, 255, 255, .72); font-size: 15px; }
      .play { display: inline-flex; align-items: center; gap: 10px; height: 48px; padding: 0 22px; border-radius: 999px; font: inherit; font-size: 16px; font-weight: 500; text-decoration: none; cursor: pointer; transition: translate .2s ease, scale .2s ease, background .2s ease, border-color .2s ease; }
      .play { border: 0; background: #fff; color: #1d3a5f; }
      .play:hover { translate: 0 -2px; scale: 1.03; }
      .play:hover svg { rotate: -8deg; transition: rotate .2s ease; }
      .play:focus-visible, summary:focus-visible { outline: 2px solid #ffb27a; outline-offset: 3px; }

      /* The details: a light card that peels up over the scene */
      .rest { position: relative; z-index: 2; margin-top: -14vh; transform-origin: 50% 0; padding-bottom: 140px; border-radius: 36px 36px 0 0; background: #f4f1ec; color: #17212b; box-shadow: 0 -10px 40px rgba(0, 0, 0, .18); }
      .rest .back { color: rgba(23, 33, 43, .75); }
      .rest .back:hover { color: #17212b; }
      .block { max-width: 1200px; margin: 0 auto; padding: 96px clamp(24px, 4vw, 64px) 0; }
      .kicker { color: #9a4609; font-size: 14px; letter-spacing: .06em; text-transform: uppercase; margin-bottom: 10px; }
      .block h2 { font-size: clamp(34px, 4vw, 64px); line-height: 1.05; letter-spacing: -.02em; margin-bottom: 18px; }
      .block > p { max-width: 62ch; color: rgba(23, 33, 43, .8); margin-bottom: 14px; }
      .sub { color: rgba(23, 33, 43, .75); margin-bottom: 28px; }
      .shipped { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
      .shipped li { display: flex; flex-direction: column; gap: 10px; padding: 22px; border-radius: 18px; background: #fff; font-size: 16px; line-height: 1.45; transition: translate .25s ease, box-shadow .25s ease; }
      .shipped li:hover { translate: 0 -3px; box-shadow: 0 8px 24px rgba(23, 33, 43, .08); }
      .shipped span { color: #9a4609; font-size: 13px; letter-spacing: .06em; text-transform: uppercase; }

      details { border-top: 1px solid rgba(23, 33, 43, .14); border-bottom: 1px solid rgba(23, 33, 43, .14); }
      summary { display: flex; align-items: baseline; gap: 16px; padding: 28px 0; cursor: pointer; list-style: none; }
      summary::-webkit-details-marker { display: none; }
      summary span { font-family: "NB International", sans-serif; font-size: clamp(28px, 3vw, 44px); letter-spacing: -.01em; }
      summary small { color: rgba(23, 33, 43, .7); font-size: 16px; }
      summary::after { content: "+"; margin-left: auto; font-size: 34px; line-height: 1; color: rgba(23, 33, 43, .6); transition: rotate .25s ease; }
      details[open] summary::after { rotate: 45deg; }
      .process { padding-bottom: 48px; }
      .process h3 { margin: 44px 0 14px; font-size: 20px; font-weight: 500; }
      .process > p { color: rgba(23, 33, 43, .8); max-width: 62ch; }
      .process figure img { width: 100%; border-radius: 14px; display: block; }
      .process figcaption { margin-top: 8px; color: rgba(23, 33, 43, .7); font-size: 14px; }
      .principles { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 18px; counter-reset: p; }
      .principles li { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; border-radius: 16px; background: #fff; counter-increment: p; }
      .principles li::before { content: "0" counter(p); color: #9a4609; font-size: 13px; }
      .principles span { color: rgba(23, 33, 43, .78); font-size: 16px; }
      .duo, .videos { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
      .trio { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
      .videos iframe { width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: 14px; }
      /* images wipe in from the left as they arrive */
      .wipe img { clip-path: inset(0 100% 0 0 round 14px); transition: clip-path 1.1s cubic-bezier(.6, 0, .2, 1); }
      .wipe.in img { clip-path: inset(0 0 0 0 round 14px); }
      .foot { max-width: 1200px; margin: 0 auto; padding: 72px clamp(24px, 4vw, 64px) 0; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
      .end-play { display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 20px; border-radius: 999px; background: #17212b; color: #fff; font-size: 15px; font-weight: 500; text-decoration: none; transition: translate .2s ease; }
      .end-play:hover { translate: 0 -2px; }
      .end-play:focus-visible { outline: 2px solid #9a4609; outline-offset: 3px; }

      @media (prefers-reduced-motion: reduce) { .hero-title span, .lede, .actions { animation: none; } .wipe img { clip-path: none; transition: none; } }
      @media (max-width: 900px) {
        .nav { position: static; padding: 18px 16px; }
        .hero-in { position: static; display: block; padding: 24px 16px 48px; }
        .hero-title { font-size: 48px; margin-bottom: 18px; }
        .lede { margin-top: 0; }
        .facts { margin-top: 18px; }
        .rest { margin-top: 0; border-radius: 24px 24px 0 0; }
        .block { padding: 64px 16px 0; }
        .shipped, .principles, .trio, .duo, .videos { grid-template-columns: 1fr; }
        .foot { padding: 56px 16px 0; }
      }
    </style>
  </body>
</html>
