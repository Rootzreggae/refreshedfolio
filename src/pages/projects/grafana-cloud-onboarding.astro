---
// Case study: Grafana Cloud onboarding. Try-before-read: the live prototype leads, a guided demo plays it with captions,
// the story pins the prototype beside it, and the process is folded away for those who want depth.
import PrototypeStage, { type Step } from "../../components/case/PrototypeStage.astro";
import Dock from "../../components/case/Dock.astro";
import StoryLine from "../../components/case/StoryLine.astro";
import ProtoFrame from "../../components/case/ProtoFrame.astro";
import { words } from "../../components/case/words";

// The guided demo: what the cursor does and what the caption says (voice clips can be added per step later)
const steps: Step[] = [
  { hash: "#welcome", caption: "Every new user arrives with the same question: what is Grafana Cloud? This screen answers it before asking for anything.", wait: 5200 },
  { click: ".active .button", caption: "Every new user arrives with the same question: what is Grafana Cloud? This screen answers it before asking for anything.", wait: 600 },
  { caption: "Then one question about them: what did you come here to do? Goals, not product names.", wait: 4600 },
  { hover: '.active .card[data-path="kube"]', caption: "Point at a path and its docs come to you. No new tab, no digging through documentation.", wait: 4800 },
  { hover: '.active .card[data-path="mlt"]', caption: "Each path says what it takes, so nobody starts something they can’t finish.", wait: 4200 },
  { click: '.active .card[data-path="kube"]', caption: "A short confirmation, then straight into the product.", wait: 700 },
  { caption: "A short confirmation, then straight into the product.", wait: 2200 },
  { hover: ".active .menu .current", caption: "They land on the real page with the next step ready. The pulsing menu item brings them back to onboarding any time.", wait: 6000 },
  { caption: "That’s the flow. Your turn: click anything.", wait: 2600 },
];

// The story: one short statement per beat (accent words in *asterisks*), a line or two of why, and its own visual
type Beat = { title: string; body: string[]; frame?: { hash: string; hover?: string }; images?: [string, string][] };
const beats: Beat[] = [
  { title: "Nobody knew what *Loki, Mimir and Tempo* were.",
    body: ["In 2022 Grafana Cloud kept adding products, and research kept showing the same thing: new users didn’t know what they were for.", "The people who needed the documentation most were the ones who never opened it."],
    images: [["https://i.postimg.cc/jS15ZYq0/feedback-onboard.png", "What users told us"]] },
  { title: "Answer the question *before asking anything.*",
    body: ["The welcome screen does one job: explain what Grafana Cloud is, in five lines and one picture.", "I drew the illustration from scratch, one object for each part of the platform."],
    frame: { hash: "#welcome" } },
  { title: "Ask what they came to do, *not which product.*",
    body: ["Goals: send metrics, monitor Kubernetes, build a dashboard, set up on-call.", "A new user knows what they want to do long before they know what Tempo is."],
    frame: { hash: "#setup" } },
  { title: "The docs *come to them.*",
    body: ["Point at a path and the panel explains it, with a link for anyone who wants more.", "I brought the docs into the flow because the users who needed them most never opened them."],
    frame: { hash: "#setup", hover: '.active .card[data-path="kube"]' } },
  { title: "Every path ends *somewhere real.*",
    body: ["A short confirmation, then the actual product page with the next step ready.", "The menu entry pulses, so people know where onboarding lives when they want it again."],
    frame: { hash: "#dest-kube" } },
  { title: "The login starts *answering too.*",
    body: ["Before anyone signs in, the login already says what Grafana Cloud is and what’s inside."],
    images: [["https://i.postimg.cc/pLY6QzDg/old-login.png", "Before"], ["https://i.postimg.cc/jjM3mT3c/proposed-login.png", "After"]] },
];

const shipped = [
  ["Login", "A login screen that introduces the product"],
  ["Welcome", "A welcome screen built around “What is Grafana Cloud?”"],
  ["Setup", "Doc snippets inside each setup step"],
  ["Tutorials", "Interactive tutorials and tooltips"],
];
const principles = [
  ["Integrate documentation", "Concise, relevant doc snippets inside each onboarding step."],
  ["Visual communication", "Clear pictures of complex products, so abstract ideas become tangible."],
  ["Progressive disclosure", "Complexity arrives gradually: deeper docs when the user is ready, not forced."],
  ["Interactive learning", "Hands-on tutorials and contextual tooltips instead of passive reading."],
];
const iterations = [
  ["https://i.postimg.cc/ZK67ZpDC/cloud-1.png", "Initial exploration focusing on product ecosystem visualization"],
  ["https://i.postimg.cc/NG3JWpD3/cloud-2.png", "Iteration emphasizing clear navigation paths and product discovery"],
  ["https://i.postimg.cc/1Rn7CLG0/cloud-3.png", "Final version with balanced information hierarchy and visual clarity"],
];
const videos = [
  ["https://www.youtube-nocookie.com/embed/qj0o3uY8bHE", "Welcome screen walkthrough"],
  ["https://www.youtube-nocookie.com/embed/QXZHoQk0ubA", "Integrated learning walkthrough"],
  ["https://www.youtube-nocookie.com/embed/ThLqQUa4IKc", "Tutorials walkthrough"],
];
const facts: [string, string][] = [
  ["Role", "Product Designer"],
  ["Company", "Grafana Labs"],
  ["Year", "2022"],
  ["Shipped", "Login, welcome, setup, tutorials"],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>Grafana Cloud Onboarding Redesign - Nilson Gaspar</title>
    <meta
      name="title"
      content="Grafana Cloud Onboarding Redesign - Nilson Gaspar"
    />
    <meta
      name="description"
      content="Redesigning the Grafana Cloud onboarding experience around one question: what is Grafana Cloud? Login, welcome, setup and tutorials."
    />
    <meta name="author" content="Nilson Gaspar" />
    <meta
      name="keywords"
      content="Grafana Labs, onboarding redesign, user experience, login design, cloud platform"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content="https://nilsongaspar.omg.lol/projects/grafana-cloud-onboarding"
    />
    <meta
      property="og:title"
      content="Grafana Cloud Onboarding Redesign - Nilson Gaspar"
    />
    <meta
      property="og:description"
      content="Redesigning the Grafana Cloud onboarding experience around one question: what is Grafana Cloud? Login, welcome, setup and tutorials."
    />
    <meta
      property="og:image"
      content="https://i.postimg.cc/HW5wrDjc/app-o11y.png"
    />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta
      property="twitter:url"
      content="https://nilsongaspar.omg.lol/projects/grafana-cloud-onboarding"
    />
    <meta
      property="twitter:title"
      content="Grafana Cloud Onboarding Redesign - Nilson Gaspar"
    />
    <meta
      property="twitter:description"
      content="Redesigning the Grafana Cloud onboarding experience around one question: what is Grafana Cloud? Login, welcome, setup and tutorials."
    />
    <meta
      property="twitter:image"
      content="https://i.postimg.cc/HW5wrDjc/app-o11y.png"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/font/NB International Regular.otf" as="font" type="font/otf" crossorigin />
  </head>
  <body>
    <nav class="nav">
      <a href="/projects/grafana" class="back">← Grafana projects</a>
    </nav>

    <!-- Hero: the live prototype leads; the guided demo plays here -->
    <header class="hero" id="hero">
      <div class="hero-text">
        <p class="eyebrow">Grafana Labs · 2022</p>
        <h1>Grafana Cloud onboarding</h1>
        <p class="lede">New users signed up without knowing what they’d signed up for. I redesigned their first ten minutes around one question: what is Grafana Cloud?</p>
        <p class="facts">Product Designer · Grafana Labs · 2022 · Shipped</p>
        <div class="actions">
          <button class="watch" data-watch><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.8v10.4L12 7Z" fill="currentColor"/></svg>Watch the demo · 35s</button>
          <a class="try" href="/prototypes/grafana-onboarding/" target="_blank" rel="noopener">Try it yourself ↗</a>
        </div>
      </div>
      <div class="hero-stage">
        <PrototypeStage src="/prototypes/grafana-onboarding/#welcome" url="grafana.com/cloud" steps={steps} />
      </div>
    </header>

    <!-- The story: one line drawn as you scroll, each beat hanging off it with its own visual -->
    <StoryLine id="story" heading="One question to answer: *what is Grafana Cloud?*">
      {beats.map((b) => (
        <div class="beat">
          <div class="beat-text">
            <span class="dot" aria-hidden="true"></span>
            <h3>{words(b.title).map(({ w, accent }) => <span class:list={["w", { accent }]}>{w} </span>)}</h3>
            {b.body.map((p) => <p>{p}</p>)}
          </div>
          <div class="beat-visual">
            {b.frame && <ProtoFrame src={`/prototypes/grafana-onboarding/${b.frame.hash}`} url="grafana.com/cloud" hover={b.frame.hover} />}
            {b.images && (
              <div class:list={["shots", { pair: b.images.length > 1 }]}>
                {b.images.map(([src, label]) => <figure><img src={src} alt={label} loading="lazy" /><figcaption>{label}</figcaption></figure>)}
              </div>
            )}
          </div>
        </div>
      ))}
    </StoryLine>

    <section class="block" id="shipped">
      <h2>What shipped</h2>
      <p class="sub">By rethinking the first ten minutes, we lowered the barrier of entry for new users, especially non-technical ones.</p>
      <ul class="shipped">
        {shipped.map(([k, v]) => <li><span>{k}</span>{v}</li>)}
      </ul>
    </section>

    <section class="block" id="process">
      <details>
        <summary><span>How I got there</span><small>Research, iterations, the illustration</small></summary>
        <div class="process">
          <h3>The approach</h3>
          <p>The critical outcome from our team workshops was the idea to visually answer: “What is Grafana Cloud?”</p>
          <ol class="principles">
            {principles.map(([t, d]) => <li><strong>{t}</strong><span>{d}</span></li>)}
          </ol>

          <h3>What users told us</h3>
          <figure><img src="https://i.postimg.cc/jS15ZYq0/feedback-onboard.png" alt="User feedback highlighting confusion with product offerings" loading="lazy" /><figcaption>User feedback highlighting confusion with product offerings</figcaption></figure>

          <h3>Welcome screen iterations</h3>
          <div class="trio">
            {iterations.map(([src, cap]) => <figure><img src={src} alt={cap} loading="lazy" /><figcaption>{cap}</figcaption></figure>)}
          </div>

          <h3>The illustration</h3>
          <figure><img src="/images/grafana/welcome-illustration-affinity.webp" alt="The welcome screen illustration open in Affinity Designer, with its layers" loading="lazy" /><figcaption>Drawn from scratch in Affinity Designer: the Grafana core with the cloud above it and one object for each part of the platform around it.</figcaption></figure>

          <h3>Walkthroughs</h3>
          <div class="videos">
            {videos.map(([src, title]) => <iframe src={src} title={title} loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>)}
          </div>
        </div>
      </details>
    </section>

    <section class="block" id="change">
      <h2>What I’d change</h2>
      <p>We shipped it and the feedback from users was good. But I didn’t agree on a baseline metric with the PM before we started, so today I can describe the impact better than I can prove it.</p>
      <p>Now I set the metric and the baseline first, and I write my own notes while the work is fresh. It’s the first thing I’d change, and it’s the habit I took from this project into every one after it.</p>
    </section>

    <footer class="foot"><a href="/projects/grafana" class="back">← Grafana projects</a></footer>

    <Dock after="#hero" sections={[["#story", "The story"], ["#shipped", "What shipped"], ["#process", "How I got there"], ["#change", "What I’d change"]]} facts={facts} />

    <script>
      // Hero button starts the demo
      document.querySelector("[data-watch]")!.addEventListener("click", () => document.dispatchEvent(new Event("demo:play")));
    </script>

    <style>
      @font-face { font-family: "NB International"; src: url("/font/NB International Regular.otf") format("opentype"); font-weight: 400; font-display: swap; }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { background: #0f1d2e; color: #fff; font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", sans-serif; font-size: 18px; line-height: 1.6; overflow-x: hidden; }
      h1, h2, .beat h2 { font-family: "NB International", -apple-system, sans-serif; font-weight: 400; letter-spacing: -.01em; }
      a { color: inherit; }

      .nav { padding: 24px clamp(24px, 11vw, 320px); }
      .back { color: rgba(255, 255, 255, .7); text-decoration: none; font-size: 15px; }
      .back:hover { color: #fff; }

      .hero { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 64px; align-items: center; min-height: calc(100vh - 80px); padding: 0 clamp(24px, 11vw, 320px) 64px; }
      .eyebrow { color: #ff8833; font-size: 15px; letter-spacing: .04em; margin-bottom: 18px; }
      .hero h1 { font-size: clamp(40px, 4.6vw, 68px); line-height: 1.05; margin-bottom: 26px; }
      .lede { font-size: clamp(19px, 1.5vw, 23px); line-height: 1.5; color: rgba(255, 255, 255, .86); max-width: 34ch; }
      .facts { margin-top: 22px; color: rgba(255, 255, 255, .55); font-size: 15px; }
      .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }
      .watch, .try { display: inline-flex; align-items: center; gap: 10px; height: 48px; padding: 0 22px; border-radius: 12px; font: inherit; font-size: 16px; font-weight: 500; text-decoration: none; cursor: pointer; }
      .watch { border: 0; background: #fff; color: #0f1d2e; }
      .watch:hover { background: #e8edf3; }
      .try { border: 1px solid rgba(255, 255, 255, .25); color: #fff; }
      .try:hover { border-color: rgba(255, 255, 255, .6); }
      .watch:focus-visible, .try:focus-visible, summary:focus-visible { outline: 2px solid #ff8833; outline-offset: 3px; }

      .shots img { width: 100%; display: block; border-radius: 16px; box-shadow: 0 6px 20px rgba(0, 0, 0, .16); }
      .shots figcaption { margin-top: 8px; color: rgba(255, 255, 255, .5); font-size: 14px; }
      .shots.pair { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

      .block { max-width: 1200px; margin: 0 auto; padding: 96px clamp(16px, 4vw, 72px) 0; }
      .block h2 { font-size: clamp(30px, 3vw, 44px); line-height: 1.15; margin-bottom: 18px; }
      .block > p { max-width: 62ch; color: rgba(255, 255, 255, .8); margin-bottom: 14px; }
      .sub { color: rgba(255, 255, 255, .7); margin-bottom: 28px; }
      .shipped { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
      .shipped li { display: flex; flex-direction: column; gap: 10px; padding: 22px; border-radius: 14px; background: rgba(255, 255, 255, .05); border: 1px solid rgba(255, 255, 255, .08); font-size: 16px; line-height: 1.45; }
      .shipped span { color: #ff8833; font-size: 14px; letter-spacing: .04em; text-transform: uppercase; }

      details { border-top: 1px solid rgba(255, 255, 255, .12); border-bottom: 1px solid rgba(255, 255, 255, .12); }
      summary { display: flex; align-items: baseline; gap: 16px; padding: 28px 0; cursor: pointer; list-style: none; }
      summary::-webkit-details-marker { display: none; }
      summary span { font-family: "NB International", sans-serif; font-size: clamp(26px, 2.6vw, 38px); }
      summary small { color: rgba(255, 255, 255, .5); font-size: 16px; }
      summary::after { content: "+"; margin-left: auto; font-size: 32px; line-height: 1; color: rgba(255, 255, 255, .6); transition: rotate .25s ease; }
      details[open] summary::after { rotate: 45deg; }
      .process { padding-bottom: 48px; }
      .process h3 { margin: 40px 0 14px; font-size: 20px; font-weight: 500; }
      .process > p { color: rgba(255, 255, 255, .78); max-width: 62ch; }
      .process figure img { width: 100%; border-radius: 10px; display: block; }
      .process figcaption { margin-top: 8px; color: rgba(255, 255, 255, .5); font-size: 14px; }
      .principles { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 18px; counter-reset: p; }
      .principles li { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; border-radius: 12px; background: rgba(255, 255, 255, .05); counter-increment: p; }
      .principles li::before { content: "0" counter(p); color: #ff8833; font-size: 13px; }
      .principles span { color: rgba(255, 255, 255, .72); font-size: 16px; }
      .trio { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
      .videos { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
      .videos iframe { width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: 10px; }

      .foot { max-width: 1200px; margin: 0 auto; padding: 72px clamp(16px, 4vw, 72px) 140px; }

      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      @media (max-width: 1000px) {
        .nav { padding: 18px 16px; }
        .hero { grid-template-columns: 1fr; gap: 28px; min-height: 0; padding: 24px 16px 40px; }
        .shots.pair { grid-template-columns: 1fr; }
        .block { padding: 72px 16px 0; }
        .shipped, .principles, .trio, .videos { grid-template-columns: 1fr; }
        .foot { padding: 56px 16px 120px; }
      }
    </style>
  </body>
</html>
