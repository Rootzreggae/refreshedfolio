---
// Case study: Grafana Frontend Observability (RUM). The page is one pinned scene: the prototype rises out of the hero and a
// camera moves over it chapter by chapter, with headlines sliding in from the edges. The details peel up over it at the
// end. Play opens the working prototype in a new tab.
import Chapters, { type Chapter } from "../../components/case/Chapters.astro";

// The story in three chapters. Camera keys: at = 0..1 through the chapter, zoom around the focus point (fx, fy)
const I = "/images/grafana";
const chapters: Chapter[] = [
  { id: "ch-setup", label: "About setup", bg: "#000000", ghost: "1",
    left: "From a snippet", right: "*to an app with a home.*",
    keys: [{ at: 0, hash: "#setup", zoom: 1.2, fx: 0.45, fy: 0.4 }, { at: 0.45, hash: "#apps", zoom: 1, fx: 0.5, fy: 0.4 }, { at: 0.8, zoom: 1.6, fx: 0.32, fy: 0.3 }],
    sheet: [
      { kicker: "The decision", title: "Setup asks only what it needs.", img: `${I}/rum-setup.webp`, alt: "Configure your application, with automatic setup or manual config",
        text: "Name the app, choose automatic setup or the manual config, and copy the snippet written for your framework. The allowed domains are filled in for you." },
      { kicker: "The detail", title: "The new app lives in a space.", img: `${I}/rum-space.webp`, alt: "Applications, with the new app's card showing errors and page loads",
        text: "Finishing setup lands on Applications, where the app has a card with its first errors and page loads, not on an empty dashboard." },
    ] },
  { id: "ch-overview", label: "About the overview", bg: "#000000", ghost: "LCP",
    left: "Every web vital,", right: "*read at a glance.*",
    keys: [{ at: 0, hash: "#app", zoom: 1.3, fx: 0.55, fy: 0.62 }, { at: 0.5, zoom: 1.3, fx: 0.55, fy: 0.62 }, { at: 0.85, zoom: 1.1, fx: 0.55, fy: 0.85 }],
    sheet: [
      { kicker: "The decision", title: "Vitals with their thresholds, not just numbers.", img: `${I}/rum-vitals.webp`, alt: "The app overview with page loads, errors and six web vitals",
        text: "Each vital shows where it sits between good and poor, so 2.1 s LCP reads as Good without looking anything up." },
      { kicker: "A pattern I brought in", title: "Tabs inside a panel.", img: `${I}/rum-tabs.webp`, alt: "The metrics panel switched to Business Metrics",
        text: "Performance, business and technical metrics share one table. Grafana had no tabs inside a panel before this; I took the pattern from tools our users already worked in every day." },
    ] },
  { id: "ch-errors", label: "About errors and sessions", bg: "#000000", ghost: "27",
    left: "From an error", right: "*to the person who hit it.*",
    keys: [{ at: 0, hash: "#app-error-fly-2", zoom: 1.2, fx: 0.62, fy: 0.4 }, { at: 0.45, hash: "#app-session-0", hover: "[data-aw-open]", zoom: 1.15, fx: 0.6, fy: 0.6 }, { at: 0.85, zoom: 1.35, fx: 0.62, fy: 0.62 }],
    sheet: [
      { kicker: "A pattern I brought in", title: "The Flyout.", img: `${I}/rum-flyout.webp`, alt: "An error's flyout beside the Javascript Errors list",
        text: "Details beside the list, without a new page or a modal. I wrote its rules, when to use it and when not to, and gave it to the design system team." },
      { kicker: "The detail", title: "A session, second by second.", img: `${I}/rum-session.webp`, alt: "A session timeline with the Error Awareness card open",
        text: "The timeline shows every event in a session. Hovering a cluster of errors opens Error Awareness, and Examine goes straight to the error." },
    ] },
];

const shipped = [
  ["Setup", "Three steps, with the snippet written for your framework"],
  ["Overview", "Web vitals with thresholds, errors and page performance on one page"],
  ["The Flyout", "A new design system component for details beside a list"],
  ["Sessions", "Every event in a user’s session on one timeline"],
];
const principles = [
  ["Clarity", "Communicate complex data clearly."],
  ["Consistency", "The same layout and structure everywhere, to reduce confusion."],
  ["Usability", "Easy to use, even for people who aren’t experts in data analysis."],
  ["Familiar patterns", "Bring in what users already trust from the tools they know."],
];
const market = [
  ["https://i.postimg.cc/c18VQ6LB/image.png", "Datadog"],
  ["https://i.postimg.cc/tJtk2Kfp/image.png", "New Relic"],
  ["https://i.postimg.cc/636p8nXc/image.png", "Dynatrace"],
  ["https://i.postimg.cc/qqLc88h7/image.png", "Synthetic monitoring vs RUM"],
];
const sketches = [
  ["https://i.postimg.cc/B6m8Cscx/PXL-20250502-091251290.jpg", "Sketches"],
  ["https://i.postimg.cc/RV7WPcRS/PXL-20250502-091230716.jpg", "Filters"],
  ["https://i.postimg.cc/xTq3ZjCp/image.png", "Onboarding"],
  ["https://i.postimg.cc/K8JpMpRC/image.png", "Layouts"],
];
const videos = [
  ["https://www.youtube-nocookie.com/embed/IpW2zfMEn3g", "Initial concepts"],
  ["https://www.youtube-nocookie.com/embed/vyyb227mI0s", "Onboarding exploration"],
  ["https://www.youtube-nocookie.com/embed/CdNAqIURkxw", "Component refinement"],
  ["https://www.youtube-nocookie.com/embed/wSG5aTCFv-U", "Design system contributions"],
  ["https://www.youtube-nocookie.com/embed/q0Yd8Cz-WMY", "Unhappy paths"],
  ["https://www.youtube-nocookie.com/embed/YkYUMjo2PV4", "Stakeholder alignment"],
  ["https://www.youtube-nocookie.com/embed/JGvyDOPvtbA", "Technical integration with OpenTelemetry and Faro"],
  ["https://www.youtube-nocookie.com/embed/tVaX6zz-yA0", "The final solution"],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>Grafana Frontend Observability - Nilson Gaspar</title>
    <meta
      name="title"
      content="Grafana Frontend Observability - Nilson Gaspar"
    />
    <meta
      name="description"
      content="Designing Grafana Frontend Observability, real user monitoring, from the Kowalski hackathon project to GA: setup in three steps, web vitals at a glance, and the Flyout."
    />
    <meta name="author" content="Nilson Gaspar" />
    <meta
      name="keywords"
      content="Grafana Labs, frontend observability, RUM, real user monitoring, web vitals, product design"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content="https://nilsongaspar.omg.lol/projects/grafana-frontend"
    />
    <meta
      property="og:title"
      content="Grafana Frontend Observability - Nilson Gaspar"
    />
    <meta
      property="og:description"
      content="Designing Grafana Frontend Observability, real user monitoring, from the Kowalski hackathon project to GA: setup in three steps, web vitals at a glance, and the Flyout."
    />
    <meta
      property="og:image"
      content="https://i.postimg.cc/hjzgQt4M/feo-screens.png"
    />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta
      property="twitter:url"
      content="https://nilsongaspar.omg.lol/projects/grafana-frontend"
    />
    <meta
      property="twitter:title"
      content="Grafana Frontend Observability - Nilson Gaspar"
    />
    <meta
      property="twitter:description"
      content="Designing Grafana Frontend Observability, real user monitoring, from the Kowalski hackathon project to GA: setup in three steps, web vitals at a glance, and the Flyout."
    />
    <meta
      property="twitter:image"
      content="https://i.postimg.cc/hjzgQt4M/feo-screens.png"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/font/NB International Regular.otf" as="font" type="font/otf" crossorigin />
  </head>
  <body>
    <nav class="nav"><a href="/projects/grafana" class="back">← Grafana projects</a></nav>

    <Chapters src="/prototypes/grafana-rum/#setup" url="grafana.com/cloud" heroBg="#000000" chapters={chapters} play="/prototypes/grafana-rum/">
      <div slot="hero" class="hero-in">
        <p class="eyebrow">Grafana Labs · 2022</p>
        <h1 class="hero-title"><span>Frontend</span> <span>Observability</span></h1>
        <p class="lede">I was the original designer of Grafana’s real user monitoring, from a hackathon project called Kowalski to GA. The goal: stand out next to Datadog and New Relic by making frontend data easy to act on.</p>
        <div class="actions">
          <a class="play" href="/prototypes/grafana-rum/" target="_blank" rel="noopener"><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.8v10.4L12 7Z" fill="currentColor"/></svg>Play the prototype</a>
        </div>
        <p class="facts">Original designer · Grafana Labs · 2022 · Shipped</p>
      </div>
    </Chapters>

    <!-- The details peel up over the scene -->
    <div class="rest">
      <section class="block" id="shipped">
        <p class="kicker">What shipped</p>
        <h2>Real user monitoring, from hackathon to GA.</h2>
        <p class="sub">It started as Kowalski, a hackathon prototype. The sample app in my files is still called Kowalski-baby.</p>
        <ul class="shipped">
          {shipped.map(([k, v]) => <li><span>{k}</span>{v}</li>)}
        </ul>
      </section>

      <section class="block" id="process">
        <details>
          <summary><span>How I got there</span><small>The market, sketches, iterations, the design system</small></summary>
          <div class="process">
            <h3>The market</h3>
            <p>Most large companies already used Datadog or New Relic. To stand out, our tool had to simplify complex data while still giving actionable insights.</p>
            <div class="duo">
              {market.map(([src, cap]) => <figure class="wipe"><img src={src} alt={cap} loading="lazy" /><figcaption>{cap}</figcaption></figure>)}
            </div>

            <h3>Patterns users already trust</h3>
            <p>On a new product I bring in patterns the design system doesn’t have yet, but that our users already know from tools that have done them well for years. Tabs inside a panel and the Flyout both came from there. A design system team can’t know the day-to-day of every field, so I bring the pattern in, build it properly with its rules, and hand it back.</p>
            <ol class="principles">
              {principles.map(([t, d]) => <li><strong>{t}</strong><span>{d}</span></li>)}
            </ol>

            <h3>From sketches to systems</h3>
            <p>I drew on video game interfaces and IDEs like VS Code and IntelliJ, where dense information stays easy to read. Our users, developers, product managers and IT teams, spend hours monitoring and troubleshooting.</p>
            <div class="duo">
              {sketches.map(([src, cap]) => <figure class="wipe"><img src={src} alt={cap} loading="lazy" /><figcaption>{cap}</figcaption></figure>)}
            </div>
            <figure class="wipe solo"><img src="https://i.postimg.cc/TY4JjM5q/SCR-20240808-jrft.png" alt="The Miro board for information architecture" loading="lazy" /><figcaption>Information architecture, mapped together with the team</figcaption></figure>

            <h3>Ship, learn, iterate</h3>
            <p>High-fidelity prototypes showed product managers and engineers what was certain and what wasn’t. I split my time between designing and learning OpenTelemetry and our Faro web SDK, which built trust with the engineers.</p>
            <div class="videos">
              {videos.map(([src, title]) => <iframe src={src} title={title} loading="lazy" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>)}
            </div>
          </div>
        </details>
      </section>

      <footer class="foot"><a href="/prototypes/grafana-rum/" target="_blank" rel="noopener" class="end-play"><svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.8v10.4L12 7Z" fill="currentColor"/></svg>Play prototype</a><a href="/projects/grafana" class="back">← Grafana projects</a></footer>
    </div>

    <script>
      import Lenis from "lenis";
      import "lenis/dist/lenis.css";
      // Smooth, eased scrolling drives every scene transition; on desktop it runs for everyone, like the references
      if (matchMedia("(min-width: 901px)").matches) new Lenis({ autoRaf: true, anchors: true, lerp: 0.085, wheelMultiplier: 0.9 });
      // The details card is tossed in: tilted while it rises, flat once it lands
      const rest = document.querySelector<HTMLElement>(".rest")!;
      const toss = () => {
        if (!matchMedia("(min-width: 901px)").matches) { rest.style.rotate = ""; return; } // phones: no tilt, it would overflow sideways
        const top = rest.getBoundingClientRect().top; const u = Math.min(1, Math.max(0, (innerHeight - top) / (innerHeight * 0.8))); rest.style.rotate = `${(1 - u) * -3}deg`; };
      addEventListener("scroll", toss, { passive: true });
      toss();
      // Images in the details wipe into view
      const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && e.target.classList.add("in")), { rootMargin: "0px 0px -10% 0px" });
      document.querySelectorAll(".wipe").forEach((f) => io.observe(f));
      // Open the details when someone jumps to them from the dock
      document.querySelector('a[href="#process"]')?.addEventListener("click", () => ((document.querySelector("#process details") as HTMLDetailsElement).open = true));
    </script>

    <style>
      @font-face { font-family: "NB International"; src: url("/font/NB International Regular.otf") format("opentype"); font-weight: 400; font-display: swap; }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html { overflow-x: clip; }
      body { background: #000; color: #fff; font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", sans-serif; font-size: 18px; line-height: 1.6; overflow-x: hidden; }
      h1, h2 { font-family: "NB International", -apple-system, sans-serif; font-weight: 400; letter-spacing: -.01em; }
      a { color: inherit; }

      .nav { position: absolute; top: 0; left: 0; z-index: 10; padding: 22px clamp(24px, 4vw, 64px); }
      .back { color: rgba(255, 255, 255, .8); text-decoration: none; font-size: 15px; }
      .back:hover { color: #fff; }

      /* Hero, inside the pinned scene: huge title lines rise in, the prototype peeks from below */
      .hero-in { position: absolute; left: clamp(24px, 4vw, 64px); right: clamp(24px, 4vw, 64px); top: 13vh; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); gap: 0 4vw; align-items: end; }
      .eyebrow { grid-column: 1 / -1; color: #ffb27a; font-size: 15px; letter-spacing: .04em; margin-bottom: 14px; }
      .hero-title { grid-column: 1; font-size: clamp(48px, 7.4vw, 136px); line-height: .95; letter-spacing: -.03em; }
      .hero-title span { display: inline-block; animation: up .9s cubic-bezier(.2, .7, .2, 1) both; }
      .hero-title span + span { animation-delay: .12s; }
      @keyframes up { from { opacity: 0; translate: 0 60px; } }
      .lede { grid-column: 2; grid-row: 2; font-size: clamp(17px, 1.3vw, 21px); line-height: 1.5; color: rgba(255, 255, 255, .88); max-width: 36ch; animation: up .9s .25s cubic-bezier(.2, .7, .2, 1) both; }
      .actions { grid-column: 1; display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; animation: up .9s .35s cubic-bezier(.2, .7, .2, 1) both; }
      .facts { grid-column: 2; margin-top: 30px; align-self: center; color: rgba(255, 255, 255, .72); font-size: 15px; }
      .play { display: inline-flex; align-items: center; gap: 10px; height: 48px; padding: 0 22px; border-radius: 999px; font: inherit; font-size: 16px; font-weight: 500; text-decoration: none; cursor: pointer; transition: translate .2s ease, scale .2s ease, background .2s ease, border-color .2s ease; }
      .play { border: 0; background: #fff; color: #000; }
      .play:hover { translate: 0 -2px; scale: 1.03; }
      .play:hover svg { rotate: -8deg; transition: rotate .2s ease; }
      .play:focus-visible, summary:focus-visible { outline: 2px solid #ffb27a; outline-offset: 3px; }

      /* The details: a light card that peels up over the scene */
      .rest { position: relative; z-index: 2; margin-top: -14vh; transform-origin: 50% 0; padding-bottom: 140px; border-radius: 36px 36px 0 0; background: #f4f1ec; color: #17212b; box-shadow: 0 -10px 40px rgba(0, 0, 0, .18); }
      .rest .back { color: rgba(23, 33, 43, .75); }
      .rest .back:hover { color: #17212b; }
      .block { max-width: 1200px; margin: 0 auto; padding: 96px clamp(24px, 4vw, 64px) 0; }
      .kicker { color: #9a4609; font-size: 14px; letter-spacing: .06em; text-transform: uppercase; margin-bottom: 10px; }
      .block h2 { font-size: clamp(34px, 4vw, 64px); line-height: 1.05; letter-spacing: -.02em; margin-bottom: 18px; }
      .block > p { max-width: 62ch; color: rgba(23, 33, 43, .8); margin-bottom: 14px; }
      .sub { color: rgba(23, 33, 43, .75); margin-bottom: 28px; }
      .shipped { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
      .shipped li { display: flex; flex-direction: column; gap: 10px; padding: 22px; border-radius: 18px; background: #fff; font-size: 16px; line-height: 1.45; transition: translate .25s ease, box-shadow .25s ease; }
      .shipped li:hover { translate: 0 -3px; box-shadow: 0 8px 24px rgba(23, 33, 43, .08); }
      .shipped span { color: #9a4609; font-size: 13px; letter-spacing: .06em; text-transform: uppercase; }

      details { border-top: 1px solid rgba(23, 33, 43, .14); border-bottom: 1px solid rgba(23, 33, 43, .14); }
      summary { display: flex; align-items: baseline; gap: 16px; padding: 28px 0; cursor: pointer; list-style: none; }
      summary::-webkit-details-marker { display: none; }
      summary span { font-family: "NB International", sans-serif; font-size: clamp(28px, 3vw, 44px); letter-spacing: -.01em; }
      summary small { color: rgba(23, 33, 43, .7); font-size: 16px; }
      summary::after { content: "+"; margin-left: auto; font-size: 34px; line-height: 1; color: rgba(23, 33, 43, .6); transition: rotate .25s ease; }
      details[open] summary::after { rotate: 45deg; }
      .process { padding-bottom: 48px; }
      .process h3 { margin: 44px 0 14px; font-size: 20px; font-weight: 500; }
      .process > p { color: rgba(23, 33, 43, .8); max-width: 62ch; }
      .process figure img { width: 100%; border-radius: 14px; display: block; }
      .solo { margin-top: 14px; }
      .process figcaption { margin-top: 8px; color: rgba(23, 33, 43, .7); font-size: 14px; }
      .principles { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 18px; counter-reset: p; }
      .principles li { display: flex; flex-direction: column; gap: 6px; padding: 18px 20px; border-radius: 16px; background: #fff; counter-increment: p; }
      .principles li::before { content: "0" counter(p); color: #9a4609; font-size: 13px; }
      .principles span { color: rgba(23, 33, 43, .78); font-size: 16px; }
      .duo, .videos { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
      .trio { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
      .videos iframe { width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: 14px; }
      /* images wipe in from the left as they arrive */
      .wipe img { clip-path: inset(0 100% 0 0 round 14px); transition: clip-path 1.1s cubic-bezier(.6, 0, .2, 1); }
      .wipe.in img { clip-path: inset(0 0 0 0 round 14px); }
      .foot { max-width: 1200px; margin: 0 auto; padding: 72px clamp(24px, 4vw, 64px) 0; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
      .end-play { display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 20px; border-radius: 999px; background: #17212b; color: #fff; font-size: 15px; font-weight: 500; text-decoration: none; transition: translate .2s ease; }
      .end-play:hover { translate: 0 -2px; }
      .end-play:focus-visible { outline: 2px solid #9a4609; outline-offset: 3px; }

      @media (prefers-reduced-motion: reduce) { .hero-title span, .lede, .actions { animation: none; } .wipe img { clip-path: none; transition: none; } }
      @media (max-width: 900px) {
        .nav { position: static; padding: 18px 16px; }
        .hero-in { position: static; display: block; padding: 24px 16px 48px; }
        .hero-title { font-size: 48px; margin-bottom: 18px; }
        .lede { margin-top: 0; }
        .facts { margin-top: 18px; }
        .rest { margin-top: 0; border-radius: 24px 24px 0 0; }
        .block { padding: 64px 16px 0; }
        .shipped, .principles, .trio, .duo, .videos { grid-template-columns: 1fr; }
        .foot { padding: 56px 16px 0; }
      }
    </style>
  </body>
</html>
